diff --git a/libs/video/cellGcmSys.c b/libs/video/cellGcmSys.c
index ac0a7a8..13593fd 100644
--- a/libs/video/cellGcmSys.c
+++ b/libs/video/cellGcmSys.c
@@ -1726,9 +1726,30 @@ static void gcm_rsx_process_fifo_unlocked(void)
                    * else, it has switched to its other segment and left this
                    * park standing -- it only patches a park when it reuses that
                    * block. Waiting for a patch that will not come freezes the
-                   * FIFO for the rest of the run, so follow the write head. */
-                  if (put != s_fifo_getoff) { gcm_fifo_dump_around(s_fifo_getoff);
-                                              gcm_fifo_resync_why("jump-park", &s_fifo_getoff, put); }
+                   * FIFO for the rest of the run, so follow the write head.
+                   *
+                   * GCM_PARK_GRACE_MS=<ms>: but some titles park MID-FRAME and
+                   * patch the jump later, after put has already moved on.
+                   * Killzone 2 builds each frame in a ring block, parks at
+                   * +0x2DC while the rest is assembled, and patches the park to
+                   * jump into the remainder; the frame's end-of-frame label is
+                   * after the park. Resyncing at once skipped it, the label
+                   * froze, and the title's VRAM ring waited forever. The real
+                   * RSX spins on the park until it is patched; give the patch
+                   * this long before falling back to put (default 0: the old
+                   * behaviour). */
+                  static int grace = -1;
+                  if (grace < 0) { const char* e = getenv("GCM_PARK_GRACE_MS"); grace = e ? atoi(e) : 0; }
+                  if (put != s_fifo_getoff) {
+                      static u32 park_off = 0xFFFFFFFFu; static u64 park_since = 0;
+                      u64 now = ps3_ms_now();
+                      if (park_off != s_fifo_getoff) { park_off = s_fifo_getoff; park_since = now; }
+                      if (grace == 0 || now - park_since >= (u64)grace) {
+                          gcm_fifo_dump_around(s_fifo_getoff);
+                          gcm_fifo_resync_why("jump-park", &s_fifo_getoff, put);
+                          park_off = 0xFFFFFFFFu;
+                      }
+                  }
                   break;
               }
               s_fifo_getoff = tgt; }
