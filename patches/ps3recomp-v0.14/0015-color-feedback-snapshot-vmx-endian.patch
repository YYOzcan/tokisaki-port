+/* A colour target sampled by a draw that also writes it (a post-process that
+ * reads the frame it is finishing, e.g. a fullscreen distortion over the
+ * display buffer): a copy of the target as it stands, taken before the draw.
+ * Each target keeps ONE copy (its handle in `surface`), refilled on every
+ * request and released with the target. */
+static u32 vk_eng_color_snapshot(void* user, u32 surface, u32 remap, u32 rsx_format)
+{
+    vk_eng_obj* c = vk_eng_get(surface, VK_ENG_COLOR);
+    if (!c) return 0;
+    u32 snap = c->surface;
+    vk_eng_obj* t = vk_eng_get(snap, VK_ENG_TEXTURE);
+    if (!t || t->w != c->w || t->h != c->h || t->fmt != c->fmt ||
+        t->remap != remap || t->rsx_fmt != rsx_format) {
+        if (t) vk_eng_release(user, snap);
+        c = vk_eng_get(surface, VK_ENG_COLOR);
+        c->surface = 0;
+        snap = vk_eng_alloc();
+        if (!snap) return 0;
+        t = &s_eobj[snap];
+        if (vk_create_image(&t->im, c->fmt, c->w, c->h,
+                            VK_IMAGE_USAGE_SAMPLED_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT,
+                            VK_IMAGE_ASPECT_COLOR_BIT)) {
+            vk_destroy_image(&t->im); memset(t, 0, sizeof *t); return 0;
+        }
+        /* the sampled view carries the unit's crossbar, like surface_view */
+        pvkDestroyImageView(s_vk.device, t->im.view, NULL);
+        t->im.view = VK_NULL_HANDLE;
+        if (vk_eng_make_view(t->im.img, c->fmt, 1, vk_remap(remap, rsx_format), 0, &t->im.view)) {
+            vk_destroy_image(&t->im); memset(t, 0, sizeof *t); return 0;
+        }
+        t->kind = VK_ENG_TEXTURE; t->fmt = c->fmt; t->bpp = c->bpp; t->w = c->w; t->h = c->h;
+        t->remap = remap; t->rsx_fmt = rsx_format;
+        c = vk_eng_get(surface, VK_ENG_COLOR);
+        c->surface = snap;
+        if (vk_begin()) return 0;
+        vk_barrier_image(t->im.img, VK_IMAGE_ASPECT_COLOR_BIT, VK_IMAGE_LAYOUT_UNDEFINED);
+        if (vk_submit_and_wait()) return 0;
+    }
+    if (vk_begin()) return 0;
+    vk_barrier_image(c->im.img, VK_IMAGE_ASPECT_COLOR_BIT, VK_IMAGE_LAYOUT_GENERAL);
+    vk_barrier_image(t->im.img, VK_IMAGE_ASPECT_COLOR_BIT, VK_IMAGE_LAYOUT_GENERAL);
+    VkImageBlit blit = {
+        .srcSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 },
+        .srcOffsets = { { 0, 0, 0 }, { (int32_t)c->w, (int32_t)c->h, 1 } },
+        .dstSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 },
+        .dstOffsets = { { 0, 0, 0 }, { (int32_t)c->w, (int32_t)c->h, 1 } },
+    };
+    pvkCmdBlitImage(s_vk.cmd, c->im.img, VK_IMAGE_LAYOUT_GENERAL,
+                    t->im.img, VK_IMAGE_LAYOUT_GENERAL, 1, &blit, VK_FILTER_NEAREST);
+    return vk_submit_and_wait() ? 0 : snap;
+}
