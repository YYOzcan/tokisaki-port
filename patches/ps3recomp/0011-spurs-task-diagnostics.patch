diff --git a/runtime/spu/spu_workload.c b/runtime/spu/spu_workload.c
index 6a19d5b..ade371c 100644
--- a/runtime/spu/spu_workload.c
+++ b/runtime/spu/spu_workload.c
@@ -9,6 +9,9 @@
 #include "spu_lifted_job.h"   /* spu_run_lifted_job */
 #include "../ps3_log.h"      /* ps3_log_verbose */
 #include <stdio.h>
+#ifndef _WIN32
+#include <unistd.h>
+#endif
 #include <stdlib.h>
 #include <string.h>
 #ifdef _WIN32
@@ -606,6 +609,17 @@ static void spu_async_run(spu_async_job* j)
                 if (d && *d) {
 #ifdef _WIN32
                     Sleep((unsigned)(atoi(d) * 1000));
+#endif
+                }
+                /* SPURS_TASK_DELAY_MS=<ms>: start a task this long after its
+                 * CreateTask, the way a real kernel picks it up on a later
+                 * scheduling pass rather than inside the PPU call. */
+                const char* dm = getenv("SPURS_TASK_DELAY_MS");
+                if (dm && *dm) {
+#ifdef _WIN32
+                    Sleep((unsigned)atoi(dm));
+#else
+                    usleep((useconds_t)atoi(dm) * 1000u);
 #endif
                 }
