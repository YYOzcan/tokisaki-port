diff --git a/runtime/spu/spu_context.h b/runtime/spu/spu_context.h
index d80e438d..c3a80c12 100644
--- a/runtime/spu/spu_context.h
+++ b/runtime/spu/spu_context.h
@@ -480,6 +480,9 @@ static inline void spu_ls_write32(spu_context* ctx, uint32_t lsa, uint32_t val)
 #define SPU_BSWAP32(x) __builtin_bswap32(x)
 #define SPU_LS_FAST 1
 #endif
+#if defined(__SSSE3__)
+#include <tmmintrin.h>
+#endif
 
 /* Debug probes of spu_ls_read128, out of line: inlined they kept every LS
  * load a real call (~10% of GH3's FMOD mixer task). g_spu_ls_probe is -1
@@ -642,7 +645,14 @@ static inline void spu_ls_write128(spu_context* ctx, uint32_t lsa, u128 val)
     if (lsa == 0x1320 && ctx->image_id == 2 && ctx->policy_mode)
