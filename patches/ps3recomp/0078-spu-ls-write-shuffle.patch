 #endif
-#if SPU_LS_FAST
+#if SPU_LS_FAST && defined(__SSSE3__)
+    /* one shuffle and one store: the four byte-swapped words below compiled
+     * to a reload of the register as two 64-bit halves and four movbe */
+    __m128i x;
+    memcpy(&x, &val, 16);
+    _mm_storeu_si128((__m128i*)p, _mm_shuffle_epi8(x, _mm_setr_epi8(3, 2, 1, 0, 7, 6, 5, 4,
+                                                                   11, 10, 9, 8, 15, 14, 13, 12)));
+#elif SPU_LS_FAST
     uint32_t w0 = SPU_BSWAP32(val._u32[0]), w1 = SPU_BSWAP32(val._u32[1]);
     uint32_t w2 = SPU_BSWAP32(val._u32[2]), w3 = SPU_BSWAP32(val._u32[3]);
     memcpy(p,      &w0, 4); memcpy(p + 4,  &w1, 4);
