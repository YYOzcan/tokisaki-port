     u32          tex_mask;
@@ -4137,6 +4139,21 @@ static void vk_eng_bind_vs_constants(void* user, const void* data, u32 bytes)
     memcpy(s_e2.vs_data + bytes - tail, d + bytes - tail, tail);
     s_e2.vs_bytes = bytes;
     s_e2.vs_pre = pre;
+    s_e2.vs_ref = NULL;
+    s_e2.vs_gen = 0;
+}
+static void vk_eng_bind_vs_constants_ref(void* user, const void* consts, u32 prefix_bytes,
+                                         const void* tail, u32 tail_bytes, u32 total_bytes)
+{
+    (void)user;
+    if (!s_g.on || !consts || tail_bytes != 32u || total_bytes > (u32)sizeof s_e2.vs_data ||
+        prefix_bytes + tail_bytes > total_bytes) {
+        s_e2.vs_bytes = 0; s_e2.vs_ref = NULL; return;
+    }
+    s_e2.vs_ref = (const u8*)consts;
+    memcpy(s_e2.vs_tail, tail, 32);
+    s_e2.vs_bytes = total_bytes;
+    s_e2.vs_pre = prefix_bytes;
     s_e2.vs_gen = 0;
 }
