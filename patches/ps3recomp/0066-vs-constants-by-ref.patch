diff --git a/libs/video/rsx_vulkan_backend.c b/libs/video/rsx_vulkan_backend.c
index 2dd5862f..9c0473ec 100644
--- a/libs/video/rsx_vulkan_backend.c
+++ b/libs/video/rsx_vulkan_backend.c
@@ -3735,6 +3735,8 @@ static struct {
     u32          pipeline;
     u32          vs_bytes, ps_bytes;
     u32          vs_pre;      /* leading bytes of vs_data that are current (+ the 32-byte tail) */
+    const u8*    vs_ref;      /* bind_vs_constants_ref: the prefix is read from here instead */
+    u8           vs_tail[32];
     u32          tex[RSX_BE_MAX_TEXTURES];
