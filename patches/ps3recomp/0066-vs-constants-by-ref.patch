     const void* (*readback_result)(void* user, u64 ticket, int wait);
     void (*readback_release)(void* user, u64 ticket);
+    /* Optional, in place of bind_vs_constants: the constant block by
+     * reference. The first `prefix_bytes` of `consts` are the constants the
+     * program reads and stay valid and unchanged until the next bind (the
+     * engine passes its register file and binds again whenever a constant
+     * changes); the `tail_bytes` at `tail` (the viewport transform) are copied
+     * now and go at the end of a `total_bytes` block. The backend copies
+     * straight into what the shader reads -- the block was copied three times
+     * a draw on its way there. */
+    void (*bind_vs_constants_ref)(void* user, const void* consts, u32 prefix_bytes,
+                                  const void* tail, u32 tail_bytes, u32 total_bytes);
 } rsx_draw_backend;
 
