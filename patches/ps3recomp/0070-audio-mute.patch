diff --git a/libs/audio/cellAudio.c b/libs/audio/cellAudio.c
index c8cef736..5ccb0138 100644
--- a/libs/audio/cellAudio.c
+++ b/libs/audio/cellAudio.c
@@ -409,6 +409,17 @@ static inline float ld_be_f32(const float* p)
 }
 
 /* Mix one block from all active ports into s_mix_buffer (stereo float) */
+/* PS3_AUDIO_MUTE=1: the title mixes and paces its sound as always, and the
+ * device is given silence -- unlike PS3_NO_AUDIO, nothing the title sees or
+ * waits on changes (for runs on a machine someone is listening to). */
+static void audio_host_submit(float* stereo_samples, u32 num_samples)
+{
+    static int mute = -1;
+    if (mute < 0) { const char* e = getenv("PS3_AUDIO_MUTE"); mute = e && e[0] == '1'; }
+    if (mute) memset(stereo_samples, 0, (size_t)num_samples * 2u * sizeof(float));
+    audio_backend_submit(stereo_samples, num_samples);
+}
+
 static void audio_mix_one_block(void)
 {
     memset(s_mix_buffer, 0, sizeof(s_mix_buffer));
@@ -578,7 +589,7 @@ static unsigned __stdcall audio_mix_thread_func(void* arg)
         { static FILE* _wf = (FILE*)-1;
           if (_wf == (FILE*)-1) { const char* e = getenv("AUDIO_WAV"); _wf = e ? fopen(e, "wb") : NULL; }
           if (_wf) fwrite(s_mix_buffer, sizeof(float), CELL_AUDIO_BLOCK_SAMPLES * 2, _wf); }
-        audio_backend_submit(s_mix_buffer, CELL_AUDIO_BLOCK_SAMPLES);
+        audio_host_submit(s_mix_buffer, CELL_AUDIO_BLOCK_SAMPLES);
         /* AUDIO_RATE=1: blocks mixed vs real time, and frames dropped. */
         { static int on = -1; if (on < 0) on = getenv("AUDIO_RATE") ? 1 : 0;
           if (on) { static ULONGLONG t0; static unsigned n, z; static unsigned long long d0;
@@ -617,7 +628,7 @@ static void* audio_mix_thread_func(void* arg)
         const int room = audio_backend_room();
         if (room == 0) { usleep(1000); continue; }
         audio_mix_one_block();
-        audio_backend_submit(s_mix_buffer, CELL_AUDIO_BLOCK_SAMPLES);
+        audio_host_submit(s_mix_buffer, CELL_AUDIO_BLOCK_SAMPLES);
         audio_notify_event_queues();
         if (room < 0) { usleep(1000000u * CELL_AUDIO_BLOCK_SAMPLES / CELL_AUDIO_SAMPLE_RATE); continue; }
 
