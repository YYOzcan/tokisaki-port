+/* The periodic full hash of a texture larger than ENG_TEXHASH_SMALL runs on
+ * a helper thread: it is a safety net for writes the sparse samples miss,
+ * already up to ENG_TEXHASH_FULL_EVERY frames late, and it was most of what
+ * the FIFO thread hashed (~12 MB a frame in Killzone 2's levels). A
+ * difference marks the entry; its next use hashes and uploads it here, as a
+ * sparse difference does. The sparse check, small textures and writes the
+ * engine saw stay on this thread. RSX_TEXHASH_ASYNC=0: all of it here. */
+#if !defined(_WIN32)
+#include <pthread.h>
+typedef struct { u32 index, gen, location, offset, span; u64 expect; } eng_texjob;
+#define ENG_TEXJOBS 512u
+static struct {
+    pthread_mutex_t m; pthread_cond_t c;
+    int state;                  /* -1 off, 0 not started, 1 running */
+    eng_texjob q[ENG_TEXJOBS];
+    u32 head, tail;             /* q[head..tail) */
+} s_th = { PTHREAD_MUTEX_INITIALIZER, PTHREAD_COND_INITIALIZER, 0, {{0}}, 0, 0 };
+static u64 eng_texture_content_hash(u32 location, u32 offset, u32 span, int* readable);
+static void* eng_texhash_main(void* arg)
+{
+    (void)arg;
+    for (;;) {
+        pthread_mutex_lock(&s_th.m);
+        while (s_th.head == s_th.tail) pthread_cond_wait(&s_th.c, &s_th.m);
+        const eng_texjob j = s_th.q[s_th.head % ENG_TEXJOBS];
+        s_th.head++;
+        pthread_mutex_unlock(&s_th.m);
+        int readable = 0;
+        const u64 h = eng_texture_content_hash(j.location, j.offset, j.span, &readable);
+        eng_texture* e = &g.textures[j.index];
+        if (readable && h != j.expect && __atomic_load_n(&e->gen, __ATOMIC_RELAXED) == j.gen)
+            __atomic_store_n(&e->async_changed, j.gen | 0x80000000u, __ATOMIC_RELEASE);
+    }
+    return NULL;
+}
+/* 1: queued (the full hash happens there); 0: do it here */
+static int eng_texhash_async(u32 index, const eng_texture* e, u32 span)
+{
+    if (s_th.state < 0) return 0;
+    if (s_th.state == 0) {
+        const char* v = getenv("RSX_TEXHASH_ASYNC");
+        pthread_t t;
+        if ((v && v[0] == '0') || pthread_create(&t, NULL, eng_texhash_main, NULL) != 0) {
+            s_th.state = -1;
+            return 0;
+        }
+        pthread_detach(t);
+        s_th.state = 1;
+    }
+    int queued = 0;
+    pthread_mutex_lock(&s_th.m);
+    if (s_th.tail - s_th.head < ENG_TEXJOBS) {
+        s_th.q[s_th.tail % ENG_TEXJOBS] = (eng_texjob){ index, e->gen, e->location, e->offset,
+                                                        span, e->content_hash };
+        s_th.tail++;
+        queued = 1;
+        pthread_cond_signal(&s_th.c);
+    }
+    pthread_mutex_unlock(&s_th.m);
+    return queued;
 }
