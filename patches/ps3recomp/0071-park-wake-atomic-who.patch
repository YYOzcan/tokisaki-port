+    t_in += in_ns; n_calls++; n_timeout += !patched;
+    static struct { int img; unsigned long long ns; unsigned n; } tab[64];
+    struct timespec ts; clock_gettime(CLOCK_MONOTONIC, &ts);
+    const unsigned long long now = (unsigned long long)ts.tv_sec * 1000000000ull + (unsigned long long)ts.tv_nsec;
+    if (!t_win) t_win = now;
+    if (io != cur_io) { cur_io = io; t_start = now; }
+    if (patched) {
+        const int img = s_park_waker;
+        /* KZ2_PARK_LOG=<file>: one line per park, "start_ns end_ns image" (CLOCK_MONOTONIC) */
+        static FILE* plog; static int plog_init;
+        if (!plog_init) { plog_init = 1; const char* f = getenv("KZ2_PARK_LOG"); if (f && *f) plog = fopen(f, "w"); }
+        if (plog) fprintf(plog, "%llu %llu %d\n", t_start, now, img);
+        int k = 0;
+        while (k < 63 && tab[k].n && tab[k].img != img) k++;
+        tab[k].img = img; tab[k].ns += now - t_start; tab[k].n++;
+        cur_io = 0xFFFFFFFFu;
+    }
+    if (now - t_win >= 5000000000ull) {
+        unsigned long long tot = 0;
+        for (int k = 0; k < 64 && tab[k].n; k++) tot += tab[k].ns;
+        fprintf(stderr, "[park-who] %.1f ms in park waits (%llu, %llu timed out), %.1f ms parked to a seen patch in %.1f s;"
+                        " ended by image:", t_in / 1e6, n_calls, n_timeout, tot / 1e6, (now - t_win) / 1e9);
+        t_in = n_calls = n_timeout = 0;
+        for (int r = 0; r < 8; r++) {
+            int b = -1;
+            for (int k = 0; k < 64 && tab[k].n; k++) if (tab[k].ns && (b < 0 || tab[k].ns > tab[b].ns)) b = k;
+            if (b < 0) break;
+            fprintf(stderr, " %d: %.1f ms (%u, %.0f us each)", tab[b].img, tab[b].ns / 1e6, tab[b].n,
+                    tab[b].ns / 1e3 / tab[b].n);
+            tab[b].ns = 0;
+        }
