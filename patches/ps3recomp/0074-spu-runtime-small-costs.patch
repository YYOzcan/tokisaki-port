+/* Is any 128-byte line of [a0, a1] reserved (spu_coherency.c's bitmap, the
+ * test spu_coh_is_reserved makes for one line)? A PUT asked it line by line,
+ * an out-of-line call each, twice: up to 129 calls a 16 KiB PUT. */
+static inline int spu_coh_span_reserved(uint32_t a0, uint32_t a1)
+{
+    extern unsigned char g_spu_coh_bitmap[];
+    extern int g_spu_coh_armed;
+    if (!g_spu_coh_armed) return 0;
+    const uint32_t l0 = a0 >> 7, l1 = a1 >> 7, b0 = l0 >> 3, b1 = l1 >> 3;
+    const unsigned lo_mask = 0xFFu << (l0 & 7), hi_mask = 0xFFu >> (7 - (l1 & 7));
+    if (b0 == b1) return (g_spu_coh_bitmap[b0] & lo_mask & hi_mask) != 0;
+    if (g_spu_coh_bitmap[b0] & lo_mask) return 1;
+    for (uint32_t b = b0 + 1; b < b1; b++)
+        if (g_spu_coh_bitmap[b]) return 1;
+    return (g_spu_coh_bitmap[b1] & hi_mask) != 0;
+}
