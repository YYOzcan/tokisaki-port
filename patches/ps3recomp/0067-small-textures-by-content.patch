--- a/libs/video/rsx_draw_engine.c
+++ b/libs/video/rsx_draw_engine.c
@@ -1156,6 +1156,66 @@ static int eng_texture_reupload(u32 handle, u32 location, u32 offset, u32 fmt, u
  * cache full evicts the least recently used entry rather than returning
  * nothing: returning white "made the recovered orphanage render as flat
  * green/black geometry" (rsx_live_draw.c:2326-2334). */
+/* Small textures by content. Killzone 2 writes ~220 8x8 ARGB8 textures
+ * (256 bytes each) to new places in main memory every frame, few of them
+ * different (165 contents among 669 in three frames): each was a new entry
+ * of the address-keyed cache -- an image created, uploaded, and another
+ * entry evicted for it, real textures included. A texture of at most
+ * ENG_SMALLTEX bytes is found by its bytes instead (a hash finds the
+ * candidate, a copy of the bytes decides) and never enters that cache.
+ * RSX_SMALLTEX_CACHE=0: every texture by address, as before. */
+#define ENG_SMALLTEX       4096u
+#define ENG_SMALLTEX_SLOTS 1024u     /* a power of two */
+#define ENG_SMALLTEX_PROBE 8u
+typedef struct {
+    u32 handle, fmt, w, h, levels, pitch, remap, cube, span;
+    u32 last_frame;             /* never evicted in the frame it was used: a draw may hold it */
+    u64 hash, last_use;
+    u8* bytes;
+} eng_smalltex;
+static eng_smalltex s_stex[ENG_SMALLTEX_SLOTS];
+static u64 s_stex_serial;
+
+static u32 eng_smalltex_get(u32 location, u32 offset, u32 fmt, u32 w, u32 h,
+                            u32 levels, u32 pitch, int cube, u32 remap, u32 span, int* done)
+{
+    *done = 0;
+    const u8* src = eng_guest_ptr(NULL, location, offset, span);
+    if (!src) return 0;                 /* the address path decides, as before */
+    const u32 k[7] = { fmt, w, h, levels, pitch, remap, (u32)(cube != 0) };
+    const u64 hash = vc_hash(k, sizeof k, vc_hash(src, span, 0x534D4C54ull));
+    const u32 home = (u32)(hash ^ (hash >> 29)) & (ENG_SMALLTEX_SLOTS - 1u);
+    eng_smalltex* victim = NULL;
+    for (u32 i = 0; i < ENG_SMALLTEX_PROBE; i++) {
+        eng_smalltex* t = &s_stex[(home + i) & (ENG_SMALLTEX_SLOTS - 1u)];
+        if (t->handle && t->hash == hash && t->span == span && t->fmt == fmt && t->w == w &&
+            t->h == h && t->levels == levels && t->pitch == pitch && t->remap == remap &&
+            t->cube == (u32)(cube != 0) && !memcmp(t->bytes, src, span)) {
+            t->last_use = ++s_stex_serial;
+            t->last_frame = g.frames;
+            *done = 1;
+            return t->handle;
+        }
+        if (t->handle && t->last_frame == g.frames) continue;
+        if (!victim || !t->handle || (victim->handle && t->last_use < victim->last_use)) victim = t;
+    }
+    if (!victim) return 0;              /* all in use this frame: by address */
+    u8* copy = victim->bytes && victim->span >= span ? victim->bytes : (u8*)realloc(victim->bytes, span);
+    if (!copy) return 0;
+    victim->bytes = copy;
+    const u32 handle = eng_texture_upload(location, offset, fmt, w, h, levels, pitch, cube, remap);
+    if (!handle) return 0;
+    if (victim->handle) g.be->texture_release(g.be->user, victim->handle);
+    memcpy(victim->bytes, src, span);
+    victim->handle = handle; victim->hash = hash; victim->span = span;
+    victim->fmt = fmt; victim->w = w; victim->h = h; victim->levels = levels;
+    victim->pitch = pitch; victim->remap = remap; victim->cube = (u32)(cube != 0);
+    victim->last_use = ++s_stex_serial;
+    victim->last_frame = g.frames;
+    *done = 1;
+    return handle;
+}
