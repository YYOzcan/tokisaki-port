@@ -1164,6 +1224,14 @@ static u32 eng_texture_slot(u32 location, u32 offset, u32 fmt, u32 w, u32 h,
     if (!span) return 0;
     if (s_pend_n) eng_pend_guard(location, offset, span);
 
+    static int small_on = -1;
+    if (small_on < 0) { const char* e = getenv("RSX_SMALLTEX_CACHE"); small_on = !(e && e[0] == '0'); }
+    if (small_on && span <= ENG_SMALLTEX) {
+        int done = 0;
+        const u32 handle = eng_smalltex_get(location, offset, fmt, w, h, levels, pitch, cube, remap, span, &done);
+        if (done) return handle;
+    }
