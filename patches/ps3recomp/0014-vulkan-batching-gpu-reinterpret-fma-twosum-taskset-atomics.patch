+    if (!g.be->reinterpret || !src || !((mask >> (kind - 1u)) & 1)) return 0;
+    const u32 remap = t->remap & 0xFFFFu;
+    eng_xform* e = NULL;
+    for (u32 i = 0; i < ENG_XFORMS; i++) {
+        eng_xform* x = &s_xform[i];
+        if (x->handle && x->location == t->location && x->offset == t->offset && x->kind == kind &&
