+/* Set or clear one task's bit in a taskset bitset (ready/pending/enabled at
+ * +0x10/+0x20/+0x30) from a host thread, under the lock-line lock the SPU task
+ * library's GETLLAR/PUTLLC and the host's task exit use (upstream #388,
+ * undecuple): a vm_read32 outside it and a vm_write32 inside it undid a change
+ * committed between the two. Raw guest bytes: vm_write32 takes the lock itself
+ * when the line is reserved, and it does not nest. */
+void spurs_taskset_bitset_update(uint32_t bitset_ea, uint32_t taskId, int set)
+{
+    extern void spu_lockline_lock(void); extern void spu_lockline_unlock(void);
+    extern void spu_coh_notify_write(uint32_t);
+    extern uint8_t* vm_base;
+    uint8_t* p = vm_base + bitset_ea + taskId / 8;
+    const uint8_t m = (uint8_t)(0x80u >> (taskId % 8));
+    spu_lockline_lock();
+    if (set) *p |= m; else *p &= (uint8_t)~m;
+    spu_coh_notify_write(bitset_ea);
+    spu_lockline_unlock();
+}
+
+/* Take the lowest free task id of a taskset: the first clear bit of the enabled
+ * bitset, set in the same step under the lock-line lock, so a task exit
+ * clearing its bit at the same time is never undone and two callers never get
+ * the same id (upstream #388). Returns `max_tasks` when every id is taken. */
+uint32_t spurs_taskset_take_slot(uint32_t taskset_ea, uint32_t max_tasks)
+{
+    extern void spu_lockline_lock(void); extern void spu_lockline_unlock(void);
+    extern void spu_coh_notify_write(uint32_t);
+    extern uint8_t* vm_base;
+    uint8_t* en = vm_base + taskset_ea + CSTS_ENABLED;
+    uint32_t slot = max_tasks;
+    spu_lockline_lock();
+    for (uint32_t t = 0; t < max_tasks; t++) {
+        const uint8_t m = (uint8_t)(0x80u >> (t % 8));
+        if (!(en[t / 8] & m)) { en[t / 8] |= m; slot = t; break; }
+    }
+    if (slot < max_tasks) spu_coh_notify_write(taskset_ea + CSTS_ENABLED);
+    spu_lockline_unlock();
+    return slot;
+}
+
