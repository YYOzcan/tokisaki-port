+/* A texture laid out like the target it names: one linear level, texel
+ * (x, y) at the target's own pitch, inside the target. */
+static int eng_xform_fits(const rsx_dsp_texture* t, u32 pitch, u32 bpp, u32 w, u32 h)
+{
+    const int pot = !(t->width & (t->width - 1u)) && !(t->height & (t->height - 1u));
+    if (t->cubemap || t->mipmaps > 1 || t->depth > 1 || t->dimension != 2) return 0;
+    if (pot && !(t->format & 0x20u)) return 0;          /* swizzled */
+    return t->pitch == pitch && t->width <= w && t->height <= h && t->width * bpp <= pitch;
