+/* Set or clear a task's bit in the guest `signalled` bitset from a host thread
+ * (upstream #340, Kurtisone). SPU tasks update this same line with
+ * GETLLAR/PUTLLC under the lock-line lock; a vm_read32 outside it followed by a
+ * vm_write32 inside it overwrote an SPU commit that landed between the two
+ * (Twisted Metal lost a barrier wake that way). The read-modify-write is done
+ * on the raw guest bytes under the lock (vm_write32 takes it itself and it
+ * does not nest), then every reservation on the line is dropped. */
+static void spu_signalled_update(uint32_t taskset_ea, uint32_t taskId, int set)
+{
+    extern void spu_lockline_lock(void); extern void spu_lockline_unlock(void);
+    extern void spu_coh_notify_write(uint32_t);
+    extern uint8_t* vm_base;
+    const uint32_t word = taskset_ea + CSTS_SIGNALLED + (taskId / 32u) * 4u;
+    const uint32_t mask = (1u << 31) >> (taskId % 32u);
+    uint8_t* p = vm_base + word;
+    spu_lockline_lock();
+    uint32_t v = ((uint32_t)p[0] << 24) | ((uint32_t)p[1] << 16) | ((uint32_t)p[2] << 8) | p[3];
+    v = set ? (v | mask) : (v & ~mask);
+    p[0] = (uint8_t)(v >> 24); p[1] = (uint8_t)(v >> 16); p[2] = (uint8_t)(v >> 8); p[3] = (uint8_t)v;
+    spu_coh_notify_write(word);
+    spu_lockline_unlock();
+}
