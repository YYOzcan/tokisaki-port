diff --git a/libs/video/shaders/rsx_vk_reinterpret.comp b/libs/video/shaders/rsx_vk_reinterpret.comp
new file mode 100644
index 0000000..6cd25f1
--- /dev/null
+++ b/libs/video/shaders/rsx_vk_reinterpret.comp
@@ -0,0 +1,52 @@
+#version 450
+/* A render target read as a texture in another format, built on the GPU the
+ * way rsx_texture_decode would decode the bytes the guest-memory round trip
+ * leaves behind (rsx_draw_engine.c, eng_zdepth_to_guest / guest_read).
+ * src: the target copied out tightly (depth as float32, colour as RGBA8).
+ * dst: the decoded texture's texels, copied into it unchanged.
+ *   mode 1: D24S8 depth read as A8R8G8B8   -> RGBA8 texels
+ *   mode 2: Z16 depth read as DEPTH16/X16  -> R16 texels, two per word
+ *   mode 3: RGBA8 colour read as Y16_X16_FLOAT -> RG16F texels
+ * rgba: TEX_RGBA=1, the guest stores R,G,B,A instead of A,R,G,B.
+ * Rebuild the header: glslangValidator -V --vn rsx_vk_reinterpret_spv
+ *   -o rsx_vk_reinterpret_spv.h rsx_vk_reinterpret.comp */
+layout(local_size_x = 64) in;
+layout(std430, binding = 0) readonly buffer Src { uint src[]; };
+layout(std430, binding = 1) writeonly buffer Dst { uint dst[]; };
+layout(push_constant) uniform PC { uint count; uint mode; uint rgba; } pc;
+
+/* the guest-memory copy's depth quantisation: NaN and negatives to 0 */
+float unit_depth(uint bits)
+{
+    float d = uintBitsToFloat(bits);
+    return d > 0.0 ? min(d, 1.0) : 0.0;
+}
+
+void main()
+{
+    uint i = gl_GlobalInvocationID.x;
+    if (pc.mode == 2u) {
+        uint t = i * 2u;
+        if (t >= pc.count) return;
+        uint v0 = uint(unit_depth(src[t]) * 65535.0 + 0.5);
+        uint v1 = (t + 1u < pc.count) ? uint(unit_depth(src[t + 1u]) * 65535.0 + 0.5) : 0u;
+        dst[i] = (v0 & 0xFFFFu) | ((v1 & 0xFFFFu) << 16);
+        return;
+    }
+    if (i >= pc.count) return;
+    uint x = src[i];
+    if (pc.mode == 1u) {
+        uint v = min(uint(unit_depth(x) * 16777215.0 + 0.5), 0xFFFFFFu);
+        /* guest bytes s0..s3 = depth >> 16, >> 8, low byte, stencil (0) */
+        uint s0 = (v >> 16) & 0xFFu, s1 = (v >> 8) & 0xFFu, s2 = v & 0xFFu, s3 = 0u;
+        dst[i] = pc.rgba != 0u ? (s0 | (s1 << 8) | (s2 << 16) | (s3 << 24))
+                               : (s1 | (s2 << 8) | (s3 << 16) | (s0 << 24));
+    } else {
+        uint r = x & 0xFFu, g = (x >> 8) & 0xFFu, b = (x >> 16) & 0xFFu, a = x >> 24;
+        uint s0, s1, s2, s3;
+        if (pc.rgba != 0u) { s0 = r; s1 = g; s2 = b; s3 = a; }
+        else               { s0 = a; s1 = r; s2 = g; s3 = b; }
+        /* two big-endian halves, byte-swapped into the host's order */
+        dst[i] = (s1 | (s0 << 8)) | ((s3 | (s2 << 8)) << 16);
+    }
+}
