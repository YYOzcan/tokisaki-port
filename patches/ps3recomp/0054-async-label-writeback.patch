+/* ---- main-target writebacks without a GPU wait (RSX_ASYNC_WB=1) ---------
+ * Every label release stored the main-memory targets first (section above),
+ * a GPU wait each: three a frame in Killzone 2's level, ~13 ms of the FIFO
+ * thread. Here the copies go to the GPU like any other operation and the
+ * label waits behind them in a queue, written in order once they have landed
+ * -- what the RSX does, which writes a label when its pipeline gets there.
+ * The FIFO meanwhile goes on recording. The queue is landed as far as it can
+ * at each release and each draw, all of it (waiting) when the FIFO stops,
+ * before a guest-memory texture or a coherence read over a queued target. */
+extern void vm_write32(uint32_t a, uint32_t v);
+enum { ENG_PEND_COLOR = 1, ENG_PEND_DEPTH, ENG_PEND_LABEL };
+typedef struct {
+    u8  kind;
+    u64 ticket;
+    u32 location, offset, pitch, w, h;
+    u32 bpp, elem;          /* colour: bytes per pixel, byte-swap unit (0: ARGB8) */
+    u32 zbpp;               /* depth: 2 (Z16) or 4 (Z24S8) */
+    u32 ea, val;            /* label */
+} eng_pend;
+#define ENG_PEND_N 64u
+static eng_pend s_pend[ENG_PEND_N];
+static u32 s_pend_head, s_pend_n;
+
+static int eng_async_wb(void)
+{
+    static int on = -1;
+    if (on < 0) { const char* e = getenv("RSX_ASYNC_WB"); on = e && e[0] == '1'; }
+    return on && g.be && g.be->readback_async && g.be->readback_result && g.be->readback_release;
+}
+
+static void eng_pend_store(const eng_pend* p, const u8* src)
+{
+    if (p->kind == ENG_PEND_COLOR) {
+        const int rgba = rsx_texture_argb_is_rgba();
+        for (u32 r = 0; r < p->h; r++) {
+            u8* dst = (u8*)eng_guest_ptr(NULL, p->location, p->offset + r * p->pitch, p->w * p->bpp);
+            if (!dst) break;
+            const u8* q = src + (size_t)r * p->w * p->bpp;
+            if (!p->elem) {
+                for (u32 c = 0; c < p->w; c++, q += 4, dst += 4) {
+                    if (rgba) { dst[0] = q[0]; dst[1] = q[1]; dst[2] = q[2]; dst[3] = q[3]; }
+                    else      { dst[0] = q[3]; dst[1] = q[0]; dst[2] = q[1]; dst[3] = q[2]; }
+                }
+            } else if (p->elem == 4) {
+                for (u32 b = 0; b < p->w * p->bpp; b += 4) {
+                    dst[b] = q[b + 3]; dst[b + 1] = q[b + 2]; dst[b + 2] = q[b + 1]; dst[b + 3] = q[b];
+                }
+            } else {
+                for (u32 b = 0; b < p->w * p->bpp; b += 2) { dst[b] = q[b + 1]; dst[b + 1] = q[b]; }
+            }
+        }
+    } else {
+        const float* rows = (const float*)src;
+        for (u32 r = 0; r < p->h; r++) {
+            u8* dst = (u8*)eng_guest_ptr(NULL, p->location, p->offset + r * p->pitch, p->w * p->zbpp);
+            if (!dst) break;
+            const float* q = rows + (size_t)r * p->w;
+            for (u32 c = 0; c < p->w; c++) {
+                float d = q[c];
+                if (!(d > 0.0f)) d = 0.0f;
+                if (d > 1.0f) d = 1.0f;
+                if (p->zbpp == 2u) {
+                    const u32 v = (u32)(d * 65535.0f + 0.5f);
+                    dst[0] = (u8)(v >> 8); dst[1] = (u8)v;
+                } else {
+                    const u32 v = (u32)((double)d * 16777215.0 + 0.5);
+                    dst[0] = (u8)(v >> 16); dst[1] = (u8)(v >> 8); dst[2] = (u8)v; dst[3] = 0;
+                }
+                dst += p->zbpp;
+            }
+        }
+    }
+    eng_textures_touch(p->location, p->offset, p->pitch * p->h);
+}
+
+void rsx_draw_engine_async_poll(int wait)
+{
+    while (s_pend_n) {
+        eng_pend* p = &s_pend[s_pend_head];
+        if (p->kind == ENG_PEND_LABEL) {
+            __atomic_thread_fence(__ATOMIC_RELEASE);     /* the stored targets before their label */
+            vm_write32(p->ea, p->val);
+        } else {
+            const void* rows = g.be->readback_result(g.be->user, p->ticket, wait);
+            if (!rows) return;
+            eng_pend_store(p, (const u8*)rows);
+            g.be->readback_release(g.be->user, p->ticket);
+        }
+        s_pend_head = (s_pend_head + 1u) % ENG_PEND_N;
+        s_pend_n--;
+    }
+}
+
+static eng_pend* eng_pend_push(void)
+{
+    if (s_pend_n == ENG_PEND_N) rsx_draw_engine_async_poll(1);
+    eng_pend* p = &s_pend[(s_pend_head + s_pend_n) % ENG_PEND_N];
+    memset(p, 0, sizeof *p);
+    s_pend_n++;
+    return p;
+}
+
+/* A queued copy overlaps [offset, offset + bytes) at `location`: land the
+ * queue before anything reads those guest bytes. */
+static void eng_pend_guard(u32 location, u32 offset, u32 bytes)
+{
+    for (u32 k = 0; k < s_pend_n; k++) {
+        const eng_pend* p = &s_pend[(s_pend_head + k) % ENG_PEND_N];
+        if (p->kind == ENG_PEND_LABEL || p->location != location) continue;
+        const u32 end = p->offset + p->pitch * p->h;
+        if (offset < end && offset + bytes > p->offset) { rsx_draw_engine_async_poll(1); return; }
+    }
+}
+
+/* Queue one dirty main target; 0 when the backend cannot (the caller stores
+ * it the waiting way). */
+static int eng_surface_writeback_async(u32 slot)
+{
+    eng_surface* s = &g.surfaces[slot];
+    u32 bpp = 4, elem = 0;
+    switch (s->fmt) {
+    case RSX_BE_FMT_R8G8B8A8:      bpp = 4;  elem = 0; break;
+    case RSX_BE_FMT_R32F:          bpp = 4;  elem = 4; break;
+    case RSX_BE_FMT_R16G16F:       bpp = 4;  elem = 2; break;
+    case RSX_BE_FMT_R16G16B16A16F: bpp = 8;  elem = 2; break;
+    case RSX_BE_FMT_R32G32B32A32F: bpp = 16; elem = 4; break;
+    default: return 0;
+    }
+    if (s->pitch < s->w * bpp) return 0;
+    const u64 t = g.be->readback_async(g.be->user, s->handle, 0, 0, 0, s->w, s->h);
+    if (!t) return 0;
+    eng_pend* p = eng_pend_push();
+    p->kind = ENG_PEND_COLOR; p->ticket = t;
+    p->location = s->location; p->offset = s->offset; p->pitch = s->pitch;
+    p->w = s->w; p->h = s->h; p->bpp = bpp; p->elem = elem;
+    s->guest_dirty = 0;
+    return 1;
+}
+
+static int eng_zdepth_writeback_async(u32 slot)
+{
+    eng_zdepth* z = &g.zdepths[slot];
+    if (!z->handle) return 0;
+    const u32 bpp = (z->zfmt == 1u) ? 2u : 4u;
+    const u32 w = z->used_w < z->w ? z->used_w : z->w;
+    const u32 h = z->used_h < z->h ? z->used_h : z->h;
+    if (!w || !h || z->pitch < w * bpp) return 0;
+    const u64 t = g.be->readback_async(g.be->user, z->handle, 1, 0, 0, w, h);
+    if (!t) return 0;
+    eng_pend* p = eng_pend_push();
+    p->kind = ENG_PEND_DEPTH; p->ticket = t;
+    p->location = z->location; p->offset = z->offset; p->pitch = z->pitch;
+    p->w = w; p->h = h; p->zbpp = bpp;
+    z->guest_dirty = 0;
+    return 1;
+}
+
+void rsx_draw_engine_label_release(u32 ea, u32 val)
+{
+    if (!g.ready || !eng_async_wb()) {
+        rsx_draw_engine_flush_main_targets();
+        vm_write32(ea, val);
+        return;
+    }
+    rsx_draw_engine_async_poll(0);
+    static int en = -1;
+    if (en < 0) { const char* e = getenv("RSX_MAIN_TARGET_WB"); en = e ? atoi(e) : 1; }
+    if (en) {
+        for (u32 i = 0; i < g.n_surfaces; i++) {
+            const eng_surface* s = &g.surfaces[i];
+            if (!s->handle || s->location != 1 || !s->guest_dirty) continue;
+            if (!eng_surface_writeback_async(i)) {     /* in order: land the queue, then wait */
+                rsx_draw_engine_async_poll(1);
+                eng_surface_writeback(i);
+            }
+        }
+    }
+    for (u32 i = 0; i < g.n_zdepths; i++) {
+        eng_zdepth* z = &g.zdepths[i];
+        if (!z->wb_pending) continue;
+        if (z->guest_dirty && !eng_zdepth_writeback_async(i)) {
+            rsx_draw_engine_async_poll(1);
+            eng_zdepth_to_guest(i);
+        }
+        z->wb_pending = 0;
+    }
+    if (!s_pend_n) { vm_write32(ea, val); return; }
+    eng_pend* p = eng_pend_push();
+    p->kind = ENG_PEND_LABEL; p->ea = ea; p->val = val;
+}
