+/* Inline stores, the same idea as the loads above: the out-of-line vm_write*
+ * run a watch hook, the null/out-of-range checks and the SPU reservation test
+ * as three calls per guest store. The fast path stores directly whenever none
+ * of them can apply: no store watch armed (g_vm_store_slow, PPU_WVAL /
+ * PPU_WWATCH), no sync watch, no null sweep, and no SPU reservation on the
+ * line (it must then lock, store and break the reservation). */
+#ifdef __cplusplus
+extern "C" {
+#endif
+extern int      g_vm_store_slow;
+extern uint32_t g_barrier_sync_watch, g_null_sweep_hi;
+extern int      g_spu_coh_armed;
+extern unsigned char g_spu_coh_bitmap[];
+#ifdef __cplusplus
+}
+#endif
+static inline int vm_st_ok(uint32_t ea, uint32_t n)
+{
+    if (!vm_inl_ok(ea, n) || (g_vm_store_slow | g_barrier_sync_watch | g_null_sweep_hi)) return 0;
+    if (__builtin_expect(g_spu_coh_armed, 1)) {
+        const uint32_t l0 = ea >> 7, l1 = (ea + n - 1) >> 7;
+        if (((g_spu_coh_bitmap[l0 >> 3] >> (l0 & 7)) | (g_spu_coh_bitmap[l1 >> 3] >> (l1 & 7))) & 1u) return 0;
+    }
+    return 1;
+}
+static inline void vm_write8_inl(uint64_t a, uint8_t v)
+{
+    const uint32_t ea = (uint32_t)a;
+    if (vm_st_ok(ea, 1)) { __atomic_store_n(vm_base + ea, v, __ATOMIC_RELAXED); return; }
+    vm_write8(a, v);
+}
+static inline void vm_write16_inl(uint64_t a, uint16_t v)
+{
+    const uint32_t ea = (uint32_t)a;
+    if (vm_st_ok(ea, 2)) {
+        const uint16_t s = __builtin_bswap16(v);
+        if (!(ea & 1u)) __atomic_store_n((uint16_t*)(vm_base + ea), s, __ATOMIC_RELAXED);
+        else memcpy(vm_base + ea, &s, 2);
+        return; }
+    vm_write16(a, v);
+}
+static inline void vm_write32_inl(uint64_t a, uint32_t v)
+{
+    const uint32_t ea = (uint32_t)a;
+    if (vm_st_ok(ea, 4)) {
+        const uint32_t s = __builtin_bswap32(v);
+        if (!(ea & 3u)) __atomic_store_n((uint32_t*)(vm_base + ea), s, __ATOMIC_RELAXED);
+        else memcpy(vm_base + ea, &s, 4);
+        return; }
+    vm_write32(a, v);
+}
+static inline void vm_write64_inl(uint64_t a, uint64_t v)
+{
+    const uint32_t ea = (uint32_t)a;
+    if (vm_st_ok(ea, 8)) {
+        const uint64_t s = __builtin_bswap64(v);
+        if (!(ea & 7u)) __atomic_store_n((uint64_t*)(vm_base + ea), s, __ATOMIC_RELAXED);
+        else memcpy(vm_base + ea, &s, 8);
+        return; }
+    vm_write64(a, v);
+}
+#ifndef PPU_NO_INLINE_STORES
+#define vm_write8(a, v)  vm_write8_inl(a, v)
+#define vm_write16(a, v) vm_write16_inl(a, v)
+#define vm_write32(a, v) vm_write32_inl(a, v)
+#define vm_write64(a, v) vm_write64_inl(a, v)
+#endif
+
 /* Syscall handler */
 #ifdef __cplusplus
 extern "C"
