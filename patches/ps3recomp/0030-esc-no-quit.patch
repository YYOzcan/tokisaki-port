diff --git a/libs/video/rsx_vulkan_backend.c b/libs/video/rsx_vulkan_backend.c
index f134235..500acc8 100644
--- a/libs/video/rsx_vulkan_backend.c
+++ b/libs/video/rsx_vulkan_backend.c
@@ -4359,8 +4359,10 @@ int rsx_vulkan_backend_pump_messages(void)
     int quit = 0;
     SDL_Event e;
     while (SDL_PollEvent(&e)) {
+        /* Only closing the window quits: Esc is a pad button (Circle, back)
+         * in the keyboard layout, and quitting on it ended the game whenever a
+         * player backed out of a menu. */
         if (e.type == SDL_QUIT) quit = 1;
-        else if (e.type == SDL_KEYDOWN && e.key.keysym.sym == SDLK_ESCAPE) quit = 1;
     }
     return quit ? -1 : 0;
 }
