+/* SIXAXIS from the mouse: while Ctrl is held the mouse tilts the controller
+ * instead of turning the view -- left/right rolls it like a steering wheel
+ * (valves, charges), up/down pitches it -- and the accelerometers report
+ * gravity for that attitude, the gyro the roll rate. Released, it settles
+ * back to rest. PS3_PAD_GYRO_SENS: radians per 1000 mouse counts (default 5). */
+static volatile int s_gyro_active = 0;
+static volatile int s_gyro_dx = 0, s_gyro_dy = 0;   /* motion not yet applied */
+static float s_gyro_roll = 0.0f, s_gyro_pitch = 0.0f;
+static u16 s_sensor[4] = { 512, 399, 512, 512 };    /* X, Y, Z, G as at rest */
+
+static void pad_gyro_update(int active)
+{
+    static float sens = -1.0f;
+    if (sens < 0.0f) { const char* e = getenv("PS3_PAD_GYRO_SENS"); sens = e ? (float)atof(e) : 5.0f;
+                       if (sens <= 0.0f) sens = 5.0f; }
+    const int dx = s_gyro_dx, dy = s_gyro_dy;
+    s_gyro_dx = 0; s_gyro_dy = 0;
+    float rate = 0.0f;
+    if (active) {
+        const float k = sens * 0.001f;
+        rate = dx * k;
+        s_gyro_roll += rate;
+        s_gyro_pitch += dy * k;
+        const float lim = 1.5f;   /* ~86 degrees */
+        if (s_gyro_roll > lim) s_gyro_roll = lim;
+        if (s_gyro_roll < -lim) s_gyro_roll = -lim;
+        if (s_gyro_pitch > lim) s_gyro_pitch = lim;
+        if (s_gyro_pitch < -lim) s_gyro_pitch = -lim;
+    } else {
+        s_gyro_roll *= 0.5f; s_gyro_pitch *= 0.5f;   /* back to rest in a few polls */
+        if (fabsf(s_gyro_roll) < 0.001f) s_gyro_roll = 0.0f;
+        if (fabsf(s_gyro_pitch) < 0.001f) s_gyro_pitch = 0.0f;
+    }
+    /* ~113 counts per g around 512; at rest gravity reads -1 g on Y (399). */
+    const float g = 113.0f;
+    float x = 512.0f + g * sinf(s_gyro_roll);
+    float y = 512.0f - g * cosf(s_gyro_roll) * cosf(s_gyro_pitch);
+    float z = 512.0f + g * sinf(s_gyro_pitch);
+    float w = 512.0f + rate * 400.0f;
+    const float v[4] = { x, y, z, w };
+    for (int i = 0; i < 4; i++) {
+        float c = v[i] < 0.0f ? 0.0f : v[i] > 1023.0f ? 1023.0f : v[i];
+        s_sensor[i] = (u16)(c + 0.5f);
+    }
+}
+
 /* Direct mouse look: the relative motion (counts) since the last call, for a
  * title whose look code is hooked to turn the view by it once per frame.
  * Returns 0 (and no motion) while the mouse is not captured. Calling it keeps
@@ -317,6 +363,10 @@ int cellPad_take_mouse_motion(int* dx, int* dy, float* sens, int* invert)
     s_mouse_direct_ms = pad_now_ms();
     if (!s_mouse_captured) return 0;
     SDL_GetRelativeMouseState(dx, dy);
+    if (s_gyro_active) {          /* Ctrl held: the motion tilts the pad instead */
+        s_gyro_dx += *dx; s_gyro_dy += *dy;
+        *dx = *dy = 0;
+    }
     return 1;
 }
 
