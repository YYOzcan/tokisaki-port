diff --git a/runtime/spu/spu_channels.c b/runtime/spu/spu_channels.c
index b7a55478..6cfb1d41 100644
--- a/runtime/spu/spu_channels.c
+++ b/runtime/spu/spu_channels.c
@@ -21,6 +21,8 @@
 #include <stdio.h>
 #include <stdlib.h>
 #include <setjmp.h>
+#include <pthread.h>
+#include <unistd.h>
 #ifndef _WIN32
 #include <sched.h>   /* sched_yield */
 #endif
@@ -333,10 +335,49 @@ static __thread mfc_engine*  t_mfc_eng;
 static __thread unsigned     t_mfc_gen;
 
 static mfc_engine* mfc_for_slow(spu_context* ctx);
+/* SPU_JOB_WATCH=<overlay id>: every 5 s a monitor thread prints the
+ * registers of each SPU context that has that job module resident (contexts
+ * are noted at their first MFC use). Racy reads; a diagnostic for a job that
+ * never ends. */
+static spu_context* volatile s_watch_ctx[32];
+static void* spu_job_watch_main(void* arg)
+{
+    const int ovl = (int)(intptr_t)arg;
+    for (;;) {
+        sleep(5);
+        for (int i = 0; i < 32; i++) {
+            spu_context* c = s_watch_ctx[i];
+            if (!c || c->resident_ovl != ovl) continue;
+            fprintf(stderr, "[job-watch] ctx %p ovl %d pc 0x%05X:", (void*)c, ovl, (unsigned)(c->pc & SPU_LS_MASK));
+            for (int r = 0; r < 128; r++) {
+                if (r == 3 || r == 80 || r == 100 || r == 120) fprintf(stderr, "\n   r%-3d", r);
+                if (r >= 3 && r < 16) fprintf(stderr, " %08X", c->gpr[r]._u32[0]);
+                if (r >= 80 && r < 128) fprintf(stderr, " %08X", c->gpr[r]._u32[0]);
+            }
+            fprintf(stderr, "\n");
+        }
+    }
+    return 0;
+}
+static void spu_job_watch_note(spu_context* ctx)
+{
+    static int ovl = -2;
+    if (ovl == -2) {
+        const char* e = getenv("SPU_JOB_WATCH");
+        ovl = e ? atoi(e) : -1;
+        if (ovl >= 0) { pthread_t t; pthread_create(&t, 0, spu_job_watch_main, (void*)(intptr_t)ovl); }
+    }
+    if (ovl < 0) return;
+    for (int i = 0; i < 32; i++) {
+        if (s_watch_ctx[i] == ctx) return;
+        if (!s_watch_ctx[i]) { s_watch_ctx[i] = ctx; return; }
+    }
+}
 static mfc_engine* mfc_for(spu_context* ctx)
 {
     const unsigned gen = __atomic_load_n(&s_mfc_gen, __ATOMIC_ACQUIRE);
     if (t_mfc_ctx == ctx && t_mfc_gen == gen) return t_mfc_eng;
+    spu_job_watch_note(ctx);
     mfc_engine* e = mfc_for_slow(ctx);
     t_mfc_ctx = ctx; t_mfc_eng = e; t_mfc_gen = gen;
     return e;
