+/* Diagnostics: every tracked taskset's bitsets (ready, pending, enabled,
+ * and the tasks this runtime has running), e.g. when the frame stops. */
+void spu_taskset_dump_all(const char* why)
+{
+    extern uint8_t* vm_base;
+    for (int i = 0; i < TS_TRACK; i++) {
+        const uint32_t ea = s_ts_run[i].ea;
+        if (!ea) continue;
+        const uint8_t* ts = vm_base + ea;
+        fprintf(stderr, "[taskset-dump] %s 0x%08X ready ", why, ea);
+        for (int k = 0; k < 16; k++) fprintf(stderr, "%02X", ts[0x10 + k]);
+        fprintf(stderr, " pend ");
+        for (int k = 0; k < 16; k++) fprintf(stderr, "%02X", ts[0x20 + k]);
+        fprintf(stderr, " enab ");
+        for (int k = 0; k < 16; k++) fprintf(stderr, "%02X", ts[0x30 + k]);
+        fprintf(stderr, " run ");
+        for (int k = 0; k < 16; k++) fprintf(stderr, "%02X", s_ts_run[i].running[k]);
+        fprintf(stderr, " sig ");
+        for (int k = 0; k < 16; k++) fprintf(stderr, "%02X", ts[CSTS_SIGNALLED + k]);
+        fprintf(stderr, "\n");
+    }
