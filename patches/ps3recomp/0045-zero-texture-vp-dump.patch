 /* Decode a guest texture out of guest memory and hand every face and level to
  * the backend. Returns the backend handle, or 0. */
+/* RSX_ZERO_TEXTURE="<location>:<offset>[,...]": textures read from those
+ * addresses decode as transparent black. Killzone 2's last screen pass lays
+ * the SPU post-processing layer (depth of field and motion blur, premultiplied,
+ * 640x360 in main memory) over the frame with ONE / ONE_MINUS_SRC_ALPHA; with
+ * that layer zero the frame is the sharp scene plus its bloom. */
+static int eng_tex_zeroed(u32 location, u32 offset)
+{
+    static int n = -1; static u32 loc[8], off[8];
+    if (n < 0) {
+        n = 0;
+        const char* e = getenv("RSX_ZERO_TEXTURE");
+        while (e && *e && n < 8) {
+            char* q; const unsigned long l = strtoul(e, &q, 0);
+            if (*q != ':') break;
+            const unsigned long o = strtoul(q + 1, &q, 0);
+            loc[n] = (u32)l; off[n] = (u32)o; n++;
+            e = (*q == ',') ? q + 1 : q;
+            if (!*q) break;
+        }
+    }
+    for (int i = 0; i < n; i++) if (loc[i] == location && off[i] == offset) return 1;
+    return 0;
+}
