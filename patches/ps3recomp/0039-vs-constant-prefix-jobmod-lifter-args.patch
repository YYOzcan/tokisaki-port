diff --git a/libs/video/rsx_vp_decompiler.c b/libs/video/rsx_vp_decompiler.c
index edd01d68..7ec19131 100644
--- a/libs/video/rsx_vp_decompiler.c
+++ b/libs/video/rsx_vp_decompiler.c
@@ -263,6 +263,27 @@ int rsx_vp_analyze_inputs(const u8* ucode, u32 max_bytes,
     return instrs;
 }
 
+int rsx_vp_analyze_constants(const u8* ucode, u32 max_bytes, u32* count)
+{
+    if (!ucode || !count) return 0;
+    u32 n = 0;
+    for (u32 off = 0; off + 16 <= max_bytes; off += 16) {
+        const u32 d1 = rd_le(ucode + off + 4);
+        const u32 d2 = rd_le(ucode + off + 8);
+        const u32 d3 = rd_le(ucode + off + 12);
+        const u32 src0 = ((d2 >> 23) & 0x1FF) | ((d1 & 0xFF) << 9);
+        const u32 src1 = (d2 >> 6) & 0x1FFFF;
+        const u32 src2 = ((d3 >> 21) & 0x7FF) | ((d2 & 0x3F) << 11);
+        if ((src0 & 3u) == 3u || (src1 & 3u) == 3u || (src2 & 3u) == 3u) {
+            if ((d3 >> 1) & 1u) return 0;               /* vp_c[(c + aN) & 511] */
+            const u32 c = ((d1 >> 12) & 0x3FF) & 511u;  /* as emit_src reads it */
+            if (c + 1u > n) n = c + 1u;
+        }
+        if (d3 & 1u) { *count = n; return 1; }
+    }
+    return 0;
+}
+
 static int rsx_vp_decompile_impl(
     const u8* ucode, u32 max_bytes, u32 vtex_mask, int compact_inputs,
     u32 input_mask, char* out, u32 out_size);
