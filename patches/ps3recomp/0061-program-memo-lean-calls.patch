+/* The indirect call with none of the diagnostics below switched on: look the
+ * target up and run it, with the same depth guard, vcall stack and trampoline
+ * loop as ps3_indirect_call_impl. Every switch there was a static test (and
+ * a few thread-local stores) per call -- ~3% of Killzone 2's main thread is
+ * indirect calls. 0: not handled (no switch-free state, a null target or one
+ * that is not a lifted function), the full path decides. PPU_ICALL_LEAN=0:
+ * always the full path. */
+static int ppu_icall_lean_on(void)
+{
+    static int on = -1;
+    if (on < 0) {
+        static const char* const kSwitches[] = {
+            "PPU_CSCHECK", "PS3_ICALL_GATE", "BCTRL_RING", "PS3_BREADCRUMB",
+            "PPU_TOCWATCH", "PS3_CALLTRACE", "PS3_CALLTRACE_LR", "PS3_CALLTRACE_R5",
+            "PS3_CALLTRACE_FROM", "PS3_CALLTRACE_TO", "FLOW_FORCE_RTCFG", "SPURS_TRACE",
+            "PS3_PRX_CALLTRACE", "PPU_TOCFIX", "PPU_RETWATCH" };
+        int lean = 1;
+        const char* e = getenv("PPU_ICALL_LEAN");
+        if (e && e[0] == '0') lean = 0;
+        for (unsigned i = 0; lean && i < sizeof kSwitches / sizeof kSwitches[0]; i++)
+            if (getenv(kSwitches[i])) lean = 0;
+        on = lean;
+    }
+    return on;
+}
+static inline int ppu_icall_lean(ppu_context* ctx)
+{
+    const uint32_t addr = g_icall_target_set ? g_icall_target : (uint32_t)ctx->ctr;
+    if (!addr) return 0;
+    const ppu_fn fn = ppu_lookup(addr);
+    if (!fn || g_dispatch_depth > 4000) return 0;
+    g_icall_target_set = 0;
+    g_active_ctx = ctx;
+    g_dispatch_depth++;
+    if (g_vcall_sp < 128) g_vcall_stk[g_vcall_sp] = addr;
+    g_vcall_sp++;
+    fn(ctx);
+    while (g_trampoline_fn) {
