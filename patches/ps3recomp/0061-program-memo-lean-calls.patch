+    static int memo = -1;
+    if (memo < 0) { const char* e = getenv("SPU_FP_MEMO"); memo = !(e && e[0] == '0'); }
+    const int use = memo && n >= 256;
+    if (use) {
+        AcquireSRWLockExclusive(&s_fp_memo_lock);
+        for (unsigned k = 0; k < SPU_FP_MEMO_N; k++)
