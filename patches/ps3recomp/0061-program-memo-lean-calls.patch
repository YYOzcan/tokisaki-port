+/* What a draw needs from its two programs, worked out once per program
+ * rather than once per draw. Every draw walked the fragment program six times
+ * (its size twice, the sampled units, the gamma units, the constants and the
+ * structural hash, the last two byte at a time) and hashed the vertex
+ * program byte at a time: ~9% of the FIFO thread in Killzone 2.
+ *
+ * Vertex program: everything here depends on vp[] from the start slot on,
+ * so it holds while vp_gen (bumped by every vp[] write) and the start slot do.
+ *
+ * Fragment program: one entry per guest address, holding a copy of the
+ * program. It holds while every INSTRUCTION slot reads the same; the inline
+ * constant slots, which titles patch between draws, are read again each time
+ * (where they are follows from the instructions, so it cannot have moved).
+ * RSX_PROG_MEMO=0: work everything out per draw, as before. */
+static int eng_prog_memo_on(void)
+{
+    static int on = -1;
+    if (on < 0) { const char* e = getenv("RSX_PROG_MEMO"); on = !(e && e[0] == '0'); }
+    return on;
+}
+
+static struct {
+    int valid;
+    u32 gen, start;
+    u32 instrs;                 /* rsx_vp_program_size_instrs */
+    u64 hash;                   /* eng_fnv1a of the instrs * 16 bytes */
+    int in_ok;                  /* rsx_vp_analyze_inputs was exact */
+    u32 in_mask;
+} s_vpm;
+
+static void eng_vp_memo(const u8* vp_uc, u32 start)
+{
+    if (s_vpm.valid && s_vpm.gen == g.rsx.vp_gen && s_vpm.start == start) return;
+    s_vpm.valid = 1;
+    s_vpm.gen = g.rsx.vp_gen;
+    s_vpm.start = start;
+    s_vpm.instrs = rsx_vp_program_size_instrs(vp_uc, (RSX_DSP_VP_INSTR - start) * 16u);
+    s_vpm.hash = eng_fnv1a(vp_uc, s_vpm.instrs * 16u, 1469598103934665603ull);
+    rsx_vp_input_analysis analysis = { 0xFFFFu, 0 };
+    s_vpm.in_ok = s_vpm.instrs &&
+        rsx_vp_analyze_inputs(vp_uc, s_vpm.instrs * 16u, &analysis) == (int)s_vpm.instrs &&
+        analysis.exact && analysis.input_mask;
+    s_vpm.in_mask = analysis.input_mask;
+}
+
+#define ENG_FPM_SLOTS 1024u      /* a power of two */
+typedef struct eng_fp_memo {
+    u32 loc, off, used;
+    u32 size;                    /* rsx_fp_program_size */
+    u8* bytes;                   /* the program, constant slots zeroed */
+    u32 cap;
+    u32 nconst;
+    u16 const_at[RSX_FP_MAX_INLINE_CONSTANTS];  /* byte offsets of the constant slots */
+    int consts_ok;               /* rsx_fp_collect_constants did not fail */
+    u32 tex_units;
+    int reads_wpos;
+    u64 shash;                   /* rsx_fp_structural_hash, seed FNV basis */
+    int gamma_valid;
+    u8  gamma_in[RSX_DSP_NUM_TEXTURES];
+    u32 gamma_units;
+} eng_fp_memo;
+static eng_fp_memo s_fpm[ENG_FPM_SLOTS];
+static eng_fp_memo* s_fpm_cur;   /* the current draw's, set by eng_guest_programs */
+
+/* Does the program at p still have the instructions of m? */
+static int eng_fp_memo_same(const eng_fp_memo* m, const u8* p)
+{
+    u32 k = 0;
+    for (u32 o = 0; o < m->size; o += 16) {
+        if (k < m->nconst && m->const_at[k] == o) { k++; continue; }
+        if (memcmp(p + o, m->bytes + o, 16)) return 0;
+    }
+    return 1;
+}
+
+/* The program at (loc, off): its memo entry, refreshed when its instructions
+ * changed, with *out_uc pointing at it. NULL: no program there. */
+static eng_fp_memo* eng_fp_memo_get(u32 loc, u32 off, const u8** out_uc)
+{
+    const u32 h = ((off >> 4) * 0x9E3779B1u ^ loc) & (ENG_FPM_SLOTS - 1u);
+    eng_fp_memo* m = NULL;
+    for (u32 i = 0; i < 8; i++) {
+        eng_fp_memo* e = &s_fpm[(h + i) & (ENG_FPM_SLOTS - 1u)];
+        if (e->used && e->loc == loc && e->off == off) { m = e; break; }
+        if (!e->used && !m) m = e;
+    }
+    if (!m) m = &s_fpm[h];               /* a full run: take the home slot */
+    if (m->used && m->loc == loc && m->off == off && m->size) {
+        const u8* p = eng_guest_ptr(NULL, loc, off, m->size);
+        if (p && eng_fp_memo_same(m, p)) { *out_uc = p; return m; }
+    }
+    /* New, or its instructions changed: work it out again. */
+    m->used = 1; m->loc = loc; m->off = off;
+    m->size = 0; m->gamma_valid = 0;
+    const u8* uc = eng_guest_ptr(NULL, loc, off, 16);
+    const u32 size = uc ? rsx_fp_program_size(uc, ENG_FP_MAX_BYTES) : 0;
+    if (size) uc = eng_guest_ptr(NULL, loc, off, size);
+    if (!uc || !size) { *out_uc = NULL; return NULL; }
+    if (m->cap < size) {
+        u8* b = (u8*)realloc(m->bytes, size);
+        if (!b) { *out_uc = NULL; return NULL; }
+        m->bytes = b; m->cap = size;
+    }
+    memcpy(m->bytes, uc, size);
+    m->nconst = 0;
+    for (u32 o = 0; o + 16 <= size; o += 16) {   /* the walk of rsx_fp_collect_constants */
+        const u32 w0 = rsx_fp_read_word(uc + o), w1 = rsx_fp_read_word(uc + o + 4);
+        const u32 w2 = rsx_fp_read_word(uc + o + 8), w3 = rsx_fp_read_word(uc + o + 12);
+        (void)w0;
+        if (rsx_fp_instruction_has_constant(w1, w2, w3) && o + 32 <= size &&
+            m->nconst < RSX_FP_MAX_INLINE_CONSTANTS) {
+            m->const_at[m->nconst++] = (u16)(o + 16);
+            memset(m->bytes + o + 16, 0, 16);
+            o += 16;
+        }
+    }
+    rsx_fp_constant_block cb;
+    m->consts_ok = rsx_fp_collect_constants(uc, size, &cb) >= 0 && cb.count == m->nconst;
+    m->tex_units = rsx_fp_texture_units(uc, size);
+    m->reads_wpos = rsx_fp_reads_wpos(uc, size);
+    m->shash = rsx_fp_structural_hash(uc, size, 1469598103934665603ull);
+    m->size = size;
+    *out_uc = uc;
+    return m;
+}
+
+/* rsx_fp_collect_constants for a memoised program: the slots it found. */
+static int eng_fp_memo_constants(const eng_fp_memo* m, const u8* uc, rsx_fp_constant_block* out)
+{
+    memset(out, 0, sizeof *out);
+    if (!m->consts_ok) return -1;
+    for (u32 k = 0; k < m->nconst; k++)
+        for (u32 c = 0; c < 4; c++)
+            out->values[k][c] = rsx_fp_sanitize_constant_word(
+                rsx_fp_read_word(uc + m->const_at[k] + c * 4u));
+    out->count = m->nconst;
+    return (int)m->nconst;
+}
