+/* Sampled textures are created and released by the dozen every frame
+ * (Killzone 2: ~45 per frame), and on NVIDIA each vkCreateImage +
+ * vkAllocateMemory + view costs ~0.25 ms of driver ioctls -- a fifth of the
+ * FIFO thread. A released texture's image, memory and view are kept here once
+ * the GPU is done with it, and the next texture with the same parameters
+ * takes them. PS3RECOMP_VK_TEXPOOL_MB caps the memory kept (default 256). */
+#define VK_TPOOL_MAX 1024
+static vk_image s_tpool[VK_TPOOL_MAX];
+static u32 s_tpool_n;
+static VkDeviceSize s_tpool_bytes;
+static void vk_tpool_put(vk_image* im)
+{
+    static VkDeviceSize cap = 0;
+    if (!cap) { const char* e = getenv("PS3RECOMP_VK_TEXPOOL_MB");
+                cap = (VkDeviceSize)(e ? atoi(e) : 256) << 20; if (!cap) cap = 1; }
+    if (!im->pkey[0] || cap <= 1) { vk_destroy_image(im); return; }
+    while ((s_tpool_n == VK_TPOOL_MAX || s_tpool_bytes + im->psize > cap) && s_tpool_n) {
+        s_tpool_bytes -= s_tpool[0].psize;          /* oldest out */
+        vk_destroy_image(&s_tpool[0]);
+        memmove(&s_tpool[0], &s_tpool[1], (size_t)(--s_tpool_n) * sizeof s_tpool[0]);
+    }
+    s_tpool[s_tpool_n++] = *im;
+    s_tpool_bytes += im->psize;
+    memset(im, 0, sizeof *im);
+}
+static int vk_tpool_take(const u64 key[3], vk_image* out)
+{
+    for (u32 i = s_tpool_n; i-- > 0;)
+        if (!memcmp(s_tpool[i].pkey, key, sizeof s_tpool[i].pkey)) {
+            *out = s_tpool[i];
+            s_tpool_bytes -= s_tpool[i].psize;
+            memmove(&s_tpool[i], &s_tpool[i + 1], (size_t)(s_tpool_n - i - 1) * sizeof s_tpool[0]);
+            s_tpool_n--;
+            return 1;
+        }
+    return 0;
+}
+static void vk_tpool_flush(void)
+{
+    for (u32 i = 0; i < s_tpool_n; i++) vk_destroy_image(&s_tpool[i]);
+    s_tpool_n = 0; s_tpool_bytes = 0;
+}
