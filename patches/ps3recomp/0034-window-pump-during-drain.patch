+/* Wait for a fence without starving the window: in 4 ms slices, pumping the
+ * window's events in between (a frame that keeps the GPU busy for long used to
+ * leave keys unread and the window "not responding"). */
+static void vk_pump_if_due(void);
+static VkResult vk_wait_fence(VkFence* f)
+{
+    VkResult r;
+    while ((r = pvkWaitForFences(s_vk.device, 1, f, VK_TRUE, 4000000ull)) == VK_TIMEOUT)
+        vk_pump_if_due();
+    return r;
+}
