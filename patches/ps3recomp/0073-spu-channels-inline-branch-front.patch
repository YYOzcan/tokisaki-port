+/* The common indirect branch, before the full resolver below sets up its
+ * frame: the full resolver answers it by calling the resident overlay's lift
+ * at the target, else the context image's (after its stack-reset check) --
+ * when none of what it checks first applies: the interrupt return (srr0 with
+ * interrupts on and registers saved), the taskset syscall address, on a SPURS
+ * policy-mode context the two kernel services (the policy module calling into
+ * the job area gets the overlay check first, as there), elsewhere the
+ * job-return address, a
+ * taskset task (none registered, none resident: below 0x3000 the full
+ * resolver only clears resident_task), a resident code span over the target,
+ * the resolver-only image. A diagnostic that wants to see every branch turns it
+ * off, as does SPU_IB_FAST=0. Its stack-reset check returns at once in policy
+ * mode. ~6.5 M branches a second in Killzone 2's jobs (Havok's ray casts call
+ * through function tables). */
+static void spu_indirect_branch_full(spu_context* ctx);
+static int s_ib_fast = -1;
+static void spu_ib_fast_init(void)
+{
+    const char* e = getenv("SPU_IB_FAST");
+    s_ib_fast = !(e && e[0] == '0') && !getenv("SPU_IBCOV") && !getenv("SPU_POLLTRACE") &&
+                !getenv("YDKJ_POLTRACE") && !getenv("LBP_HLE_JOBDONE") && !getenv("SPU_JOBEXEC") &&
+                !getenv("SPU_IRQTRACE") && !getenv("SPURS_PM_TRACE");
+}
 void spu_indirect_branch(spu_context* ctx)
+{
+    if (__builtin_expect(s_ib_fast < 0, 0)) spu_ib_fast_init();
+    const uint32_t pc = ctx->pc & SPU_LS_MASK;
+    if (s_ib_fast && !ctx->resident_task && pc != SPURS_TASKSET_PM_SYSCALL_LS &&
+        !(ctx->irq_saved && ctx->int_enable && pc == (ctx->irq_resume_pc & SPU_LS_MASK)) &&
+        (ctx->policy_mode
+             ? pc != SPURS_PM_EXIT_TO_KERNEL_LS && pc != SPURS_PM_SELECT_WORKLOAD_LS
+             : pc != SPU_JOB_RETURN_LS) &&
+        ctx->image_id != SPU_RESOLVER_ONLY_IMAGE_ID && !s_task_entry_count && !s_task_elf_count) {
+        /* the policy module calling into the job area: its overlay check first, as below */
+        if (ctx->policy_mode && pc >= 0x4000u && pc < 0x3E000u &&
+            (ctx->gpr[0]._u32[0] & SPU_LS_MASK) < 0x4000u) {
+            ctx->pc = pc;
+            spu_overlay_check_entry(ctx);
+        }
+        int span = 0;
+        for (unsigned slot = 0; slot < 4; ++slot)
+            span |= ctx->resident_code[slot].image_id && pc >= ctx->resident_code[slot].lsa &&
+                    pc - ctx->resident_code[slot].lsa < ctx->resident_code[slot].size;
+        if (!span) {
+            spu_fn fn = ctx->resident_ovl ? spu_lookup(pc, ctx->resident_ovl) : NULL;
+            if (!fn) fn = spu_lookup(pc, ctx->image_id);
+            if (fn) {
+                ctx->pc = pc;
+                spu_check_stack_reset(ctx, fn);
+#if defined(__clang__)
+                __attribute__((musttail)) return fn(ctx);
+#else
+                fn(ctx);
+                return;
+#endif
+            }
+        }
+    }
+#if defined(__clang__)
+    __attribute__((musttail)) return spu_indirect_branch_full(ctx);
+#else
+    spu_indirect_branch_full(ctx);
+#endif
+}
