+/* The MFC parameter channels, inline, for the lifted code: a DMA is eight
+ * channel writes -- LSA, EAH, EAL, Size, TagID, Cmd, WrTagMask, WrTagUpdate --
+ * and the first five and the tag mask only store a value in the context, but
+ * each went through spu_wrch's checks, an engine lookup and a switch (~3 M
+ * DMAs a second in Killzone 2's jobs). The command and the tag update still
+ * take spu_wrch, which does their work; so does every channel while a channel
+ * diagnostic (SPU_CHHIST) wants to see each write (g_spu_wrch_slow, spu_channels.c). */
+#if defined(SPU_USE_DISPATCH_MT) && !defined(SPU_WRCH_NO_INLINE)
+void spu_wrch(spu_context* ctx, uint32_t channel, u128 value);
+extern int g_spu_wrch_slow;
+static inline __attribute__((always_inline)) void spu_wrch_inl(spu_context* ctx, uint32_t channel, u128 value)
+{
+    if (__builtin_constant_p(channel) && __builtin_expect(!g_spu_wrch_slow, 1)) {
+        const uint32_t v = value._u32[0];
+        switch (channel) {
+        case MFC_LSA:       ctx->mfc_lsa = v; return;
+        case MFC_EAH:       ctx->mfc_eah = v; return;
+        case MFC_EAL:       ctx->mfc_eal = v; return;
+        case MFC_Size:      ctx->mfc_size = v; return;
+        case MFC_TagID:     ctx->mfc_tag = v & 0x1F; return;
+        case MFC_WrTagMask: ctx->mfc_tag_mask = v; return;
+        default: break;
+        }
+    }
+    spu_wrch(ctx, channel, value);
+}
+#define spu_wrch(c, ch, v) spu_wrch_inl((c), (ch), (v))
+#endif
