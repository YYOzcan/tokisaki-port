+/* vtx_decode for the common types, one vector per element (rsx_vertex_fetch_all):
+ * the same bits as the scalar form for every input (tests/test_vtx_fetch_simd.c).
+ * Each reads a fixed number of bytes from the element's start -- 16 (FLOAT),
+ * 8 (HALF, SNORM16), 4 (UNORM8) -- whatever its size; the caller keeps that
+ * inside the attribute's span. Lanes past `size` take the default (0, 0, 0, 1). */
+typedef struct { __m128i shuf, keep, tail; u32 load; int on; } vtx_simd;
+
+static vtx_simd vtx_simd_setup(u32 type, u32 size)
+{
+    vtx_simd d;
+    memset(&d, 0, sizeof d);
+    const u32 n = size < 4 ? size : 4;
+    u8 sh[16];
+    u32 keep[4], tail[4];
+    for (u32 c = 0; c < 4; c++) {
+        keep[c] = c < n ? 0xFFFFFFFFu : 0u;
+        tail[c] = c < n ? 0u : (c == 3 ? 0x3F800000u : 0u);
+    }
+    memset(sh, 0x80, sizeof sh);
+    switch (type) {
+    case RSX_VTX_TYPE_FLOAT:      /* lane c: bytes 4c+3 .. 4c */
+        for (u32 c = 0; c < n; c++)
+            for (u32 b = 0; b < 4; b++) sh[c * 4 + b] = (u8)(c * 4 + 3 - b);
+        d.load = 16; break;
+    case RSX_VTX_TYPE_HALF:       /* lane c: the big-endian half, zero-extended */
+        for (u32 c = 0; c < n; c++) { sh[c * 4] = (u8)(c * 2 + 1); sh[c * 4 + 1] = (u8)(c * 2); }
+        d.load = 8; break;
+    case RSX_VTX_TYPE_SNORM16:    /* lane c: the big-endian s16 in the top half (sign-extended by a shift) */
+        for (u32 c = 0; c < n; c++) { sh[c * 4 + 2] = (u8)(c * 2 + 1); sh[c * 4 + 3] = (u8)(c * 2); }
+        d.load = 8; break;
+    case RSX_VTX_TYPE_UNORM8:
+        d.load = 4; break;
+    default:
+        return d;
+    }
+    if (!n) return d;
+    memcpy(&d.shuf, sh, 16); memcpy(&d.keep, keep, 16); memcpy(&d.tail, tail, 16);
+    d.on = 1;
+    return d;
