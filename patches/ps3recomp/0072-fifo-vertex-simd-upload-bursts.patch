+/* A run of one header's words into one upload window (incrementing methods,
+ * all inside 0x0B80..0x0BFC or all inside 0x1F00..0x1F7C; `be` the guest's
+ * big-endian words): rsx_dispatch_method's handling of each, in one loop
+ * (the FIFO walker's bursts, cellGcmSys.c). RSX_CONST_LOG set: word by word. */
+void rsx_dispatch_upload_burst(rsx_dispatch* rsx, u32 method, const u8* be, u32 count)
+{
+    static int logging = -1;
+    if (logging < 0) logging = getenv("RSX_CONST_LOG") != NULL;
+    const int vp = method >= M_VP_UPLOAD_INST && method < M_VP_UPLOAD_INST + 32 * 4;
+    for (u32 i = 0; i < count; i++) {
+        u32 arg;
+        memcpy(&arg, be + (size_t)i * 4u, 4);
+        arg = __builtin_bswap32(arg);
+        const u32 m = method + i * 4u;
+        if (logging) { rsx_dispatch_method(rsx, m, arg); continue; }
+        const u32 idx = m >> 2;
+        rsx->seen[idx]++;
+        rsx->regs[idx] = arg;
+        if (vp) {
+            const u32 lane = ((m - M_VP_UPLOAD_INST) >> 2) & 3;
+            u32* load = &rsx->regs[M_VP_UPLOAD_FROM_ID >> 2];
+            const u32 pos = *load * 4 + lane;
+            if (pos < RSX_DSP_VP_WORDS) {
+                rsx->vp[pos] = arg;
+                rsx->vp_gen++;
