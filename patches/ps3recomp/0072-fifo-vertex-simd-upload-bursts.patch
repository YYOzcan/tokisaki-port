+    static rsx_dispatch a, b;
+    static rsx_state sa, sb;
+    static u8 be[32 * 4];
+    rsx_dispatch_sink sink;
+    memset(&sink, 0, sizeof sink);
+    rsx_dispatch_init(&a, &sink);
+    rsx_state_init(&sa);
+    unsigned bad = 0, runs = 0;
+    for (int it = 0; it < 2000000; it++) {
+        const int vp = rnd() & 1;
+        const u32 window = vp ? 0x0B80u : 0x1F00u;
+        const u32 first = rnd() % 32, count = 1 + rnd() % (32 - first);
+        for (u32 i = 0; i < count * 4; i++) be[i] = (u8)rnd();
+        if (rnd() % 4 == 0) {        /* move the load pointers, sometimes near or past the ends */
+            u32 from = rnd() % 4 == 0 ? 500 + rnd() % 30 : rnd() % 520;
+            u32 cid = rnd() % 4 == 0 ? 460 + rnd() % 20 : rnd() % 470;
+            rsx_dispatch_method(&a, 0x1E9C, from);
+            rsx_dispatch_method(&a, 0x1EFC, cid);
+            sa.transform_constant_load = cid;
+            sa.vp_ucode_write = rnd() % 4 == 0 ? (u32)sizeof sa.vp_ucode - (rnd() % 64) * 4 : rnd() % 4096 * 4;
+        }
+        b = a; sb = sa;
+        for (u32 i = 0; i < count; i++) {
+            u32 w; memcpy(&w, be + i * 4, 4); w = __builtin_bswap32(w);
+            rsx_dispatch_method(&a, window + (first + i) * 4, w);
+            rsx_process_upload_method(&sa, window + (first + i) * 4, w);
+        }
+        rsx_dispatch_upload_burst(&b, window + first * 4, be, count);
+        rsx_process_upload_burst(&sb, window + first * 4, be, count);
+        runs++;
+        if (memcmp(&a, &b, sizeof a) || memcmp(&sa, &sb, sizeof sa)) {
+            if (bad < 5) printf("run %d: window 0x%04X first %u count %u: %s differs\n", it, window, first, count,
+                                memcmp(&a, &b, sizeof a) ? "rsx_dispatch" : "rsx_state");
+            bad++;
+            a = b; sa = sb;
+        }
+    }
+    printf("%s: %u runs, %u differ\n", bad ? "FAIL" : "ok", runs, bad);
+    return bad != 0;
+}
diff --git a/libs/video/tests/test_vtx_fetch_simd.c b/libs/video/tests/test_vtx_fetch_simd.c
new file mode 100644
index 00000000..26f23d72
--- /dev/null
+++ b/libs/video/tests/test_vtx_fetch_simd.c
@@ -0,0 +1,108 @@
+/* Host test: rsx_vertex_fetch_all (with its one-vector-per-element decode for
+ * FLOAT, HALF, UNORM8 and SNORM16) gives the same bytes and the same result
+ * as rsx_vertex_fetch_one per reference, the scalar per-vertex path, over
+ * random plans: every type, sizes 0-4, strides, dividers, references inside
+ * and outside the mapped spans, and spans that end on a PROT_NONE page (a
+ * vector read past the span faults).
+ *   cc -O2 -march=x86-64-v3 -I../../../include -I.. -ffunction-sections \
+ *      -Wl,--gc-sections -o /tmp/tvf test_vtx_fetch_simd.c ../rsx_vertex_compact.c && /tmp/tvf */
+#include "rsx_vertex_compact.h"
+#include "rsx_vertex_formats.h"
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/mman.h>
+
+/* rsx_vertex_compact.c's draw-state readers, unused here */
+void rsx_dsp_get_vertex_attr(const rsx_dispatch* r, u32 i, rsx_dsp_vertex_attr* o) { (void)r; (void)i; memset(o, 0, sizeof *o); }
+u32 rsx_dsp_vertex_data_base_offset(const rsx_dispatch* r) { (void)r; return 0; }
+void rsx_dsp_vertex_default(const rsx_dispatch* r, u32 a, float v[4]) { (void)r; (void)a; memset(v, 0, 16); }
+
+#define REGION (1u << 20)
+static u8* g_mem;
+
+static const u8* guest(void* user, u32 location, u32 offset, u32 bytes)
+{
+    (void)user; (void)location;
+    if ((u64)offset + bytes > REGION) return NULL;
+    return g_mem + offset;
+}
+
+static u32 rnd(void) { static u64 s = 0x9E3779B97F4A7C15ull; s ^= s << 13; s ^= s >> 7; s ^= s << 17; return (u32)s; }
+
+int main(void)
+{
+    /* the region, then a page that faults */
+    u8* m = mmap(NULL, REGION + 4096, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+    if (m == MAP_FAILED || mprotect(m + REGION, 4096, PROT_NONE)) { perror("mmap"); return 2; }
+    g_mem = m;
+    static const u16 halves[] = { 0x0000, 0x8000, 0x0001, 0x83FF, 0x0400, 0x3C00, 0xBC00, 0x7BFF, 0x7C00, 0xFC00, 0x7E00, 0x7FFF };
+    for (u32 i = 0; i < REGION; i += 2) {
+        u32 r = rnd();
+        if ((r & 7) == 0) { u16 h = halves[(r >> 3) % (sizeof halves / sizeof halves[0])]; g_mem[i] = (u8)(h >> 8); g_mem[i + 1] = (u8)h; }
+        else { g_mem[i] = (u8)r; g_mem[i + 1] = (u8)(r >> 8); }
+    }
+    static const u32 types[] = { 0, RSX_VTX_TYPE_SNORM16, RSX_VTX_TYPE_FLOAT, RSX_VTX_TYPE_HALF, RSX_VTX_TYPE_UNORM8,
+                                 RSX_VTX_TYPE_SINT16, RSX_VTX_TYPE_CMP32, RSX_VTX_TYPE_UINT8, 9 };
+    enum { MAXN = 400 };
+    static rsx_vertex_ref refs[MAXN];
+    static u8 out_ref[MAXN * 16 * 16], out_new[MAXN * 16 * 16];
+    unsigned plans = 0, bad = 0, elems = 0;
+    for (int it = 0; it < 200000; it++) {
+        rsx_vertex_fetch_plan p;
+        memset(&p, 0, sizeof p);
+        u32 mask = (rnd() & 0xFFFF) | 1u;
+        if (rnd() & 1) mask &= 0x1F | 1u;
+        rsx_vertex_layout_plan_init(&p.layout, mask);
+        p.base_offset = (rnd() & 3) ? 0 : (rnd() & 0xFFF);
+        p.divider_mask = rnd() & 0xFFFF;
+        p.guest_ptr = guest;
+        for (u32 a = 0; a < RSX_DSP_NUM_VERTEX_ATTR; a++) {
+            rsx_vertex_fetch_attr* f = &p.attr[a];
+            f->desc.type = types[rnd() % (sizeof types / sizeof types[0])];
+            f->desc.size = rnd() % 5;
+            f->elem_size = rsx_vertex_attrib_size(f->desc.type, f->desc.size);
+            f->desc.stride = (rnd() & 3) ? f->elem_size + (rnd() % 3) * 4 : (rnd() % 64);
+            f->stride = f->desc.stride ? f->desc.stride : f->elem_size;
+            const u32 r = rnd() % 8;
+            f->desc.frequency = r < 5 ? 0 : r < 6 ? 1 : 2 + rnd() % 4;
+            for (int c = 0; c < 4; c++) { u32 w = rnd(); memcpy(&f->default_value[c], &w, 4); }
+            /* often right against the faulting page */
+            f->desc.offset = (rnd() & 1) ? rnd() % (REGION / 2)
+                                         : (u32)(REGION - p.base_offset - (rnd() % 64) - (u64)f->stride * (rnd() % 200) - f->elem_size);
+        }
+        const u32 n = 1 + rnd() % MAXN;
+        const u32 base_index = (rnd() & 3) ? 0 : rnd() % 50;
+        u32 vid = rnd() % 300;
+        for (u32 i = 0; i < n; i++) {
+            if (rnd() % 6 == 0) vid = rnd() % 400;
+            refs[i].vertex_id = vid++;
+            refs[i].base_index = (rnd() % 20 == 0) ? rnd() % 50 : base_index;
+        }
+        rsx_vertex_fetch_plan_prepare(&p, refs, n);
+        const u32 stride = p.layout.stride;
+        memset(out_ref, 0xCD, (size_t)n * stride);
+        memset(out_new, 0xCD, (size_t)n * stride);
+        int ok_ref = 1;
+        for (u32 i = 0; i < n && ok_ref; i++)
+            ok_ref = rsx_vertex_fetch_one(&p, &refs[i], out_ref + (size_t)i * stride);
+        const int ok_new = rsx_vertex_fetch_all(&p, refs, n, out_new);
+        plans++;
+        elems += n * p.layout.count;
+        if (ok_ref != ok_new || (ok_ref && memcmp(out_ref, out_new, (size_t)n * stride))) {
+            if (bad < 5) {
+                size_t k = 0;
+                while (k < (size_t)n * stride && out_ref[k] == out_new[k]) k++;
+                const u32 v = (u32)(k / (stride ? stride : 1)), slot = (u32)(k % (stride ? stride : 1)) / 16u;
+                const u32 a = p.layout.attrs[slot];
+                printf("plan %d: ok %d/%d, first difference vertex %u slot %u (attr %u type %u size %u stride %u freq %u)\n",
+                       it, ok_ref, ok_new, v, slot, a, p.attr[a].desc.type, p.attr[a].desc.size, p.attr[a].stride,
+                       p.attr[a].desc.frequency);
+            }
+            bad++;
+        }
+    }
+    printf("%s: %u plans, %u attribute elements, %u differ\n", bad ? "FAIL" : "ok", plans, elems, bad);
+    return bad != 0;
+}
