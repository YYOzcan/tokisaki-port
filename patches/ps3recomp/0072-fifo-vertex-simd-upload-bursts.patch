+    switch (type) {
+    case RSX_VTX_TYPE_FLOAT:
+        r = _mm_shuffle_epi8(_mm_loadu_si128((const __m128i*)p), d->shuf);
+        break;
+    case RSX_VTX_TYPE_HALF: {
+        const __m128i h = _mm_shuffle_epi8(_mm_loadl_epi64((const __m128i*)p), d->shuf);
+        const __m128i e = _mm_and_si128(h, _mm_set1_epi32(0x7C00));
+        const __m128i inf = _mm_cmpeq_epi32(e, _mm_set1_epi32(0x7C00));
+        const __m128i rebias = _mm_blendv_epi8(_mm_set1_epi32((int)(112u << 23)), _mm_set1_epi32((int)(224u << 23)), inf);
+        const __m128i mag = _mm_add_epi32(_mm_slli_epi32(_mm_and_si128(h, _mm_set1_epi32(0x7FFF)), 13), rebias);
+        const __m128i zero = _mm_cmpeq_epi32(e, _mm_setzero_si128());
+        r = _mm_or_si128(_mm_slli_epi32(_mm_and_si128(h, _mm_set1_epi32(0x8000)), 16), _mm_andnot_si128(zero, mag));
+        break;
+    }
+    case RSX_VTX_TYPE_UNORM8: {
