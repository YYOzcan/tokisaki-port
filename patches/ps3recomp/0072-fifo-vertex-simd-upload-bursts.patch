+        break;
+    }
+    default: {                    /* RSX_VTX_TYPE_SNORM16 */
+        const __m128i s = _mm_srai_epi32(_mm_shuffle_epi8(_mm_loadl_epi64((const __m128i*)p), d->shuf), 16);
+        r = _mm_castps_si128(_mm_div_ps(_mm_cvtepi32_ps(s), _mm_set1_ps(32767.0f)));
+        break;
+    }
+    }
+    r = _mm_or_si128(_mm_and_si128(r, d->keep), d->tail);
+    _mm_storeu_si128((__m128i*)out, r);
