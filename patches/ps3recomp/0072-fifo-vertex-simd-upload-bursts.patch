+            if (lane == 3)
+                (*load)++;
+        } else {
+            const u32 word = (m - M_VP_UPLOAD_CONST) >> 2;
+            const u32 slot = rsx->regs[M_VP_UPLOAD_CONST_ID >> 2] + (word >> 2);
+            if (slot < RSX_DSP_NUM_CONSTANTS) {
+                rsx->constants[slot][word & 3] = arg;
+                rsx->const_gen++;
+            }
+        }
+    }
+}
