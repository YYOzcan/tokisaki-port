+/* rsx_process_upload_method for one header's run of words into one upload
+ * window (incrementing; `be` big-endian guest words), the FIFO walker's
+ * bursts. TCONST_DBG / SEQ_DBG set: word by word, for their logs. */
+void rsx_process_upload_burst(rsx_state* state, u32 method, const u8* be, u32 count)
+{
+    static int dbg = -1;
+    if (dbg < 0) dbg = getenv("TCONST_DBG") || getenv("SEQ_DBG");
+    for (u32 i = 0; i < count; i++) {
+        u32 data;
+        memcpy(&data, be + (size_t)i * 4u, 4);
+        data = __builtin_bswap32(data);
+        const u32 m = method + i * 4u;
+        if (dbg) { rsx_process_upload_method(state, m, data); continue; }
+        if (m >= NV4097_SET_TRANSFORM_PROGRAM && m < NV4097_SET_TRANSFORM_PROGRAM + 32 * 4) {
+            const u32 w = state->vp_ucode_write;
+            if (w + 4 <= sizeof(state->vp_ucode)) {
+                memcpy(&state->vp_ucode[w], &data, 4);      /* little-endian bytes */
+                state->vp_ucode_write = w + 4;
+                if (w + 4 > state->vp_ucode_bytes) state->vp_ucode_bytes = w + 4;
+                state->vp_dirty = 1;
+            }
+            continue;
+        }
+        if (!(m >= NV4097_SET_TRANSFORM_CONSTANT &&
+              m <  NV4097_SET_TRANSFORM_CONSTANT + NV4097_SET_TRANSFORM_CONSTANT_DWORDS * 4))
+            continue;
+        const u32 reg_offset = (m - NV4097_SET_TRANSFORM_CONSTANT) / 4;
+        const u32 slot = state->transform_constant_load + (reg_offset >> 2);
+        if (slot < RSX_MAX_VERTEX_CONSTANTS) {
+            float f;
+            memcpy(&f, &data, 4);
+            state->vertex_constants[slot][reg_offset & 3] = f;
+            if (!state->vertex_constants_dirty) {
+                state->vertex_constants_lo = slot;
+                state->vertex_constants_hi = slot;
+                state->vertex_constants_dirty = 1;
+            } else {
+                if (slot < state->vertex_constants_lo) state->vertex_constants_lo = slot;
+                if (slot > state->vertex_constants_hi) state->vertex_constants_hi = slot;
+            }
+        }
+    }
