+static void eng_vc_age(void)
+{
+    static u32 last;
+    if (g.frames - last < 32u) return;
+    last = g.frames;
+    for (u32 i = 0; i < ENG_VC_SLOTS; i++) {
+        eng_vc_entry* e = &s_vc[i];
+        if (e->key && (u32)(g.frames - e->last_frame) > ENG_VC_AGE) {
+            if (e->verts) { s_vc_bytes -= (u64)e->n * e->stride; free(e->verts); }
+            memset(e, 0, sizeof *e);
+        }
+    }
+    static int stats = -1;
+    if (stats < 0) stats = getenv("RSX_VTX_CACHE_STATS") ? 1 : 0;
+    static u32 last_print;
+    if (stats && g.frames - last_print >= 600u) {
+        last_print = g.frames;
+        fprintf(stderr, "[vtx-cache] hits %llu, misses %llu, uncacheable %llu, %.1f MB held\n",
+                (unsigned long long)s_vc_hits, (unsigned long long)s_vc_miss,
+                (unsigned long long)s_vc_skip, s_vc_bytes / 1048576.0);
+        s_vc_hits = s_vc_miss = s_vc_skip = 0;
+    }
+}
