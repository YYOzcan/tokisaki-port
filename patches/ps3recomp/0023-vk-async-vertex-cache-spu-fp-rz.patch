+/* 0: not cacheable (an attribute reads outside one contiguous span). */
+static u64 eng_vc_key(const rsx_vertex_fetch_plan* plan, const rsx_vertex_ref* refs, u32 n)
+{
+    struct { u32 type, size, stride, offset, location, freq, mod; float def[4]; } d;
+    struct { const u8* lo; const u8* hi; } span[RSX_DSP_NUM_VERTEX_ATTR];
+    u32 nspan = 0;
+    u64 h = vc_hash(&plan->layout, sizeof plan->layout, plan->base_offset);
+    for (u32 slot = 0; slot < plan->layout.count; slot++) {
+        const u32 attr = plan->layout.attrs[slot];
+        const rsx_vertex_fetch_attr* f = &plan->attr[attr];
+        memset(&d, 0, sizeof d);
+        d.type = f->desc.type; d.size = f->desc.size; d.stride = f->stride;
+        d.offset = f->desc.offset; d.location = f->desc.location;
+        d.freq = f->desc.frequency; d.mod = (plan->divider_mask >> attr) & 1u;
+        memcpy(d.def, f->default_value, sizeof d.def);
+        h = vc_hash(&d, sizeof d, h);
+        if (!f->desc.type || !f->desc.size) continue;
+        if (!f->stable_base) return 0;
+        const u8* lo = f->stable_base;
+        const u8* hi = f->stable_base + (u64)(f->stable_last - f->stable_first) * f->stride + f->elem_size;
+        u32 k = 0;
+        for (; k < nspan; k++)          /* merge overlapping spans (an interleaved array) */
+            if (lo <= span[k].hi && hi >= span[k].lo) {
+                if (lo < span[k].lo) span[k].lo = lo;
+                if (hi > span[k].hi) span[k].hi = hi;
+                break;
+            }
+        if (k == nspan) { span[nspan].lo = lo; span[nspan].hi = hi; nspan++; }
+    }
+    h = vc_hash(refs, (size_t)n * sizeof *refs, h);
+    for (u32 k = 0; k < nspan; k++)
+        h = vc_hash(span[k].lo, (size_t)(span[k].hi - span[k].lo), h);
+    return h ? h : 1;
+}
