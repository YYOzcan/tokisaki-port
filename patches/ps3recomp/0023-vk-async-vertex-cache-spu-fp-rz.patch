+static eng_vc_entry* eng_vc_find(u64 key)
+{
+    eng_vc_entry* victim = NULL;     /* the first empty probe, else the oldest */
+    for (u32 i = 0; i < ENG_VC_PROBE; i++) {
+        eng_vc_entry* e = &s_vc[(key + i) & (ENG_VC_SLOTS - 1u)];
+        if (e->key == key) return e;
+        if (!e->key) { if (!victim || victim->key) victim = e; continue; }
+        if (!victim || (victim->key && (u32)(g.frames - e->last_frame) >
+                                       (u32)(g.frames - victim->last_frame)))
+            victim = e;
+    }
+    if (victim->verts) { s_vc_bytes -= (u64)victim->n * victim->stride; free(victim->verts); }
+    memset(victim, 0, sizeof *victim);
+    victim->key = key;
+    victim->last_frame = g.frames;
+    return victim;
+}
