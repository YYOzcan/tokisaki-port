+/* One element of one attribute outside its stable span: rsx_vertex_fetch_one's
+ * resolver for that attribute. 0 = a fatal ATTR0 failure. */
+static int vtx_fetch_slow(const rsx_vertex_fetch_plan* plan, const rsx_vertex_fetch_attr* fetch,
+                          u32 attr, u32 element, float* value)
+{
+    const u8* source = NULL;
+    if (!plan->inline_data && plan->guest_ptr) {
+        const u32 offset = plan->base_offset + fetch->desc.offset + element * fetch->stride;
+        source = plan->guest_ptr(plan->guest_user, fetch->desc.location, offset, fetch->elem_size);
+    }
+    if (source && vtx_decode(fetch->desc.type, fetch->desc.size, source, value))
+        return 1;
+    if (attr == 0)
+        return 0;
+    memcpy(value, fetch->default_value, 16);
+    return 1;
+}
