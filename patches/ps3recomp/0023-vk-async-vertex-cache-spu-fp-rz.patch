+static inline u64 vc_mix(u64 h) { h ^= h >> 31; h *= 0x9E3779B97F4A7C15ull; h ^= h >> 29; return h; }
+static u64 vc_hash(const void* data, size_t n, u64 seed)
+{
+    const u8* p = (const u8*)data;
+    u64 a = seed ^ 0x243F6A8885A308D3ull, b = seed + 0x13198A2E03707344ull,
+        c = ~seed, d = seed * 0xA4093822299F31D1ull;
+    const u64 K = 0x9FB21C651E98DF25ull;
+    size_t i = 0;
+    for (; i + 32 <= n; i += 32) {
+        u64 w0, w1, w2, w3;
+        memcpy(&w0, p + i, 8); memcpy(&w1, p + i + 8, 8);
+        memcpy(&w2, p + i + 16, 8); memcpy(&w3, p + i + 24, 8);
+        a = (a ^ w0) * K; a ^= a >> 32;
+        b = (b ^ w1) * K; b ^= b >> 32;
+        c = (c ^ w2) * K; c ^= c >> 32;
+        d = (d ^ w3) * K; d ^= d >> 32;
+    }
+    for (; i + 8 <= n; i += 8) { u64 w; memcpy(&w, p + i, 8); a = (a ^ w) * K; a ^= a >> 32; }
+    u64 t = 0;
+    for (; i < n; i++) t = (t << 8) | p[i];
+    return vc_mix(a ^ vc_mix(b + 1) ^ vc_mix(c + 2) ^ vc_mix(d + 3) ^ vc_mix(t ^ n));
+}
