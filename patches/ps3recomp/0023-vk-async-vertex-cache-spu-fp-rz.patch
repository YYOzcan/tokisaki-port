+/* ---- vertex cache ---------------------------------------------------------
+ * Most of a frame's meshes are the same bytes as last frame's: decoding them
+ * into float4 vertices again was a third of the FIFO thread. A draw's key
+ * hashes its layout, every fetched attribute's format, its references and
+ * the guest bytes they read (the merged spans of the attributes' arrays), so
+ * any change to the data is a different key. A key is stored on its second
+ * sighting -- vertices rewritten every frame (skinning) never get there --
+ * and an entry unused for ENG_VC_AGE frames is dropped. RSX_VTX_CACHE=0
+ * turns it off; RSX_VTX_CACHE_STATS=1 prints hits and misses every 600
+ * frames. */
+#define ENG_VC_SLOTS 8192u
+#define ENG_VC_PROBE 8u
+#define ENG_VC_AGE   120u
+#define ENG_VC_MIN   16u           /* smaller draws: hashing costs what decoding does */
+typedef struct { u64 key; u8* verts; u32 n, stride, last_frame, seen; } eng_vc_entry;
