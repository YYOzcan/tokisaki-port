+int rsx_vertex_fetch_all(
+    const rsx_vertex_fetch_plan* plan, const rsx_vertex_ref* refs, u32 count, u8* out)
+{
+    if (!plan || (!refs && count) || (!out && plan->layout.stride && count))
+        return 0;
+    const u32 stride = plan->layout.stride;
+    for (u32 slot = 0; slot < plan->layout.count; slot++) {
+        const u32 attr = plan->layout.attrs[slot];
+        const rsx_vertex_fetch_attr* fetch = &plan->attr[attr];
+        u8* dst = out + slot * 16u;
+        if (!fetch->desc.type || !fetch->desc.size) {
+            for (u32 i = 0; i < count; i++)
+                memcpy(dst + (size_t)i * stride, fetch->default_value, 16);
+            continue;
+        }
+        const u32 freq = fetch->desc.frequency, mod = (plan->divider_mask >> attr) & 1u;
+        const u32 size = fetch->desc.size, first = fetch->stable_first, last = fetch->stable_last;
+        const u8* base = fetch->stable_base;
+        /* the type is constant for the loop: one specialised loop per type */
+#define VTX_LOOP(TYPE)                                                              \
+        for (u32 i = 0; i < count; i++) {                                           \
+            const u32 e = rsx_vertex_element_index(refs[i].vertex_id,               \
+                                                   refs[i].base_index, freq, mod);  \
+            float* v = (float*)(dst + (size_t)i * stride);                          \
+            if (base && e >= first && e <= last) {                                  \
+                if (vtx_decode(TYPE, size, base + (u64)(e - first) * fetch->stride, v)) \
+                    continue;                                                       \
+                if (attr == 0) return 0;                                            \
+                memcpy(v, fetch->default_value, 16);                                \
+                continue;                                                           \
+            }                                                                       \
+            if (!vtx_fetch_slow(plan, fetch, attr, e, v)) return 0;                 \
+        }
+        switch (fetch->desc.type) {
+        case RSX_VTX_TYPE_FLOAT:   VTX_LOOP(RSX_VTX_TYPE_FLOAT)   break;
+        case RSX_VTX_TYPE_HALF:    VTX_LOOP(RSX_VTX_TYPE_HALF)    break;
+        case RSX_VTX_TYPE_UNORM8:  VTX_LOOP(RSX_VTX_TYPE_UNORM8)  break;
+        case RSX_VTX_TYPE_SNORM16: VTX_LOOP(RSX_VTX_TYPE_SNORM16) break;
+        default:                   VTX_LOOP(fetch->desc.type)     break;
+        }
+#undef VTX_LOOP
+    }
+    return 1;
+}
