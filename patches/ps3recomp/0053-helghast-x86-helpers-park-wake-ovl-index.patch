+/* The FIFO walker's wait at an SPU-patched park (after the Killzone 3 port's
+ * patch 1087, undecuple/project-helghast, MIT). A title that ends a stretch
+ * of its command stream at a JUMP to itself, which an SPU job then overwrites
+ * with a small PUT, had its walker see the patch only at its next pass, up to
+ * a whole sleep later -- Killzone 2 parks many times a frame. The walker
+ * publishes the park's IO offset and waits on g_gcm_park_seq; a PUT covering
+ * that word bumps it and wakes the walker. */
+volatile u32 g_gcm_park_io = 0xFFFFFFFFu;
+static u32 g_gcm_park_seq;
+#ifndef _WIN32
+#include <linux/futex.h>
+#include <sys/syscall.h>
+#include <unistd.h>
+#endif
+static void gcm_park_note_put(u32 io, u32 size)
+{
+    __atomic_thread_fence(__ATOMIC_SEQ_CST);           /* the PUT's data before the park read */
+    const u32 pk = __atomic_load_n(&g_gcm_park_io, __ATOMIC_SEQ_CST);
+    if (pk == 0xFFFFFFFFu || pk - io >= size) return;
+    __atomic_add_fetch(&g_gcm_park_seq, 1u, __ATOMIC_SEQ_CST);
+#ifndef _WIN32
+    syscall(SYS_futex, &g_gcm_park_seq, FUTEX_WAKE_PRIVATE, 1, NULL, NULL, 0);
+#endif
+}
+/* Wait until a PUT patches the park word at `io` or `timeout_us` passes.
+ * Returns 1 when the word is no longer a jump to itself. */
+int cellGcm_park_wait(u32 io, unsigned timeout_us)
+{
+    const u32 seq = __atomic_load_n(&g_gcm_park_seq, __ATOMIC_SEQ_CST);
+    __atomic_store_n(&g_gcm_park_io, io, __ATOMIC_SEQ_CST);
+    const u32 ea = gcm_io2ea(io);
+    int patched = 0;
+    if (ea) {
+        const u32 w = __builtin_bswap32(*(volatile u32*)(vm_base + ea));
+        patched = !((w & 0xE0000003u) == 0x20000000u && (w & 0x1FFFFFFCu) == io);
+    }
+    if (!patched) {
+#ifndef _WIN32
+        struct timespec ts = { (time_t)(timeout_us / 1000000u), (long)(timeout_us % 1000000u) * 1000L };
+        syscall(SYS_futex, &g_gcm_park_seq, FUTEX_WAIT_PRIVATE, seq, &ts, NULL, 0);
+#else
+        Sleep((timeout_us + 999u) / 1000u);
+#endif
+        patched = __atomic_load_n(&g_gcm_park_seq, __ATOMIC_SEQ_CST) != seq;
+    }
+    __atomic_store_n(&g_gcm_park_io, 0xFFFFFFFFu, __ATOMIC_SEQ_CST);
+    return patched;
+}
