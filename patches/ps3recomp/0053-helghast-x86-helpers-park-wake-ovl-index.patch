diff --git a/runtime/spu/tests/test_spu_helpers_x86.c b/runtime/spu/tests/test_spu_helpers_x86.c
new file mode 100644
index 00000000..2678f3c0
--- /dev/null
+++ b/runtime/spu/tests/test_spu_helpers_x86.c
@@ -0,0 +1,80 @@
+/* test_spu_helpers_x86.c -- every SSE4.1/AVX2 helper of spu_helpers_x86.h
+ * against the original spu_helpers.h function, bit for bit, on edge values
+ * and 2 million random ones.
+ *   clang -O2 -march=native -I runtime/spu -I runtime -I include \
+ *         runtime/spu/tests/test_spu_helpers_x86.c -o /tmp/t && /tmp/t */
+#define SPU_NO_X86_REDIRECT 1
+#include "spu_context.h"
+#include "spu_helpers.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+static uint64_t s_rng = 0x9E3779B97F4A7C15ull;
+static uint32_t rnd(void) { s_rng ^= s_rng << 13; s_rng ^= s_rng >> 7; s_rng ^= s_rng << 17; return (uint32_t)s_rng; }
+static const uint32_t edge[] = { 0, 1, 2, 3, 0xF, 0x10, 0x1F, 0x20, 0x21, 0x3F, 0x40, 0x7F, 0x80, 0xFF, 0x100,
+    0x7FFF, 0x8000, 0xFFFF, 0x10000, 0x7FFFFFFF, 0x80000000u, 0x80000001u, 0xFFFFFFFFu, 0xFFFFFFFEu,
+    0x80008000u, 0x7FFF7FFFu, 0x00FF00FFu, 0xFF00FF00u, 0xFFFF0000u, 0x0000FFFFu, 0xFFFFFFE0u, 0xFFFFFFC1u };
+static u128 val(void)
+{
+    u128 r;
+    for (int i = 0; i < 4; i++) {
+        const uint32_t k = rnd();
+        r._u32[i] = (k & 3) == 0 ? edge[(k >> 2) % (sizeof edge / sizeof edge[0])] : rnd();
+    }
+    return r;
+}
+static int imm(void)
+{
+    const uint32_t k = rnd();
+    switch (k & 3) {
+    case 0: return (int)((k >> 2) % 1024) - 512;          /* I10 */
+    case 1: return (int)(int16_t)(k >> 8);                 /* 16-bit */
+    case 2: return (int)edge[(k >> 2) % (sizeof edge / sizeof edge[0])];
+    default: return (int)rnd();
+    }
+}
+static int fails;
+static void chk(const char* n, u128 x, u128 y, u128 a, u128 b, int i)
+{
+    if (memcmp(&x, &y, 16) == 0) return;
+    if (fails++ < 20)
+        fprintf(stderr, "FAIL %s a=%08X %08X %08X %08X b=%08X %08X %08X %08X imm=%d: x86 %08X %08X %08X %08X ref %08X %08X %08X %08X\n",
+                n, a._u32[0], a._u32[1], a._u32[2], a._u32[3], b._u32[0], b._u32[1], b._u32[2], b._u32[3], i,
+                x._u32[0], x._u32[1], x._u32[2], x._u32[3], y._u32[0], y._u32[1], y._u32[2], y._u32[3]);
+}
+#define C2(n) chk(#n, spu_##n##_x86(a, b), spu_##n(a, b), a, b, 0)
+#define CI(n) chk(#n, spu_##n##_x86(a, i), spu_##n(a, i), a, b, i)
+#define C1(n) chk(#n, spu_##n##_x86(a), spu_##n(a), a, b, 0)
+int main(void)
+{
+    for (long it = 0; it < 2000000; it++) {
+        const u128 a = val(), b = val();
+        const int i = imm();
+        C2(a); CI(ai); C2(sf); CI(sfi); C2(ceq); CI(ceqi); C2(cgt); CI(cgti); C2(clgt); CI(clgti);
+        CI(andi); CI(ori); CI(xori); C2(cg); C2(bg);
+#if defined(__AVX2__)
+        C2(shl); C2(rot); C2(rotm); C2(rotma); C2(shlh); C2(rothm); C2(rothma);
+#endif
+        C2(ah); CI(ahi); C2(sfh); CI(sfhi); C2(ceqh); CI(ceqhi); C2(cgth); CI(cgthi); C2(clgth); CI(clgthi);
+        { const int i7 = (int)(rnd() % 128) - 64; chk("rotmahi", spu_rotmahi_x86(a, i7), spu_rotmahi(a, i7), a, b, i7); }
+        C2(ceqb); CI(ceqbi); C2(cgtb); CI(cgtbi); C2(clgtb); CI(clgtbi); C2(absdb); C2(avgb); C1(cntb);
+        C1(xsbh); C1(xshw); C1(xswd); C1(fsm); C1(fsmh); C1(fsmb); C1(gb); C1(gbh); C1(gbb); C1(orx);
+        { const int i7 = (int)(rnd() % 128) - 64;
+          chk("cwd", spu_cwd_x86(a, i7), spu_cwd(a, i7), a, b, i7); chk("chd", spu_chd_x86(a, i7), spu_chd(a, i7), a, b, i7);
+          chk("cbd", spu_cbd_x86(a, i7), spu_cbd(a, i7), a, b, i7); chk("cdd", spu_cdd_x86(a, i7), spu_cdd(a, i7), a, b, i7); }
+        C2(cwx); C2(chx); C2(cbx); C2(cdx);
+        C2(fcgt); C2(fceq); C2(fcmgt); C2(fcmeq);
+    }
+#if defined(__AVX2__)
+    /* frest / frsqest: every 32-bit input, four lanes at a time */
+    for (uint64_t v = 0; v < (1ull << 32); v += 4) {
+        u128 a, b = {0};
+        for (int k = 0; k < 4; k++) a._u32[k] = (uint32_t)(v + k);
+        C1(frest); C1(frsqest);
+        if (fails > 20) break;
+    }
+#endif
+    printf("%s: %d failures\n", fails ? "FAILED" : "ok", fails);
+    return fails != 0;
+}
