+/* An index over s_ovl_src (after the Killzone 3 port's patch 1090,
+ * undecuple/project-helghast, MIT): every MFC GET scanned every registered
+ * source, a 16-byte compare per signature source for each GET of 512 bytes or
+ * more. Sources hang in hash chains, in registration order, by their first
+ * signature word or their source EA; a lookup takes the lowest matching index
+ * of the two chains, which is the entry the linear scan found first. Built on
+ * first use and again whenever a source was added since. */
+#define SPU_OVL_HASH 256
+static int16_t s_ovl_sig_head[SPU_OVL_HASH], s_ovl_ea_head[SPU_OVL_HASH], s_ovl_chain[SPU_OVL_SRC_MAX];
+static volatile int s_ovl_idx_built = -1;      /* s_ovl_src_count the index covers */
+static volatile int s_ovl_idx_lock = 0;
+static inline unsigned spu_ovl_h(uint32_t k) { return (k * 2654435761u) >> 24; }
+static void spu_ovl_index_build(void)
+{
+    while (__atomic_exchange_n(&s_ovl_idx_lock, 1, __ATOMIC_ACQUIRE)) { }
+    const int n = s_ovl_src_count;
+    if (s_ovl_idx_built != n) {
+        for (int b = 0; b < SPU_OVL_HASH; b++) s_ovl_sig_head[b] = s_ovl_ea_head[b] = -1;
+        int16_t sig_tail[SPU_OVL_HASH], ea_tail[SPU_OVL_HASH];
+        for (int b = 0; b < SPU_OVL_HASH; b++) sig_tail[b] = ea_tail[b] = -1;
+        for (int i = 0; i < n; i++) {
+            const spu_ovl_src* o = &s_ovl_src[i];
+            uint32_t k; int16_t* head; int16_t* tail;
+            if (o->has_sig) { memcpy(&k, o->sig, 4); head = s_ovl_sig_head; tail = sig_tail; }
+            else { k = o->src_ea; head = s_ovl_ea_head; tail = ea_tail; }
+            const unsigned b = spu_ovl_h(k);
+            s_ovl_chain[i] = -1;
+            if (tail[b] < 0) head[b] = (int16_t)i; else s_ovl_chain[tail[b]] = (int16_t)i;
+            tail[b] = (int16_t)i;
+        }
+        __atomic_store_n(&s_ovl_idx_built, n, __ATOMIC_RELEASE);
+    }
+    __atomic_store_n(&s_ovl_idx_lock, 0, __ATOMIC_RELEASE);
+}
+/* The index of the first source the old scan would have matched, or -1. */
+static int spu_ovl_find(uint32_t ea, const uint8_t* ls, uint32_t size)
+{
+    if (__atomic_load_n(&s_ovl_idx_built, __ATOMIC_ACQUIRE) != s_ovl_src_count) spu_ovl_index_build();
+    int best = -1;
+    if (size >= 512) {
+        uint32_t k; memcpy(&k, ls, 4);
+        for (int i = s_ovl_sig_head[spu_ovl_h(k)]; i >= 0; i = s_ovl_chain[i])
+            if (memcmp(ls, s_ovl_src[i].sig, 16) == 0) { best = i; break; }
+    }
+    for (int i = s_ovl_ea_head[spu_ovl_h(ea)]; i >= 0 && (best < 0 || i < best); i = s_ovl_chain[i])
+        if (s_ovl_src[i].src_ea == ea) { best = i; break; }
+    return best;
+}
