+/* SPURS_MAXCONT="<wid>:<n>[,...]": let a workload run on more SPUs than it
+ * asked for (Killzone 2: jm_post, the SPU post-processing job list, was the
+ * in-level bottleneck at 1). 0 = no override for that workload. */
+static u32 spurs_maxcont_override(u32 wid)
+{
+    static int nov = -1; static u32 ov[16];
+    if (nov < 0) { nov = 0; const char* e = getenv("SPURS_MAXCONT");
+        while (e && *e) { char* q; unsigned w = (unsigned)strtoul(e, &q, 10);
+            if (*q != ':') break; unsigned n = (unsigned)strtoul(q + 1, &q, 10);
+            if (w < 16) { ov[w] = n; nov = 1; } e = (*q == ',') ? q + 1 : q; if (!*q) break; } }
+    return (nov && wid < 16) ? ov[wid] : 0u;
+}
