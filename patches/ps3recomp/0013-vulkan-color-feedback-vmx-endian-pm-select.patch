+SPU__XV_INLINE __m128i spu__xv_zero(__m128i x) { return _mm_cmpeq_epi32(_mm_slli_epi32(x, 1), _mm_setzero_si128()); }
+SPU__XV_INLINE __m128i spu__xv_plain0(__m128i x) { return _mm_or_si128(spu__xv_plain(x), spu__xv_zero(x)); }
+/* truncate four doubles to singles; *ok = lanes whose result is a normal single
+ * (and, with boundary, not on a 24-bit boundary) or an exact zero, which the
+ * SPU returns as +0 */
+SPU__XV_INLINE __m128i spu__xv_trunc(__m256d d, __m128i* ok, int boundary) {
+    const __m256i u = _mm256_castpd_si256(d);
+    const __m256i az = _mm256_cmpeq_epi64(_mm256_slli_epi64(u, 1), _mm256_setzero_si256());
+    const __m256i ex = _mm256_and_si256(_mm256_srli_epi64(u, 52), _mm256_set1_epi64x(0x7FF));
+    __m256i good = _mm256_and_si256(_mm256_cmpgt_epi64(ex, _mm256_set1_epi64x(1023 - 127)),
+                                    _mm256_cmpgt_epi64(_mm256_set1_epi64x(1023 + 128), ex));
+    if (boundary)
+        good = _mm256_andnot_si256(_mm256_cmpeq_epi64(_mm256_and_si256(u, _mm256_set1_epi64x(0x1FFFFFFF)),
+                                                      _mm256_setzero_si256()), good);
+    good = _mm256_or_si256(good, az);
+    *ok = _mm256_castsi256_si128(_mm256_permutevar8x32_epi32(good, _mm256_setr_epi32(0, 2, 4, 6, 1, 3, 5, 7)));
+    /* masked, and the sign cleared where the result is zero */
+    const __m256i m = _mm256_andnot_si256(_mm256_and_si256(az, _mm256_set1_epi64x((long long)0x8000000000000000ull)),
+                                          _mm256_and_si256(u, _mm256_set1_epi64x(~0x1FFFFFFFll)));
+    return _mm_castps_si128(_mm256_cvtpd_ps(_mm256_castsi256_pd(m)));
+}
+static inline __attribute__((noinline, cold)) u128 spu__xv_fix2(__m128i r, __m128i ok, u128 a, u128 b,
+                                                                 uint32_t negb, int mul) {
+    u128 out = spu__xv_st(r), m = spu__xv_st(ok);
+    for (int i = 0; i < 4; i++)
+        if (!m._u32[i]) out._u32[i] = mul ? spu__fm_any(a._u32[i], b._u32[i])
+                                          : spu__fa_any(a._u32[i], b._u32[i] ^ negb);
+    return out;
+}
+static inline __attribute__((noinline, cold)) u128 spu__xv_fix3(__m128i r, __m128i ok, u128 a, u128 b, u128 c,
+                                                                 uint32_t negp, uint32_t negc) {
+    u128 out = spu__xv_st(r), m = spu__xv_st(ok);
+    for (int i = 0; i < 4; i++)
+        if (!m._u32[i]) out._u32[i] = spu__fma_any(a._u32[i], b._u32[i], c._u32[i], negp, negc);
+    return out;
+}
+SPU__XV_INLINE u128 spu__xv_fa(u128 a, u128 b, uint32_t negb) {
+    const __m128i x = spu__xv_ld(a), y = _mm_xor_si128(spu__xv_ld(b), _mm_set1_epi32((int)negb));
+    const __m128i gap = _mm_abs_epi32(_mm_sub_epi32(spu__xv_bexp(x), spu__xv_bexp(y)));
+    /* the exponent-gap limit applies only between two nonzero terms */
+    const __m128i pre = _mm_and_si128(_mm_and_si128(spu__xv_plain0(x), spu__xv_plain0(y)),
+                                      _mm_or_si128(_mm_cmpgt_epi32(_mm_set1_epi32(30), gap),
+                                                   _mm_or_si128(spu__xv_zero(x), spu__xv_zero(y))));
+    const __m256d d = _mm256_add_pd(_mm256_cvtps_pd(_mm_castsi128_ps(x)), _mm256_cvtps_pd(_mm_castsi128_ps(y)));
+    __m128i ok;
+    const __m128i r = spu__xv_trunc(d, &ok, 0);
+    ok = _mm_and_si128(ok, pre);
+    if (_mm_movemask_ps(_mm_castsi128_ps(ok)) == 0xF) return spu__xv_st(r);
+    return spu__xv_fix2(r, ok, a, b, negb, 0);
+}
+SPU__XV_INLINE u128 spu__xv_fm(u128 a, u128 b) {
+    const __m128i x = spu__xv_ld(a), y = spu__xv_ld(b);
+    const __m128i pre = _mm_and_si128(spu__xv_plain0(x), spu__xv_plain0(y));
+    const __m256d d = _mm256_mul_pd(_mm256_cvtps_pd(_mm_castsi128_ps(x)), _mm256_cvtps_pd(_mm_castsi128_ps(y)));
+    __m128i ok;
+    const __m128i r = spu__xv_trunc(d, &ok, 0);
+    ok = _mm_and_si128(ok, pre);
+    if (_mm_movemask_ps(_mm_castsi128_ps(ok)) == 0xF) return spu__xv_st(r);
+    return spu__xv_fix2(r, ok, a, b, 0, 1);
+}
+SPU__XV_INLINE u128 spu__xv_fma(u128 a, u128 b, u128 c, uint32_t negp, uint32_t negc) {
+    const __m128i x = spu__xv_ld(a), y = spu__xv_ld(b), z = spu__xv_ld(c);
+    const __m128i pre = _mm_and_si128(_mm_and_si128(spu__xv_plain0(x), spu__xv_plain0(y)), spu__xv_plain0(z));
+    const __m256d p = _mm256_mul_pd(_mm256_cvtps_pd(_mm_castsi128_ps(_mm_xor_si128(x, _mm_set1_epi32((int)negp)))),
+                                    _mm256_cvtps_pd(_mm_castsi128_ps(y)));          /* exact */
+    const __m256d d = _mm256_add_pd(p, _mm256_cvtps_pd(_mm_castsi128_ps(_mm_xor_si128(z, _mm_set1_epi32((int)negc)))));
+    __m128i ok;
+    const __m128i r = spu__xv_trunc(d, &ok, 1);
+    ok = _mm_and_si128(ok, pre);
+    if (_mm_movemask_ps(_mm_castsi128_ps(ok)) == 0xF) return spu__xv_st(r);
+    return spu__xv_fix3(r, ok, a, b, c, negp, negc);
+}
+SPU__XV_INLINE u128 spu_fa(u128 a, u128 b) { return spu__xv_fa(a, b, 0); }
+SPU__XV_INLINE u128 spu_fs(u128 a, u128 b) { return spu__xv_fa(a, b, 0x80000000u); }
+SPU__XV_INLINE u128 spu_fm(u128 a, u128 b) { return spu__xv_fm(a, b); }
+SPU__XV_INLINE u128 spu_fma(u128 a, u128 b, u128 c)  { return spu__xv_fma(a, b, c, 0, 0); }
+SPU__XV_INLINE u128 spu_fms(u128 a, u128 b, u128 c)  { return spu__xv_fma(a, b, c, 0, 0x80000000u); }
+SPU__XV_INLINE u128 spu_fnms(u128 a, u128 b, u128 c) { return spu__xv_fma(a, b, c, 0x80000000u, 0); }
 #else
 static inline u128 spu_fa(u128 a, u128 b) { return spu__fa_s(a, b); }
 static inline u128 spu_fs(u128 a, u128 b) { return spu__fs_s(a, b); }
