+static void eng_surface_writeback(u32 slot)
+{
+    eng_surface* s = &g.surfaces[slot];
+    u32 bpp = 0, elem = 4;
+    switch (s->fmt) {
+    case RSX_BE_FMT_R8G8B8A8:
+        rsx_draw_engine_guest_read(s->location, s->offset, s->pitch, s->w, s->h);
+        s->guest_dirty = 0;
+        eng_textures_touch(s->location, s->offset, s->pitch * s->h);
+        return;
+    case RSX_BE_FMT_R32F:          bpp = 4;  elem = 4; break;
+    case RSX_BE_FMT_R16G16F:       bpp = 4;  elem = 2; break;
+    case RSX_BE_FMT_R16G16B16A16F: bpp = 8;  elem = 2; break;
+    case RSX_BE_FMT_R32G32B32A32F: bpp = 16; elem = 4; break;
+    default: s->guest_dirty = 0; return;
+    }
+    if (s->pitch < s->w * bpp) { s->guest_dirty = 0; return; }
+    u8* rows = eng_coherence_buffer(s->w * bpp * s->h);
+    if (!rows) return;
+    g.be->submit_and_wait(g.be->user, RSX_BE_FLUSH_GUEST_REFERENCE);
+    g.be->readback(g.be->user, s->handle, 0, 0, s->w, s->h, rows, s->w * bpp);
+    for (u32 r = 0; r < s->h; r++) {
+        u8* dst = (u8*)eng_guest_ptr(NULL, s->location, s->offset + r * s->pitch, s->w * bpp);
+        if (!dst) break;
+        const u8* src = rows + (size_t)r * s->w * bpp;
+        if (elem == 4)
+            for (u32 b = 0; b < s->w * bpp; b += 4) {
+                dst[b] = src[b + 3]; dst[b + 1] = src[b + 2]; dst[b + 2] = src[b + 1]; dst[b + 3] = src[b];
+            }
+        else
+            for (u32 b = 0; b < s->w * bpp; b += 2) { dst[b] = src[b + 1]; dst[b + 1] = src[b]; }
+    }
+    s->guest_dirty = 0;
+    eng_textures_touch(s->location, s->offset, s->pitch * s->h);
+}
