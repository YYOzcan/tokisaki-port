+/* Same-target colour feedback (rsx_draw_backend.color_snapshot): a draw that
+ * samples the target it writes -- Killzone 2's last screen pass distorts the
+ * display buffer it is drawing into -- reads a copy of the target taken now,
+ * which is what the RSX reads from memory. Each call returns a fresh copy
+ * (all submissions are synchronous, so the blit already follows every earlier
+ * write); the engine releases it. It is a COLOR object so surface_view can
+ * give it the unit's crossbar, flagged so releasing it keeps the framebuffers. */
+static u32 vk_eng_color_snapshot(void* user, u32 surface)
+{
+    (void)user;
+    vk_eng_obj* c = vk_eng_get(surface, VK_ENG_COLOR);
+    if (!c) return 0;
+    const u32 snap = vk_eng_alloc();
+    if (!snap) return 0;
+    c = vk_eng_get(surface, VK_ENG_COLOR);
+    vk_eng_obj* t = &s_eobj[snap];
+    if (vk_create_image(&t->im, c->fmt, c->w, c->h,
+                        VK_IMAGE_USAGE_SAMPLED_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT |
+                        VK_IMAGE_USAGE_TRANSFER_SRC_BIT,
+                        VK_IMAGE_ASPECT_COLOR_BIT)) {
+        vk_destroy_image(&t->im); memset(t, 0, sizeof *t); return 0;
+    }
+    t->kind = VK_ENG_COLOR; t->fmt = c->fmt; t->bpp = c->bpp; t->w = c->w; t->h = c->h;
+    t->snapshot = 1;
+    if (vk_begin()) return 0;
+    vk_barrier_image(t->im.img, VK_IMAGE_ASPECT_COLOR_BIT, VK_IMAGE_LAYOUT_UNDEFINED);
+    vk_barrier_image(c->im.img, VK_IMAGE_ASPECT_COLOR_BIT, VK_IMAGE_LAYOUT_GENERAL);
+    VkImageBlit blit = {
+        .srcSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 },
+        .srcOffsets = { { 0, 0, 0 }, { (int32_t)c->w, (int32_t)c->h, 1 } },
+        .dstSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 },
+        .dstOffsets = { { 0, 0, 0 }, { (int32_t)c->w, (int32_t)c->h, 1 } },
+    };
+    pvkCmdBlitImage(s_vk.cmd, c->im.img, VK_IMAGE_LAYOUT_GENERAL,
+                    t->im.img, VK_IMAGE_LAYOUT_GENERAL, 1, &blit, VK_FILTER_NEAREST);
+    if (vk_submit_and_wait()) { vk_eng_release(user, snap); return 0; }
+    return snap;
+}
