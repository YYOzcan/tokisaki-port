+/* SPU_FF_WHY=1: why lanes leave the fast path (diagnostic, cold path only):
+ * an operand that is a denormal (0) or extended-range (1), an fa/fs exponent
+ * gap (2), a result that is zero by underflow (3) or extended (4), else (5). */
+static __attribute__((noinline, cold, unused)) void spu__xv_why(int op, uint32_t x, uint32_t y, uint32_t z, uint32_t res)
+{
+    static int on = -1;
+    if (on < 0) { const char* e = getenv("SPU_FF_WHY"); on = (e && e[0] == '1'); }
+    if (!on) return;
+    static unsigned long long cnt[3][6], total;
+    const uint32_t ops[3] = { x, y, z };
+    int why = 5;
+    for (int k = 0; k < (op == 2 ? 3 : 2) && why == 5; k++) {
+        const uint32_t e = (ops[k] >> 23) & 0xFF, f = ops[k] & 0x7FFFFF;
+        if (e == 0 && f) why = 0; else if (e == 255) why = 1;
+    }
+    if (why == 5 && op == 0 && (x << 1) && (y << 1)) {
+        const int ex = (int)((x >> 23) & 0xFF), ey = (int)((y >> 23) & 0xFF);
+        if (ex - ey >= 30 || ey - ex >= 30) why = 2;
+    }
+    if (why == 5) { const uint32_t er = (res >> 23) & 0xFF; if (er == 0) why = 3; else if (er == 255) why = 4; }
+    { static int shown; if (shown < 24 && __atomic_add_fetch(&shown, 1, __ATOMIC_RELAXED) <= 24)
+        fprintf(stderr, "[ff-why] op %d why %d: %08X %08X %08X -> %08X\n", op, why, x, y, z, res); }
+    __atomic_add_fetch(&cnt[op][why], 1, __ATOMIC_RELAXED);
+    if ((__atomic_add_fetch(&total, 1, __ATOMIC_RELAXED) & 0xFFFFF) == 0) {
+        static const char* nm[3] = { "fa", "fm", "fma" };
+        fprintf(stderr, "[ff-why] %llu lanes:", total);
+        for (int o = 0; o < 3; o++)
+            fprintf(stderr, " %s[den %llu ext %llu gap %llu uflow %llu eout %llu other %llu]", nm[o],
+                    cnt[o][0], cnt[o][1], cnt[o][2], cnt[o][3], cnt[o][4], cnt[o][5]);
+        fprintf(stderr, "\n");
+    }
+}
