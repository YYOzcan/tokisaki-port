-        if (!m._u32[i]) out._u32[i] = spu__fma_any(a._u32[i], b._u32[i], c._u32[i], negp, negc);
+        if (!m._u32[i]) {
+            out._u32[i] = spu__fma_any(a._u32[i], b._u32[i], c._u32[i], negp, negc);
+            spu__xv_why(2, a._u32[i], b._u32[i], c._u32[i], out._u32[i]);
