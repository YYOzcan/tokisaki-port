+/* SPU singles on the way in: a denormal operand is a (signed) zero, and
+ * biased exponent 255 is an ordinary, larger number (no Inf/NaN) -- both
+ * exact in double, so they no longer leave the fast path. In Killzone 2's
+ * post-processing jobs fm with an extended-range constant and fma with
+ * denormal operands were ~500 M lanes a minute through the per-lane path
+ * (SPU_FF_WHY). Results outside the normal range still take it. */
+SPU__XV_INLINE __m128i spu__xv_flush(__m128i x) {
+    const __m128i den = _mm_cmpeq_epi32(_mm_and_si128(x, _mm_set1_epi32(0x7F800000)), _mm_setzero_si128());
+    return _mm_blendv_epi8(x, _mm_and_si128(x, _mm_set1_epi32((int)0x80000000u)), den);
+}
+SPU__XV_INLINE __m256d spu__xv_wide(__m128i x) {          /* x flushed */
+    const __m256i v = _mm256_cvtepu32_epi64(x);
+    const __m256i sign = _mm256_slli_epi64(_mm256_and_si256(v, _mm256_set1_epi64x(0x80000000ll)), 32);
+    const __m256i ex = _mm256_and_si256(_mm256_srli_epi64(v, 23), _mm256_set1_epi64x(0xFF));
+    const __m256i nz = _mm256_cmpgt_epi64(ex, _mm256_setzero_si256());
+    const __m256i mag = _mm256_or_si256(_mm256_slli_epi64(_mm256_add_epi64(ex, _mm256_set1_epi64x(1023 - 127)), 52),
+                                        _mm256_slli_epi64(_mm256_and_si256(v, _mm256_set1_epi64x(0x7FFFFF)), 29));
+    return _mm256_castsi256_pd(_mm256_or_si256(sign, _mm256_and_si256(nz, mag)));
+}
