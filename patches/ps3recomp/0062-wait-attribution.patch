+/* PS3_COND_WHO=1: every 5 s, the conditions waited on longest -- waits, time
+ * waited, the waiting threads, and which thread (and lr) signalled them -- so
+ * a wait can be traced to the thread that ends it. */
+#define COND_WHO_N 64
+static struct { uint64_t waits, wait_us; uint32_t waiter, sig_tid, sig_lr, sigs; } s_who[COND_WHO_N];
+static int cond_who_on(void)
+{
+    static int on = -1;
+    if (on < 0) on = getenv("PS3_COND_WHO") ? 1 : 0;
+    return on;
+}
+static uint64_t cond_now_us(void)
+{
+    struct timespec ts; clock_gettime(CLOCK_MONOTONIC, &ts);
+    return (uint64_t)ts.tv_sec * 1000000u + (uint64_t)ts.tv_nsec / 1000u;
+}
+static void cond_who_report(void)
+{
+    static uint64_t last;
+    const uint64_t now = cond_now_us();
+    if (!last) { last = now; return; }
+    if (now - last < 5000000u) return;
+    last = now;
+    fprintf(stderr, "--- cond waits (last 5 s) ---\n");
+    for (int k = 0; k < 6; k++) {
+        int b = -1;
+        for (int i = 0; i < COND_WHO_N; i++)
+            if (s_who[i].wait_us && (b < 0 || s_who[i].wait_us > s_who[b].wait_us)) b = i;
+        if (b < 0) break;
+        fprintf(stderr, "  cond %2d: %6llu waits %6llu ms (waiter tid %u) signalled %u x, last by tid %u lr=0x%08X\n",
+                b + 1, (unsigned long long)s_who[b].waits, (unsigned long long)(s_who[b].wait_us / 1000),
+                s_who[b].waiter, s_who[b].sigs, s_who[b].sig_tid, s_who[b].sig_lr);
+        s_who[b].wait_us = 0;
+    }
+    memset(s_who, 0, sizeof s_who);
+}
+
 int64_t sys_cond_wait(ppu_context* ctx)
 {
     uint64_t timeout = LV2_ARG_U64(ctx, 1);
+    const int who = cond_who_on();
+    const uint32_t who_id = LV2_ARG_U32(ctx, 0);
+    const uint64_t who_t0 = who ? cond_now_us() : 0;
     /* Preserve upstream's opt-in wait diagnostics across the waiter rewrite. */
-    const char* peek = getenv("PS3_COND_PEEK");
+    static const char* peek = (const char*)-1;
+    if (peek == (const char*)-1) peek = getenv("PS3_COND_PEEK");
     if (peek) {
         uint32_t ea = (uint32_t)strtoul(peek, NULL, 16);
         if (ea) {
@@ -198,6 +240,12 @@ int64_t sys_cond_wait(ppu_context* ctx)
     for (int i = 0; i < depth; ++i) guest_lock(m);
     m->owner_tid = ctx->thread_id;
     m->lock_count = depth;
+    if (who && who_id && who_id <= COND_WHO_N) {
+        s_who[who_id - 1].waits++;
+        s_who[who_id - 1].wait_us += cond_now_us() - who_t0;
+        s_who[who_id - 1].waiter = (uint32_t)ctx->thread_id;
+        cond_who_report();
+    }
     return result;
 }
 
@@ -219,8 +267,16 @@ static int64_t signal_cond(uint32_t id, int all)
     return CELL_OK;
