-int64_t sys_cond_signal(ppu_context* ctx) { return signal_cond(LV2_ARG_U32(ctx, 0), 0); }
-int64_t sys_cond_signal_all(ppu_context* ctx) { return signal_cond(LV2_ARG_U32(ctx, 0), 1); }
+static void cond_who_signal(ppu_context* ctx)
+{
+    const uint32_t id = LV2_ARG_U32(ctx, 0);
+    if (!cond_who_on() || !id || id > COND_WHO_N) return;
+    s_who[id - 1].sigs++;
+    s_who[id - 1].sig_tid = (uint32_t)ctx->thread_id;
+    s_who[id - 1].sig_lr = (uint32_t)ctx->lr;
+}
+int64_t sys_cond_signal(ppu_context* ctx) { cond_who_signal(ctx); return signal_cond(LV2_ARG_U32(ctx, 0), 0); }
+int64_t sys_cond_signal_all(ppu_context* ctx) { cond_who_signal(ctx); return signal_cond(LV2_ARG_U32(ctx, 0), 1); }
 
 /* Preserve upstream's current broadcast fallback for signal_to. */
 int64_t sys_cond_signal_to(ppu_context* ctx) { return signal_cond(LV2_ARG_U32(ctx, 0), 1); }
