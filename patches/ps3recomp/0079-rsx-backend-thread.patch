+
+/* free() for memory a queued call may still point at (the engine's vertex
+ * cache copies, which draw_cached passes by reference): freed once the worker
+ * has gone past everything queued so far. */
+#ifdef BE_THREAD_OK
+static struct { void* p; u64 pos; }* s_dfree;
+static u32 s_dfree_n, s_dfree_cap;
+#endif
+void rsx_be_thread_free(void* p)
+{
+#ifdef BE_THREAD_OK
+    if (s_mode == 1) {
+        const u64 done = __atomic_load_n(&s_head, __ATOMIC_ACQUIRE);
+        u32 k = 0;
+        for (u32 i = 0; i < s_dfree_n; i++) {
+            if (s_dfree[i].pos <= done) free(s_dfree[i].p);
+            else s_dfree[k++] = s_dfree[i];
+        }
+        s_dfree_n = k;
+        if (!p) return;
+        if (s_tail_local <= done) { free(p); return; }
+        if (s_dfree_n == s_dfree_cap) {
+            const u32 nc = s_dfree_cap ? s_dfree_cap * 2u : 256u;
+            void* np = realloc(s_dfree, nc * sizeof *s_dfree);
+            if (!np) { q_sync(); free(p); return; }
+            s_dfree = np; s_dfree_cap = nc;
+        }
+        s_dfree[s_dfree_n].p = p; s_dfree[s_dfree_n].pos = s_tail_local; s_dfree_n++;
+        return;
+    }
+#endif
+    free(p);
+}
+
+/* Wait for the worker: for a caller outside the engine that is about to use
+ * the backend's state itself. */
+void rsx_be_thread_sync(void)
+{
+    SYNC();
+}
+
+const rsx_draw_backend* rsx_be_thread_wrap(const rsx_draw_backend* be)
+{
+    if (!be) return NULL;
+    const char* e = getenv("RSX_BE_THREAD");
+    int mode = e ? atoi(e) : 0;
+#ifndef BE_THREAD_OK
+    if (mode == 1) mode = 2;
+#endif
+    if (mode != 1 && mode != 2) return be;
+    s_stats = getenv("RSX_BE_THREAD_STATS") != NULL;
+    s_in = be;
+    s_proxy = *be;                     /* the plain fields (readback_ordered) as they are */
+    s_proxy.user = NULL;
+#define P(f) if (be->f) s_proxy.f = p_##f
+    P(init); P(shutdown); P(submit_and_wait); P(texture_create); P(texture_upload); P(texture_release);
+    P(color_target_create); P(color_target_release); P(color_target_write); P(surface_view);
+    P(depth_target_create); P(depth_target_release); P(depth_snapshot); P(pipeline_create);
+    P(pipeline_release); P(bind_targets); P(bind_pipeline); P(bind_vs_constants); P(bind_ps_constants);
+    P(bind_textures); P(bind_vertex_textures); P(set_viewport); P(set_scissor); P(set_stencil_ref);
+    P(set_depth_bounds); P(draw); P(clear_color); P(clear_depth_stencil); P(present); P(readback);
+    P(depth_readback); P(color_snapshot); P(reinterpret); P(draw_cached); P(readback_async);
+    P(readback_result); P(readback_release); P(bind_vs_constants_ref);
+#undef P
+#ifdef BE_THREAD_OK
+    if (mode == 1) {
+        s_q = (u8*)aligned_alloc(64, Q_BYTES);
+        pthread_t t;
+        if (!s_q || pthread_create(&t, NULL, be_worker, NULL)) {
+            fprintf(stderr, "[be-thread] no worker; calls stay on the engine's thread\n");
+            free(s_q); s_q = NULL;
+            mode = 2;
+        } else {
+            pthread_detach(t);
+        }
+    }
+#endif
+    s_mode = mode;
+    fprintf(stderr, "[be-thread] backend calls %s\n", mode == 1 ? "on a worker thread" : "direct, counted");
+    return &s_proxy;
+}
