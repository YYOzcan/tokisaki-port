+#ifdef BE_THREAD_OK
+/* What s_vsc_buf will hold once the worker has caught up: a bind sends only
+ * the 64-byte pieces of the block that differ from it (the engine binds the
+ * whole register-file prefix before every draw, a few constants changed). */
+static u8 s_vsc_shadow[sizeof s_vsc_buf];
+static int p_vsc_delta(const u8* c, u32 prefix, const void* tail, u32 tail_bytes, u32 total)
+{
+    u32 runs[2 * 256], n = 0, bytes = 0;
+    for (u32 off = 0; off < prefix; ) {
+        const u32 len = prefix - off < 64u ? prefix - off : 64u;
+        if (memcmp(c + off, s_vsc_shadow + off, len)) {
+            if (n && runs[2 * (n - 1)] + runs[2 * (n - 1) + 1] == off) runs[2 * (n - 1) + 1] += len;
+            else { if (n == 256) return 0; runs[2 * n] = off; runs[2 * n + 1] = len; n++; }
+            bytes += len;
+        }
+        off += len;
+    }
+    if (bytes > prefix / 2u) return 0;                     /* most of it: the whole block */
+    e_vsc_delta* e = ENTRY(e_vsc_delta, OP_VSC_DELTA, n * 8u + bytes);
+    e->prefix = prefix; e->tail_bytes = tail_bytes; e->total = total; e->n_runs = n;
+    memcpy(e->tail, tail, tail_bytes);
+    u8* p = PAYLOAD(e);
+    for (u32 r = 0; r < n; r++) {
+        const u32 off = runs[2 * r], len = runs[2 * r + 1];
+        memcpy(p, &off, 4); memcpy(p + 4, &len, 4); p += 8;
+        memcpy(p, c + off, len); memcpy(s_vsc_shadow + off, c + off, len); p += len;
+    }
+    q_publish();
+    return 1;
+}
+#endif
+static void p_bind_vs_constants_ref(void* u, const void* consts, u32 prefix, const void* tail, u32 tail_bytes, u32 total)
+{
+    (void)u; be_count(OP_BIND_VSC_REF);
+    if (QUEUED && consts && tail && prefix <= sizeof s_vsc_buf && tail_bytes <= 64u) {
+#ifdef BE_THREAD_OK
+        if (p_vsc_delta((const u8*)consts, prefix, tail, tail_bytes, total)) return;
+        memcpy(s_vsc_shadow, consts, prefix);
+        e_vsc_ref* e = ENTRY(e_vsc_ref, OP_BIND_VSC_REF, prefix);
+        e->prefix = prefix; e->tail_bytes = tail_bytes; e->total = total;
+        memcpy(e->tail, tail, tail_bytes);
+        memcpy(PAYLOAD(e), consts, prefix);
+        q_publish();
+        return;
+#endif
+    }
+    SYNC(); s_in->bind_vs_constants_ref(s_in->user, consts, prefix, tail, tail_bytes, total);
+}
