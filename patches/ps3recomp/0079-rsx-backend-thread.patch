+    const size_t ib = indices ? (size_t)index_count * 4u : 0;
+    e_draw* e = ENTRY(e_draw, op, vb + ib);
+    e->topology = (u32)topology; e->vertex_count = vertices ? vertex_count : 0; e->stride = stride;
+    e->index_count = index_count; e->has_indices = indices != NULL; e->key = key;
+    if (vertices) memcpy(PAYLOAD(e), vertices, (size_t)vertex_count * stride);
+    if (ib) memcpy(PAYLOAD(e) + vb, indices, ib);
+    q_publish_draw();
+#else
+    (void)op; (void)topology; (void)key; (void)vertices; (void)vertex_count; (void)stride; (void)indices; (void)index_count;
+#endif
+}
+static void p_draw(void* u, rsx_topology topology, const void* vertices, u32 vertex_count, u32 stride,
