+        const size_t ib = indices ? (size_t)index_count * 4u : 0;
+        e_draw_ref* e = ENTRY(e_draw_ref, OP_DRAW_CACHED_REF, ib);
+        e->topology = (u32)topology; e->vertex_count = vertex_count; e->stride = stride;
+        e->index_count = index_count; e->has_indices = indices != NULL; e->key = key; e->vertices = vertices;
+        if (ib) memcpy(PAYLOAD(e), indices, ib);
+        q_publish_draw();
+        return;
+    }
+#endif
+    if (QUEUED && vertices && (size_t)vertex_count * stride + (size_t)index_count * 4u <= Q_MAX_ENTRY) { p_draw_any(OP_DRAW_CACHED, topology, key, vertices, vertex_count, stride, indices, index_count); return; }
+    SYNC(); s_in->draw_cached(s_in->user, topology, key, vertices, vertex_count, stride, indices, index_count);
