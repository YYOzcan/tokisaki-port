     return patched;
 }
 
+/* Label-release wake (after the Killzone 2 port's patch 6019, undecuple/
+ * project-pyrrhus, MIT): every label the FIFO releases bumps g_gcm_label_seq
+ * (rsx_draw_engine_label_release) and wakes the host threads waiting for one,
+ * only when there are any. A guest poll such as Killzone 2's Renderer::
+ * WaitLabel, `while (label < value) sys_timer_usleep(30)`, sleeps until the
+ * next release instead (tools/postlift_fixups.py, src/kz2_hle.cpp). */
+static u32 g_gcm_label_seq, g_gcm_label_waiters;
+void cellGcm_label_notify(void)
+{
+    __atomic_add_fetch(&g_gcm_label_seq, 1u, __ATOMIC_SEQ_CST);
+#ifndef _WIN32
+    if (__atomic_load_n(&g_gcm_label_waiters, __ATOMIC_SEQ_CST))
+        syscall(SYS_futex, &g_gcm_label_seq, FUTEX_WAKE_PRIVATE, 0x7FFFFFFF, NULL, NULL, 0);
+#endif
+}
+u32 cellGcm_label_seq(void) { return __atomic_load_n(&g_gcm_label_seq, __ATOMIC_SEQ_CST); }
+/* Sleep until a label is released after `seq` was read, or `timeout_us`. */
+void cellGcm_label_wait_seq(u32 seq, unsigned timeout_us)
+{
+    __atomic_add_fetch(&g_gcm_label_waiters, 1u, __ATOMIC_SEQ_CST);
+#ifndef _WIN32
+    if (__atomic_load_n(&g_gcm_label_seq, __ATOMIC_SEQ_CST) == seq) {
+        struct timespec ts = { (time_t)(timeout_us / 1000000u), (long)(timeout_us % 1000000u) * 1000L };
+        syscall(SYS_futex, &g_gcm_label_seq, FUTEX_WAIT_PRIVATE, seq, &ts, NULL, 0);
+    }
+#else
+    if (__atomic_load_n(&g_gcm_label_seq, __ATOMIC_SEQ_CST) == seq) Sleep(1);
+#endif
+    __atomic_sub_fetch(&g_gcm_label_waiters, 1u, __ATOMIC_SEQ_CST);
+}
+
 void gcm_note_spu_put(u32 ea, u32 size)
 {
     if (!size || size > 0x40000u) return;
