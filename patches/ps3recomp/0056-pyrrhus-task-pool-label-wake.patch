diff --git a/runtime/spu/spu_async_pool.h b/runtime/spu/spu_async_pool.h
new file mode 100644
index 00000000..87a4c4ae
--- /dev/null
+++ b/runtime/spu/spu_async_pool.h
@@ -0,0 +1,121 @@
+/* spu_async_pool.h -- asynchronous SPU tasks on reusable host threads (POSIX).
+ *
+ * spu_workload_dispatch_async started every SPURS task on a new detached
+ * thread with a 256 MB stack. Killzone 2 starts about 150 tasks a second in a
+ * level (the Killzone 2 port, Project Pyrrhus, measured it for its patch 6031,
+ * undecuple/project-pyrrhus, MIT; this is written for this runtime from that
+ * description): glibc does not cache stacks that large, so each task paid an
+ * mmap, a clone, the stack's first page faults and a munmap.
+ *
+ * spu_pool_submit hands the job to a parked thread when there is one, else
+ * starts a new one. It never queues: a task may wait for another task, so
+ * every task must start at once, as before. A thread that finishes its job
+ * runs the `after` hook, parks, and ends once it has been idle for
+ * idle_ms. Header-only (static), so a host test can build it alone
+ * (tests/test_spu_async_pool.c). */
+#ifndef SPU_ASYNC_POOL_H
+#define SPU_ASYNC_POOL_H
+#include <errno.h>
+#include <pthread.h>
+#include <stdlib.h>
+#include <time.h>
+
+typedef void (*spu_pool_fn)(void*);
+typedef struct spu_pool_thr {
+    pthread_mutex_t m;
+    pthread_cond_t  c;
+    spu_pool_fn     fn;           /* the job handed over (NULL: none yet) */
+    void*           arg;
+    struct spu_pool_thr* next;    /* the idle list */
+} spu_pool_thr;
+
+static pthread_mutex_t s_pool_lk = PTHREAD_MUTEX_INITIALIZER;
+static spu_pool_thr*   s_pool_idle;
+static unsigned        s_pool_idle_ms = 10000;
+static void          (*s_pool_after)(void);       /* run on the pool thread after each job */
+static volatile unsigned s_pool_threads, s_pool_reused;   /* started / handed to a parked one */
+
+static int spu_pool_unidle(spu_pool_thr* t)       /* s_pool_lk held */
+{
+    for (spu_pool_thr** p = &s_pool_idle; *p; p = &(*p)->next)
+        if (*p == t) { *p = t->next; return 1; }
+    return 0;
+}
+
+static void* spu_pool_main(void* a)
+{
+    spu_pool_thr* t = (spu_pool_thr*)a;
+    for (;;) {
+        pthread_mutex_lock(&t->m);
+        while (!t->fn) {
+            struct timespec ts;
+            clock_gettime(CLOCK_REALTIME, &ts);
+            ts.tv_sec += s_pool_idle_ms / 1000u;
+            ts.tv_nsec += (long)(s_pool_idle_ms % 1000u) * 1000000L;
+            if (ts.tv_nsec >= 1000000000L) { ts.tv_sec++; ts.tv_nsec -= 1000000000L; }
+            if (pthread_cond_timedwait(&t->c, &t->m, &ts) == ETIMEDOUT && !t->fn) {
+                pthread_mutex_unlock(&t->m);
+                pthread_mutex_lock(&s_pool_lk);
+                const int was_idle = spu_pool_unidle(t);
+                pthread_mutex_unlock(&s_pool_lk);
+                if (was_idle) {
+                    pthread_cond_destroy(&t->c);
+                    pthread_mutex_destroy(&t->m);
+                    free(t);
+                    return NULL;
+                }
+                pthread_mutex_lock(&t->m);    /* a submitter took it: its job is on the way */
+            }
+        }
+        const spu_pool_fn fn = t->fn;
+        void* arg = t->arg;
+        t->fn = NULL;
+        pthread_mutex_unlock(&t->m);
+        fn(arg);
+        if (s_pool_after) s_pool_after();
+        pthread_mutex_lock(&s_pool_lk);
+        t->next = s_pool_idle;
+        s_pool_idle = t;
+        pthread_mutex_unlock(&s_pool_lk);
+    }
+}
+
+/* Run fn(arg) on a pool thread now. `stack` is the stack size a new thread
+ * asks for (the default when that is refused). Returns 0 when no thread could
+ * be started. */
+static int spu_pool_submit(spu_pool_fn fn, void* arg, size_t stack)
+{
+    pthread_mutex_lock(&s_pool_lk);
+    spu_pool_thr* t = s_pool_idle;
+    if (t) s_pool_idle = t->next;
+    pthread_mutex_unlock(&s_pool_lk);
+    if (t) {
+        pthread_mutex_lock(&t->m);
+        t->fn = fn; t->arg = arg;
+        pthread_cond_signal(&t->c);
+        pthread_mutex_unlock(&t->m);
+        __atomic_add_fetch(&s_pool_reused, 1u, __ATOMIC_RELAXED);
+        return 1;
+    }
+    t = (spu_pool_thr*)calloc(1, sizeof *t);
+    if (!t) return 0;
+    pthread_mutex_init(&t->m, NULL);
+    pthread_cond_init(&t->c, NULL);
+    t->fn = fn; t->arg = arg;
+    pthread_t th;
+    pthread_attr_t attr;
+    pthread_attr_init(&attr);
+    int rc = EINVAL;
+    if (stack && pthread_attr_setstacksize(&attr, stack) == 0)
+        rc = pthread_create(&th, &attr, spu_pool_main, t);
+    pthread_attr_destroy(&attr);
+    if (rc != 0) rc = pthread_create(&th, NULL, spu_pool_main, t);
+    if (rc != 0) {
+        pthread_cond_destroy(&t->c); pthread_mutex_destroy(&t->m); free(t);
+        return 0;
+    }
+    pthread_detach(th);
+    __atomic_add_fetch(&s_pool_threads, 1u, __ATOMIC_RELAXED);
+    return 1;
+}
+#endif /* SPU_ASYNC_POOL_H */
