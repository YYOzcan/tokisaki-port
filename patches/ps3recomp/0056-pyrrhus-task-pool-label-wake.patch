+#include "spu_async_pool.h"
+static void spu_async_pool_job(void* p) { spu_async_run((spu_async_job*)p); }
+/* After a job on a pool thread: nothing on its stack may stay in the
+ * lock-line reserver set, as the Windows thread does when it ends -- the next
+ * job runs on the same stack. */
+static void spu_async_pool_after(void)
+{
+    pthread_attr_t a;
+    void* lo = NULL; size_t sz = 0;
+    if (pthread_getattr_np(pthread_self(), &a) != 0) return;
+    if (pthread_attr_getstack(&a, &lo, &sz) == 0 && lo && sz) {
+        extern void spu_coh_forget_range(uintptr_t, uintptr_t);
+        spu_coh_forget_range((uintptr_t)lo, (uintptr_t)lo + sz);
+        spu_mfc_forget_range((uintptr_t)lo, (uintptr_t)lo + sz);
+    }
+    pthread_attr_destroy(&a);
+}
 #endif
 
 int spu_workload_dispatch_job(const uint8_t* image, uint32_t image_size,
@@ -1417,6 +1437,22 @@ int spu_workload_dispatch_async(const uint8_t* image, uint32_t image_size,
      * mmap'd and committed on touch, so this reserves address space rather
      * than memory. The default is 512 KB on Darwin, half the 1 MB that blew
      * the guard page above. */
+    /* SPU_ASYNC_POOL=0: a new thread per task, as before; otherwise a pool
+     * thread (spu_async_pool.h; SPU_ASYNC_POOL_IDLE_MS, default 10000, is how
+     * long a parked one waits for the next task before it ends). */
+    static int pool = -1;
+    if (pool < 0) {
+        const char* e = getenv("SPU_ASYNC_POOL");
+        pool = !(e && e[0] == '0');
+        const char* ms = getenv("SPU_ASYNC_POOL_IDLE_MS");
+        if (ms && atoi(ms) > 0) s_pool_idle_ms = (unsigned)atoi(ms);
+        s_pool_after = spu_async_pool_after;
+    }
+    if (pool) {
+        if (spu_pool_submit(spu_async_pool_job, j, 256u << 20)) return 1;
+        free(j);
+        return 0;
+    }
     pthread_t th;
     pthread_attr_t attr;
     pthread_attr_init(&attr);
diff --git a/runtime/spu/tests/test_spu_async_pool.c b/runtime/spu/tests/test_spu_async_pool.c
new file mode 100644
index 00000000..df12506a
--- /dev/null
+++ b/runtime/spu/tests/test_spu_async_pool.c
@@ -0,0 +1,50 @@
+/* Host test for spu_async_pool.h: jobs run on reused threads, jobs that wait
+ * for each other all run at once (the pool never queues), and an idle thread
+ * ends after idle_ms.
+ *   cc -O2 -pthread -o /tmp/tp test_spu_async_pool.c && /tmp/tp */
+#include "../spu_async_pool.h"
+#include <stdio.h>
+#include <unistd.h>
+
+static volatile int s_done, s_arrived;
+static pthread_t s_tid[64];
+static void job_note(void* p) { s_tid[(long)p] = pthread_self(); __atomic_add_fetch(&s_done, 1, __ATOMIC_SEQ_CST); }
+/* 16 jobs that each wait until all 16 have started */
+static void job_barrier(void* p)
+{
+    (void)p;
+    __atomic_add_fetch(&s_arrived, 1, __ATOMIC_SEQ_CST);
+    for (int i = 0; i < 4000 && __atomic_load_n(&s_arrived, __ATOMIC_SEQ_CST) < 16; i++) usleep(1000);
+    __atomic_add_fetch(&s_done, 1, __ATOMIC_SEQ_CST);
+}
+static int wait_done(int n)
+{
+    for (int i = 0; i < 5000 && __atomic_load_n(&s_done, __ATOMIC_SEQ_CST) < n; i++) usleep(1000);
+    return __atomic_load_n(&s_done, __ATOMIC_SEQ_CST) == n;
+}
+
+int main(void)
+{
+    int fail = 0;
+    s_pool_idle_ms = 300;
+    /* 1. sequential jobs reuse one thread */
+    for (long k = 0; k < 8; k++) {
+        if (!spu_pool_submit(job_note, (void*)k, 1u << 20)) { puts("FAIL submit"); return 1; }
+        if (!wait_done((int)k + 1)) { puts("FAIL job did not run"); return 1; }
+        usleep(2000);                         /* let it park */
+    }
+    for (int k = 1; k < 8; k++) if (!pthread_equal(s_tid[k], s_tid[0])) { puts("FAIL not reused"); fail = 1; break; }
+    if (s_pool_threads != 1) { printf("FAIL %u threads for sequential jobs\n", s_pool_threads); fail = 1; }
+    /* 2. 16 mutually waiting jobs all start */
+    s_done = 0;
+    for (int k = 0; k < 16; k++) spu_pool_submit(job_barrier, NULL, 1u << 20);
+    if (!wait_done(16) || s_arrived != 16) { printf("FAIL barrier: %d arrived\n", s_arrived); fail = 1; }
+    /* 3. idle threads end */
+    usleep(1500 * 1000);
+    pthread_mutex_lock(&s_pool_lk);
+    int idle = 0; for (spu_pool_thr* t = s_pool_idle; t; t = t->next) idle++;
+    pthread_mutex_unlock(&s_pool_lk);
+    if (idle) { printf("FAIL %d idle threads left after idle_ms\n", idle); fail = 1; }
+    printf("%s: %u threads started, %u jobs handed to parked threads\n", fail ? "FAIL" : "ok", s_pool_threads, s_pool_reused);
+    return fail;
+}
