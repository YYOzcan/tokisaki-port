+                             bf == 0x83 || bf == 0x84 || bf == 0x97 || bf == 0x90);
+        int unit = 0;                 /* bytes per swapped component */
+        if (!special) {
+            switch (tl->fmt) {
+            case RSX_TEXFMT_R16: case RSX_TEXFMT_R16G16: case RSX_TEXFMT_R16G16F:
+            case RSX_TEXFMT_R16G16B16A16F: unit = 2; break;
+            case RSX_TEXFMT_R32F: case RSX_TEXFMT_R32G32B32A32F: unit = 4; break;
+            default: break;
