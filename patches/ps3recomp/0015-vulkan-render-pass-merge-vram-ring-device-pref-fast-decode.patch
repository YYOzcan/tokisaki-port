+                    memcpy(drow, s, n);
+                } else if (bf == 0x85) {          /* A,R,G,B -> R,G,B,A */
+                    for (size_t i = 0; i < n; i += 4) {
+                        uint32_t v; memcpy(&v, s + i, 4);
+                        v = (v >> 8) | (v << 24);
+                        memcpy(drow + i, &v, 4);
+                    }
+                } else if (unit == 2) {
+                    for (size_t i = 0; i < n; i += 2) {
+                        uint16_t v; memcpy(&v, s + i, 2);
+                        v = (uint16_t)((v >> 8) | (v << 8));
+                        memcpy(drow + i, &v, 2);
+                    }
+                } else {
+                    for (size_t i = 0; i < n; i += 4) {
+                        uint32_t v; memcpy(&v, s + i, 4);
+                        v = __builtin_bswap32(v);
+                        memcpy(drow + i, &v, 4);
+                    }
+                }
+            }
+            return;
+        }
