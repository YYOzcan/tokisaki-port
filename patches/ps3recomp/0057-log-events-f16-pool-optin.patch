diff --git a/libs/video/rsx_vertex_compact.c b/libs/video/rsx_vertex_compact.c
index 4a4dc51f..e21cf6f4 100644
--- a/libs/video/rsx_vertex_compact.c
+++ b/libs/video/rsx_vertex_compact.c
@@ -15,19 +15,18 @@ static float rsx_compact_be_f32(const u8* p)
     return f;
 }
 
-static float rsx_compact_be_f16(const u8* p)
+/* Big-endian half to float, without branches (after Killzone 3 port patch
+ * 2074, Project Helghast by undecuple, MIT): exponents 1-30 give
+ * (h & 0x7FFF) << 13 plus a rebias of 112 << 23, exponent 31 (Inf/NaN) the
+ * rebias 224 << 23, exponent 0 (zero and denormals) the sign alone, as the
+ * branching form did -- the same bits for all 65,536 inputs
+ * (tests/test_vtx_f16.c). The selects compile to cmov. */
+static inline float rsx_compact_be_f16(const u8* p)
 {
-    const u16 h = (u16)((p[0] << 8) | p[1]);
-    const u32 sign = (u32)(h >> 15) << 31;
-    const u32 exp = (h >> 10) & 0x1F;
-    const u32 man = h & 0x3FF;
-    u32 out;
-    if (exp == 0)
-        out = sign;
-    else if (exp == 31)
-        out = sign | 0x7F800000u | (man << 13);
-    else
-        out = sign | ((exp + 112) << 23) | (man << 13);
+    const u32 h = ((u32)p[0] << 8) | p[1];
+    const u32 e = h & 0x7C00u;
+    const u32 mag = ((h & 0x7FFFu) << 13) + (e == 0x7C00u ? (224u << 23) : (112u << 23));
+    const u32 out = ((h & 0x8000u) << 16) | (e ? mag : 0u);
     float f;
     memcpy(&f, &out, sizeof(f));
     return f;
diff --git a/libs/video/tests/test_vtx_f16.c b/libs/video/tests/test_vtx_f16.c
new file mode 100644
index 00000000..2dbf84dc
--- /dev/null
+++ b/libs/video/tests/test_vtx_f16.c
@@ -0,0 +1,26 @@
+/* Host test: the branch-free big-endian half decode of rsx_vertex_compact.c
+ * gives the same bits as the branching one for all 65,536 inputs.
+ *   cc -O2 -o /tmp/tf test_vtx_f16.c && /tmp/tf */
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+static uint32_t ref(uint32_t h)          /* the decode before: zero/denormal flush, Inf/NaN, normal */
+{
+    const uint32_t sign = (h >> 15) << 31, exp = (h >> 10) & 0x1F, man = h & 0x3FF;
+    if (exp == 0) return sign;
+    if (exp == 31) return sign | 0x7F800000u | (man << 13);
+    return sign | ((exp + 112) << 23) | (man << 13);
+}
+static uint32_t nb(uint32_t h)           /* rsx_compact_be_f16 now */
+{
+    const uint32_t e = h & 0x7C00u;
+    const uint32_t mag = ((h & 0x7FFFu) << 13) + (e == 0x7C00u ? (224u << 23) : (112u << 23));
+    return ((h & 0x8000u) << 16) | (e ? mag : 0u);
+}
+int main(void)
+{
+    unsigned bad = 0;
+    for (uint32_t h = 0; h < 65536u; h++) if (ref(h) != nb(h)) { if (!bad) printf("first diff h=%04X %08X %08X\n", h, ref(h), nb(h)); bad++; }
+    printf("%s: %u of 65536 differ\n", bad ? "FAIL" : "ok", bad);
+    return bad != 0;
+}
diff --git a/runtime/ps3_log.h b/runtime/ps3_log.h
index 4b7df8c5..d1f22262 100644
--- a/runtime/ps3_log.h
+++ b/runtime/ps3_log.h
@@ -45,4 +45,27 @@ static __inline int ps3_log_verbose(void)
     return v;
 }
 
+
+/* ps3_log_event(&counter, what): for the lines a title prints once per event
+ * (Killzone 2 creates and runs ~150 SPURS tasks a second, ~4,000 lines a
+ * second in a level -- each stderr line a write(2) under the FILE lock).
+ * PS3_LOG_EVENTS=0: the first 8 of each kind, then one "[log] <what>: N so far"
+ * line at every power of two; unset or 1: every line, as before. After the
+ * Killzone 2 port's patch 6030 (Project Pyrrhus by undecuple, MIT), which
+ * found that the quieter log changed the title's timing (an SPU assert race
+ * it then hit), so the default stays every line. */
+#ifdef __cplusplus
+static inline int ps3_log_event(volatile unsigned* counter, const char* what)
+#else
+static __inline int ps3_log_event(volatile unsigned* counter, const char* what)
+#endif
+{
+    static int all = -1;
+    if (all < 0) { const char* e = getenv("PS3_LOG_EVENTS"); all = !(e && e[0] == '0'); }
+    if (all) return 1;
+    const unsigned k = __atomic_add_fetch(counter, 1u, __ATOMIC_RELAXED);
+    if (k <= 8u) return 1;
+    if ((k & (k - 1u)) == 0u) fprintf(stderr, "[log] %s: %u so far\n", what, k);
+    return 0;
+}
 #endif /* PS3_LOG_H */
