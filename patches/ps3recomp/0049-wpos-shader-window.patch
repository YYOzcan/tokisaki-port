+/* Does the program read WPOS (an input-type source while OPDEST's input
+ * select is 0)? Only those programs depend on SET_SHADER_WINDOW. */
+int rsx_fp_reads_wpos(const u8* ucode, u32 max_bytes)
+{
+    if (!ucode) return 0;
+    for (u32 off = 0; off + 16 <= max_bytes;) {
+        const u32 w0 = rsx_fp_read_word(ucode + off);
+        const u32 w1 = rsx_fp_read_word(ucode + off + 4);
+        const u32 w2 = rsx_fp_read_word(ucode + off + 8);
+        const u32 w3 = rsx_fp_read_word(ucode + off + 12);
+        if (!(w2 & FP_BRANCH) && ((w0 & FP_INPUT_SRC_MASK) >> FP_INPUT_SRC_SHIFT) == 0 &&
+            ((w1 & 3u) == 1 || (w2 & 3u) == 1 || (w3 & 3u) == 1))
+            return 1;
+        off += 16;
+        if (!(w2 & FP_BRANCH) && ((w1 & 3u) == 2 || (w2 & 3u) == 2 || (w3 & 3u) == 2))
+            off += 16;
+        if (w0 & FP_END) break;
+    }
+    return 0;
+}
+
+/* WPOS in the RSX window convention (SET_SHADER_WINDOW, 0x1D88: height in
+ * bits 0-11, origin in 12-15, 1 = bottom). The host's SV_Position counts rows
+ * from the top of the target, which is also the guest's row order; with the
+ * origin at the bottom the guest's y is height - y (RPCS3 get_wpos). Killzone
+ * 2's soft particles turn WPOS back into a texel row of the depth they fade
+ * against (y' = 360 - y): read with the host's y they sampled the mirrored
+ * row -- smoke as hard white and black blotches wherever the mirrored depth
+ * was far from the particle. Returns 0 when nothing needed changing. */
+int rsx_fp_apply_wpos(char* hlsl, u32 capacity, u32 shader_window)
+{
+    if (!hlsl) return 0;
+    if (((shader_window >> 12) & 15u) != 1u) return 0;          /* origin top */
+    const u32 height = shader_window & 0xFFFu;
+    static const char head[] = "PSOutput main(PSInput input) {\n";
+    char* at = strstr(hlsl, head);
+    if (!at || !strstr(hlsl, "input.position")) return 0;
+    /* Every read of input.position becomes _rsx_wpos (5 characters shorter). */
+    char decl[160];
+    snprintf(decl, sizeof decl,
+             "    float4 _rsx_wpos = float4(input.position.x, %u.0 - input.position.y, input.position.zw);\n",
+             height);
+    u32 used = (u32)strlen(hlsl);
+    for (char* p = strstr(at + sizeof head - 1, "input.position"); p; p = strstr(p, "input.position")) {
+        if (used + 2 > capacity) return -1;
+        memmove(p + 9, p + 14, used - (u32)(p + 14 - hlsl) + 1);   /* "input.position" -> "_rsx_wpos" */
+        memcpy(p, "_rsx_wpos", 9);
+        used -= 5;
+        p += 9;
+    }
+    const u32 dl = (u32)strlen(decl);
+    if (used + dl + 1 > capacity) return -1;
+    char* ins = at + sizeof head - 1;
+    memmove(ins + dl, ins, used - (u32)(ins - hlsl) + 1);
+    memcpy(ins, decl, dl);
+    return 1;
+}
