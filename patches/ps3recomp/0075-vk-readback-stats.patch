+/* PS3RECOMP_VK_READBACK_STATS=1 (default off): every 5 s, the waiting
+ * readbacks by kind and size -- how many, their bytes, and the time each
+ * spent from its submit to the copy landing in host memory. */
+static void vk_rb_stat(int depth, u32 w, u32 h, u32 bpp, unsigned long long ns)
+{
+    static int on = -1;
+    if (on < 0) on = getenv("PS3RECOMP_VK_READBACK_STATS") ? 1 : 0;
+    if (!on) return;
+    static struct { int depth; u32 w, h, bpp; unsigned long long n, ns; } t[32];
+    static unsigned long long t0;
+    int k = 0;
+    while (k < 31 && t[k].n && !(t[k].depth == depth && t[k].w == w && t[k].h == h && t[k].bpp == bpp)) k++;
+    t[k].depth = depth; t[k].w = w; t[k].h = h; t[k].bpp = bpp; t[k].n++; t[k].ns += ns;
+    const unsigned long long now = vk_tns();
+    if (!t0) t0 = now;
+    if (now - t0 >= 5000000000ull) {
+        fprintf(stderr, "[vk-readback]");
+        for (int i = 0; i < 32 && t[i].n; i++)
+            fprintf(stderr, " %s %ux%u x%u: %llu (%.2f MB, %.3f ms each)", t[i].depth ? "depth" : "color",
+                    t[i].w, t[i].h, t[i].bpp, t[i].n, (double)t[i].w * t[i].h * t[i].bpp / 1048576.0,
+                    t[i].ns / 1e6 / t[i].n);
+        fprintf(stderr, "\n");
+        memset(t, 0, sizeof t);
+        t0 = now;
+    }
+}
