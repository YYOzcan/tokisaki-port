diff --git a/libs/audio/cellAudio.c b/libs/audio/cellAudio.c
index b51fb7c..c8cef73 100644
--- a/libs/audio/cellAudio.c
+++ b/libs/audio/cellAudio.c
@@ -609,16 +609,28 @@ static void* audio_mix_thread_func(void* arg)
     printf("[cellAudio] Mixing thread started\n");
 
     while (s_mix_thread_running) {
+        /* Mix only when the device has room for a block. SDL's queue has no
+         * bound, and mixing on a fixed sleep ran ~4% ahead of the device
+         * clock: the queue -- the sound's delay behind the picture -- grew
+         * by ~2.5 s a minute for as long as the game ran (Killzone 2: 11 s
+         * after four minutes). Without a device, mix in real time. */
+        const int room = audio_backend_room();
+        if (room == 0) { usleep(1000); continue; }
         audio_mix_one_block();
         audio_backend_submit(s_mix_buffer, CELL_AUDIO_BLOCK_SAMPLES);
         audio_notify_event_queues();
+        if (room < 0) { usleep(1000000u * CELL_AUDIO_BLOCK_SAMPLES / CELL_AUDIO_SAMPLE_RATE); continue; }
 
         u32 queued = audio_backend_queued_samples();
-        if (queued > CELL_AUDIO_BLOCK_SAMPLES * 4) {
-            usleep(5000);
-        } else {
-            usleep(2000);
-        }
+        /* AUDIO_RATE=1: every 5 s, blocks mixed per second (real time 187.5)
+         * and how much the device queue holds. */
+        { static int on = -1; if (on < 0) on = getenv("AUDIO_RATE") ? 1 : 0;
+          if (on) { static struct timespec t0; static unsigned n; struct timespec t;
+              clock_gettime(CLOCK_MONOTONIC, &t); if (!t0.tv_sec) t0 = t; n++;
+              const double dt = (t.tv_sec - t0.tv_sec) + (t.tv_nsec - t0.tv_nsec) * 1e-9;
+              if (dt >= 5.0) { fprintf(stderr, "[audio-rate] %.1f blocks/s (real time 187.5), device queue %u samples\n",
+                                       n / dt, queued); n = 0; t0 = t; } } }
+        (void)queued;
     }
 
     printf("[cellAudio] Mixing thread stopped\n");
