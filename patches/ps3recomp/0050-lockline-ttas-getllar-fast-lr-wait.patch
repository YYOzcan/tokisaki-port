+/* GETLLAR without the lock, for a context already registered on a line
+ * already marked -- the policy modules' and the job manager's poll loops,
+ * millions a second in Killzone 2's level, ~45% of them waiting for the lock.
+ * The reservation is published first, so a lock holder that writes the line
+ * from then on raises SPU_EVENT_LR as before; the 128 bytes are a seqlock read
+ * against the lock's counter, so they are not torn by any lock holder. A
+ * write that lands between publishing and the copy costs a spurious lost
+ * reservation, which hardware allows and PUTLLC's compare would catch anyway.
+ * Returns 0 when the caller must take the locked path. SPU_GETLLAR_FAST=0
+ * always takes it. */
+int spu_getllar_fast(spu_context* ctx, uint32_t ea, void* ls, const void* mem)
+{
+#ifdef SPU_HAVE_GETLLAR_FAST
+    static int on = -1;
+    if (on < 0) { const char* e = getenv("SPU_GETLLAR_FAST"); on = !(e && e[0] == '0'); }
+    if (!on || !ctx) return 0;
+    /* SPU_LL_STATS=1 also counts what this path did (racy counters) */
+    static unsigned long long st[5]; static double st_t0;
+    const int stats = s_ll_stats > 0;
+    if (stats) {
+        struct timespec ts; clock_gettime(CLOCK_MONOTONIC, &ts);
+        const double now = ts.tv_sec + ts.tv_nsec * 1e-9;
+        if (!st_t0) st_t0 = now;
+        if (now - st_t0 >= 5.0) {
+            st_t0 = now;
+            fprintf(stderr, "[getllar-fast] per 5 s: ok %llu, line not marked %llu, not registered %llu, torn %llu\n",
+                    st[0], st[1], st[2], st[3]);
+            memset(st, 0, sizeof st);
+        }
+    }
+    const uint32_t line = ea >> SPU_COH_LINE_SHIFT;
+    if (!(s_coh_bitmap[line >> 3] & (1u << (line & 7)))) { if (stats) st[1]++; return 0; }
+    if (t_coh_ctx != ctx || t_coh_gen != __atomic_load_n(&s_coh_gen, __ATOMIC_ACQUIRE)) { if (stats) st[2]++; return 0; }
+    __atomic_store_n(&ctx->resv_ea, ea, __ATOMIC_RELAXED);
+    __atomic_store_n(&ctx->resv_valid, 1, __ATOMIC_SEQ_CST);
+    /* A held lock (odd counter) is waited out with pauses -- reads, not the
+     * locked exchanges of the lock itself -- up to ~2k pauses, then the lock. */
+    for (int tries = 0, waits = 0; tries < 8 && waits < 2048;) {
+        const unsigned s1 = atomic_load_explicit(&g_ll_seq, memory_order_acquire);
+        if (s1 & 1u) { SPU_LL_PAUSE(); waits++; continue; }
+        tries++;
+        memcpy(ls, mem, MFC_ATOMIC_LINE);
+        atomic_thread_fence(memory_order_acquire);
+        if (atomic_load_explicit(&g_ll_seq, memory_order_relaxed) != s1) continue;
+        memcpy(ctx->resv_line, ls, MFC_ATOMIC_LINE);
+        ctx->atomic_stat = 4;
+        if (stats) st[0]++;
+        return 1;
+    }
+    if (stats) st[3]++;
+#else
+    (void)ctx; (void)ea; (void)ls; (void)mem;
+#endif
+    return 0;
+}
