+/* Test-and-test-and-set as on Windows above. The bare test-and-set loop had
+ * every waiter hammer the line with locked exchanges: in Killzone 2's level
+ * five SPU threads and the PPU take this lock for every PUT and atomic, and
+ * the waiters slowed the holder and their SMT siblings (spu_lockline_lock
+ * ~5% of an SPU thread, ~3% of the main thread). */
+static atomic_int g_lockline = 0;
+static atomic_uint g_ll_seq = 0;
+/* SPU_LL_STATS=1: every 5 s, the callers that took the lock most, with how
+ * many of those acquisitions had to wait and for how many spins. */
+static void spu_ll_stats(void* ra, unsigned long long spun);
+static int s_ll_stats = -1;
+__attribute__((noinline)) void spu_lockline_lock(void)
+{
+    unsigned spins = 0;
+    unsigned long long spun = 0;
+    while (atomic_exchange_explicit(&g_lockline, 1, memory_order_acquire)) {
+        do {
+            SPU_LL_PAUSE();
+            spun++;
+            if (++spins >= 4096) { spins = 0; sched_yield(); }
+        } while (atomic_load_explicit(&g_lockline, memory_order_relaxed));
+    }
+    /* odd while held: spu_getllar_fast's snapshot is valid only if this
+     * stayed even and unchanged across its copy */
+    atomic_store_explicit(&g_ll_seq, atomic_load_explicit(&g_ll_seq, memory_order_relaxed) + 1u,
+                          memory_order_relaxed);
+    atomic_thread_fence(memory_order_release);
+    if (__builtin_expect(s_ll_stats != 0, 0)) {
+        if (s_ll_stats < 0) { const char* e = getenv("SPU_LL_STATS"); s_ll_stats = e && e[0] == '1'; }
+        if (s_ll_stats) spu_ll_stats(__builtin_return_address(0), spun);
+    }
+}
+#include <stdio.h>
+#include <time.h>
+static void spu_ll_stats(void* ra, unsigned long long spun)
+{
+    /* called with the lock held: no other synchronisation needed */
+    static struct { void* ra; unsigned long long n, waited, spins; } t[32];
+    static double t0;
+    for (int i = 0; i < 32; i++)
+        if (t[i].ra == ra || !t[i].ra) { t[i].ra = ra; t[i].n++; if (spun) { t[i].waited++; t[i].spins += spun; } break; }
+    struct timespec ts; clock_gettime(CLOCK_MONOTONIC, &ts);
+    const double now = ts.tv_sec + ts.tv_nsec * 1e-9;
+    if (!t0) t0 = now;
+    if (now - t0 < 5.0) return;
+    t0 = now;
+    fprintf(stderr, "[ll-stats] per 5 s (caller offset from spu_lockline_lock: taken / waited / spins):");
+    for (int i = 0; i < 32 && t[i].ra; i++)
+        fprintf(stderr, " %+lld:%llu/%llu/%llu", (long long)((char*)t[i].ra - (char*)(void*)spu_lockline_lock),
+                t[i].n, t[i].waited, t[i].spins);
+    fprintf(stderr, "\n");
+    for (int i = 0; i < 32; i++) t[i].ra = 0, t[i].n = t[i].waited = t[i].spins = 0;
+}
+void spu_lockline_unlock(void)
+{
+    atomic_thread_fence(memory_order_release);
+    atomic_store_explicit(&g_ll_seq, atomic_load_explicit(&g_ll_seq, memory_order_relaxed) + 1u,
+                          memory_order_relaxed);
+    atomic_store_explicit(&g_lockline, 0, memory_order_release);
+}
