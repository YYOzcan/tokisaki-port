+/* The "wait for this line to change" read -- GETLLAR, find nothing to take,
+ * rdch SPU_RdEventStat with only the lost-reservation event enabled -- parks
+ * for a while even without SPU_CH_BLOCK: every writer of a reserved line
+ * raises SPU_EVENT_LR and wakes the holder (spu_coh_notify_write*), and the
+ * line is compared again on every timeout. Without it the read came back at
+ * once and the loop span: Killzone 2's SPU task image 5 waited on a semaphore
+ * line with ~740,000 GETLLARs a second. Capped (SPU_LR_WAIT_US, default 2000;
+ * 0 = never park): a writer that did not wake costs at most that. */
+static void spu_lr_wait(spu_context* ctx)
+{
+    static long cap_us = -1;
+    if (cap_us < 0) { const char* e = getenv("SPU_LR_WAIT_US"); cap_us = e ? atol(e) : 2000; }
+    if (cap_us <= 0) return;
+    spu_resv_lost_poll(ctx);
+    for (int i = 0; i < 64 && !(ctx->event_status & ctx->event_mask); i++) {
+#if defined(__x86_64__) || defined(__i386__)
+        __builtin_ia32_pause();
+#endif
+        spu_resv_lost_poll(ctx);
+    }
+    if (ctx->event_status & ctx->event_mask) return;
+    struct timespec t0, t;
+    clock_gettime(CLOCK_MONOTONIC, &t0);
+    for (;;) {
+        AcquireSRWLockExclusive((SRWLOCK*)&ctx->ch_wait_lock);
+        spu_resv_lost_poll(ctx);
+        if (!(__atomic_load_n(&ctx->event_status, __ATOMIC_ACQUIRE) & ctx->event_mask))
+            SleepConditionVariableSRW((CONDITION_VARIABLE*)&ctx->ch_wait_cv,
+                                      (SRWLOCK*)&ctx->ch_wait_lock, 1, 0);
+        ReleaseSRWLockExclusive((SRWLOCK*)&ctx->ch_wait_lock);
+        spu_resv_lost_poll(ctx);
+        if (__atomic_load_n(&ctx->event_status, __ATOMIC_ACQUIRE) & ctx->event_mask) return;
+        clock_gettime(CLOCK_MONOTONIC, &t);
+        if ((t.tv_sec - t0.tv_sec) * 1000000L + (t.tv_nsec - t0.tv_nsec) / 1000L >= cap_us) return;
+    }
+}
