+/* CellSpursTasksetAttribute, big-endian guest layout (as libsre writes it):
+ *   +0x00 revision  +0x04 sdk version  +0x08 u64 args  +0x10 u8 priority[8]
+ *   +0x18 max contention  +0x1C name  +0x20 taskset size  +0x24 clear-LS */
+#define CSTA_ARGS     0x08
+#define CSTA_PRIORITY 0x10
+#define CSTA_MAXCONT  0x18
+
 s32 cellSpursCreateTasksetWithAttribute(CellSpurs* spurs,
                                         CellSpursTaskset* taskset,
                                         const CellSpursTasksetAttribute* attr)
 {
-    (void)attr;
-    return cellSpursCreateTaskset(spurs, taskset, 0, NULL, 0);
+    /* The taskset argument is what every task of the set receives in r4's
+     * preferred doubleword. Dropping it (args 0) broke Havok on Killzone 2:
+     * its SPU job task switches ELF to the address it finds there and failed
+     * with CELL_SPURS_TASK_ERROR_INVAL, leaving the physics step's SPU jobs
+     * unprocessed. */
+    const uint32_t attr_ea = (uint32_t)(uintptr_t)attr;
+    u64 args = 0;
+    u32 maxc = 0;
+    if (attr_ea) {
+        args = vm_read64(attr_ea + CSTA_ARGS);
+        maxc = vm_read32(attr_ea + CSTA_MAXCONT);
+    }
+    printf("[cellSpurs] CreateTasksetWithAttribute(attr=0x%08X) args=0x%llX maxContention=%u\n",
+           attr_ea, (unsigned long long)args, maxc);
+    return cellSpursCreateTaskset(spurs, taskset, args, NULL, maxc);
 }
 
 s32 cellSpursDestroyTaskset(CellSpursTaskset* taskset)
@@ -930,6 +950,11 @@ s32 cellSpursCreateTask(CellSpursTaskset* taskset, CellSpursTaskId* taskId,
             /* Register the task in the REAL BE taskset: writes task_info[slot]
              * (args/elf/context/ls_pattern) + sets enabled+ready bits so the PM's
              * SELECT_TASK picks it. Slot index i = the SPURS taskId (bitset bit). */
+            /* Running BEFORE ready: the exit scheduler starts any enabled,
+             * ready task it does not see running, and this one is about to be
+             * dispatched by us (see spu_taskset_mark_running). */
+            { extern void spu_taskset_mark_running(uint32_t, uint32_t);
+              spu_taskset_mark_running(taskset_ea, i); }
             spurs_taskset_add_task(taskset_ea, i, (uint64_t)elf_ea,
                                    (uint64_t)context_ea, task_arg, task_lsp);
             /* Bridge to the image-22 dispatch so build_context uses this taskset+task. */
@@ -1146,12 +1171,21 @@ s32 _cellSpursTasksetAttributeInitialize(CellSpursTasksetAttribute* attr,
                                          u32 revision, u32 sdkVersion, u64 argTaskset,
                                          u64 priority, u32 maxContention)
 {
-    (void)sdkVersion; (void)argTaskset; (void)priority; (void)maxContention;
     if (!attr) return CELL_SPURS_TASK_ERROR_NULL_POINTER;
+    const uint32_t attr_ea = (uint32_t)(uintptr_t)attr;
     attr = GUEST_PTR(attr, CellSpursTasksetAttribute*);
     memset(attr, 0, sizeof(CellSpursTasksetAttribute));
-    attr->revision = revision ? revision : 1;
-    printf("[cellSpurs] _TasksetAttributeInitialize(rev=%u)\n", revision);
+    /* Guest big-endian layout (see CSTA_* above): the create call reads the
+     * argument and contention back from here. */
+    vm_write32(attr_ea + 0x00, revision ? revision : 1);
+    vm_write32(attr_ea + 0x04, sdkVersion);
+    vm_write64(attr_ea + CSTA_ARGS, argTaskset);
+    if ((uint32_t)priority)
+        for (u32 i = 0; i < 8; i++)
+            vm_write8(attr_ea + CSTA_PRIORITY + i, vm_read8((uint32_t)priority + i));
+    vm_write32(attr_ea + CSTA_MAXCONT, maxContention);
+    printf("[cellSpurs] _TasksetAttributeInitialize(rev=%u args=0x%llX maxContention=%u)\n",
+           revision, (unsigned long long)argTaskset, maxContention);
     return CELL_OK;
 }
 
