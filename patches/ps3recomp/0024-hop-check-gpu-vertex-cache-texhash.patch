+/* ---- vertices kept on the GPU ----------------------------------------------
+ * The engine names the vertex bytes of a draw it has seen before with a key
+ * (draw_cached); those are copied once into a persistent buffer and bound
+ * from there afterwards, instead of through the batch ring every frame. The
+ * buffer fills front to back; when it is full everything is waited for and
+ * it starts over. PS3RECOMP_VK_VCACHE=0 turns it off. */
+#define VK_VC_BYTES (256u << 20)
+#define VK_VC_SLOTS 16384u
+static struct {
+    int on;                       /* -1 unknown, 0 off/failed, 1 on */
+    vk_buffer buf;
+    VkDeviceSize top;
+    struct { u64 key; VkDeviceSize off, bytes; } map[VK_VC_SLOTS];
+    u32 used;
+} s_vc = { .on = -1 };
+
+/* The offset of the key's vertices in s_vc.buf, copying them there first if
+ * needed; ~0 when they cannot be kept. */
+static VkDeviceSize vk_vc_get(u64 key, const void* vertices, VkDeviceSize bytes)
+{
+    if (s_vc.on < 0) {
+        const char* e = getenv("PS3RECOMP_VK_VCACHE");
+        s_vc.on = !(e && e[0] == '0');
+        if (s_vc.on && (vk_create_host_buffer_ex(&s_vc.buf, VK_VC_BYTES, VK_BUFFER_USAGE_VERTEX_BUFFER_BIT, 1) ||
+                        !s_vc.buf.coherent)) {
+            vk_destroy_buffer(&s_vc.buf);
+            s_vc.on = 0;
+        }
+        VK_LOG("vertex cache on the GPU: %s\n", s_vc.on ? "on (256 MB)" : "off");
+    }
+    if (!s_vc.on || !key || bytes > VK_VC_BYTES / 4) return ~(VkDeviceSize)0;
+    u32 i = (u32)(key ^ (key >> 32)) & (VK_VC_SLOTS - 1u);
+    for (u32 probe = 0; probe < 32; probe++, i = (i + 1u) & (VK_VC_SLOTS - 1u)) {
+        if (s_vc.map[i].key == key && s_vc.map[i].bytes == bytes) return s_vc.map[i].off;
+        if (!s_vc.map[i].key) break;
+    }
+    const VkDeviceSize at = (s_vc.top + 255u) & ~(VkDeviceSize)255u;
+    if (at + bytes > VK_VC_BYTES || s_vc.used >= VK_VC_SLOTS / 2 || s_vc.map[i].key) {
+        /* full: start over once nothing in flight can read the old contents */
+        vk_submit_and_wait();
+        memset(s_vc.map, 0, sizeof s_vc.map);
+        s_vc.top = 0;
+        s_vc.used = 0;
+        return ~(VkDeviceSize)0;      /* this draw goes through the ring */
+    }
+    memcpy((u8*)s_vc.buf.ptr + at, vertices, (size_t)bytes);
+    s_vc.map[i].key = key; s_vc.map[i].off = at; s_vc.map[i].bytes = bytes;
+    s_vc.top = at + bytes;
+    s_vc.used++;
+    return at;
+}
