  * frame. The queue lock is held only to acquire, submit and present; the
  * copy into the history slot was submitted before the hand-over and the first
  * barrier here covers everything submitted before. */
+/* The presenter's fence wait without the driver's spin: NVIDIA's
+ * vkWaitForFences polls on the CPU (~a quarter of a core here, all of it
+ * taken from the game's threads); its status read every 200 us costs nothing. */
+static void vk_fsr_wait(VkFence f)
+{
+    for (int i = 0; i < 20000; i++) {          /* 4 s at most */
+        const VkResult st = pvkGetFenceStatus(s_vk.device, f);
+        if (st != VK_NOT_READY) return;
+        struct timespec ts = { 0, 200000 };
+        nanosleep(&ts, NULL);
+    }
+}
