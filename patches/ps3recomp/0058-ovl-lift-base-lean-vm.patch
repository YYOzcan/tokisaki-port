+    if (vk_begin()) goto fail;
+    for (int i = 0; i < 3; i++) {
+        vk_barrier_image(s_fg.hist[i].img, VK_IMAGE_ASPECT_COLOR_BIT, VK_IMAGE_LAYOUT_UNDEFINED);
+        vk_barrier_image(s_fg.lum[i].img, VK_IMAGE_ASPECT_COLOR_BIT, VK_IMAGE_LAYOUT_UNDEFINED);
+    }
+    vk_barrier_image(s_fg.interp.img, VK_IMAGE_ASPECT_COLOR_BIT, VK_IMAGE_LAYOUT_UNDEFINED);
+    vk_barrier_image(s_fg.mva.img, VK_IMAGE_ASPECT_COLOR_BIT, VK_IMAGE_LAYOUT_UNDEFINED);
+    vk_barrier_image(s_fg.mvb.img, VK_IMAGE_ASPECT_COLOR_BIT, VK_IMAGE_LAYOUT_UNDEFINED);
+    s_fg.ok = 1;
+    VK_LOG("frame generation on (PS3RECOMP_VK_FRAMEGEN=1): a frame between every two, %ux%u\n", w, h);
+    return 0;
+fail:
+    VK_LOG("frame generation unavailable, frames are shown as they come\n");
+    return -1;
+}
+
+static void vk_fg_dispatch(u32 r, int mode, u32 gx, u32 gy)
+{
+    const int pc[4] = { mode, (int)s_fg.w, (int)s_fg.h, 0 };
+    pvkCmdPushConstants(s_vk.cmd, s_fg.pl, VK_SHADER_STAGE_COMPUTE_BIT, 0, sizeof pc, pc);
+    pvkCmdDispatch(s_vk.cmd, gx, gy, 1);
+    VkMemoryBarrier mb = { .sType = VK_STRUCTURE_TYPE_MEMORY_BARRIER,
+                           .srcAccessMask = VK_ACCESS_SHADER_WRITE_BIT,
+                           .dstAccessMask = VK_ACCESS_SHADER_READ_BIT | VK_ACCESS_SHADER_WRITE_BIT |
+                                            VK_ACCESS_TRANSFER_READ_BIT };
+    pvkCmdPipelineBarrier(s_vk.cmd, VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT,
+                          VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT | VK_PIPELINE_STAGE_TRANSFER_BIT,
+                          0, 1, &mb, 0, NULL, 0, NULL);
+    (void)r;
+}
+
+static void vk_fg_stat(void)
+{
+    const unsigned long long now = vk_now_ns();
+    if (!s_fg.win_ns) s_fg.win_ns = now;
+    if (now - s_fg.win_ns >= 5000000000ull) {
+        const double sec = (double)(now - s_fg.win_ns) / 1e9;
+        VK_LOG("frame generation: %.1f frames/s shown from %.1f rendered\n",
+               s_fg.shown / sec, s_fg.frames / sec);
+        s_fg.shown = s_fg.frames = 0; s_fg.win_ns = now;
+    }
+}
+
+static void vk_fg_dump(u32 r);
+/* At a flip: returns 1 when frame generation presented (or scheduled) it. */
+static int vk_fg_present(void)
+{
+    if (!vk_fg_enabled() || vk_fg_init()) return 0;
+    const unsigned long long now = vk_now_ns();
+    if (s_fg.pending) {                       /* the last real frame is still waiting: show it now */
+        vk_present_image(s_fg.hist[s_fg.pend_r].img);
+        s_fg.pending = 0; s_fg.shown++;
+    }
+    if (s_fg.last_flip_ns) {
+        double dt = (double)(now - s_fg.last_flip_ns);
+        if (dt < 8e6) dt = 8e6;
+        if (dt > 1e8) dt = 1e8;
+        s_fg.dt_ns = s_fg.dt_ns > 0 ? 0.8 * s_fg.dt_ns + 0.2 * dt : dt;
+    }
+    const int fresh = !s_fg.last_flip_ns || now - s_fg.last_flip_ns > 200000000ull;   /* first, or after a pause */
+    s_fg.last_flip_ns = now;
+    s_fg.frames++;
+    const u32 r = s_fg.r;
+    if (vk_begin()) return 0;
+    vk_barrier_image(s_vk.color.img, VK_IMAGE_ASPECT_COLOR_BIT, VK_IMAGE_LAYOUT_GENERAL);
+    VkImageCopy cp = { .srcSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 },
+                       .dstSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 },
+                       .extent = { s_fg.w, s_fg.h, 1 } };
+    pvkCmdCopyImage(s_vk.cmd, s_vk.color.img, VK_IMAGE_LAYOUT_GENERAL,
+                    s_fg.hist[r].img, VK_IMAGE_LAYOUT_GENERAL, 1, &cp);
+    VkMemoryBarrier mb = { .sType = VK_STRUCTURE_TYPE_MEMORY_BARRIER,
+                           .srcAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT,
+                           .dstAccessMask = VK_ACCESS_SHADER_READ_BIT | VK_ACCESS_TRANSFER_READ_BIT };
+    pvkCmdPipelineBarrier(s_vk.cmd, VK_PIPELINE_STAGE_TRANSFER_BIT,
+                          VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT | VK_PIPELINE_STAGE_TRANSFER_BIT,
+                          0, 1, &mb, 0, NULL, 0, NULL);
+    pvkCmdBindPipeline(s_vk.cmd, VK_PIPELINE_BIND_POINT_COMPUTE, s_fg.pipe);
+    pvkCmdBindDescriptorSets(s_vk.cmd, VK_PIPELINE_BIND_POINT_COMPUTE, s_fg.pl, 0, 1, &s_fg.set[r], 0, NULL);
+    const u32 qw = s_fg.w / 4u, qh = s_fg.h / 4u, bw = (s_fg.w + 7u) / 8u, bh = (s_fg.h + 7u) / 8u;
+    vk_fg_dispatch(r, 0, (qw + 7u) / 8u, (qh + 7u) / 8u);
+    if (s_fg.have_prev && !fresh) {
+        vk_fg_dispatch(r, 1, (bw + 7u) / 8u, (bh + 7u) / 8u);
+        vk_fg_dispatch(r, 2, (bw + 7u) / 8u, (bh + 7u) / 8u);
+        vk_fg_dispatch(r, 3, (s_fg.w + 7u) / 8u, (s_fg.h + 7u) / 8u);
+        s_b.ops++;
+        vk_present_image(s_fg.interp.img);    /* half way between the last frame and this one */
+        s_fg.shown++;
+        vk_fg_dump(r);
+        s_fg.pending = 1; s_fg.pend_r = r;
+        s_fg.due_ns = now + (unsigned long long)(s_fg.dt_ns * 0.5);
+    } else {
+        s_b.ops++;
+        vk_present_image(s_fg.hist[r].img);
+        s_fg.shown++;
+    }
+    s_fg.have_prev = 1;
+    s_fg.r = (r + 1u) % 3u;
+    vk_fg_stat();
+    return 1;
+}
+
+/* PS3RECOMP_VK_FRAMEGEN_DUMP=<path with %u>,<every n>: write the frame
+ * before, the generated one and the frame after, side by side, for every nth
+ * generated frame (a diagnostic: a GPU wait and a file each time). */
+static void vk_fg_dump(u32 r)
+{
+    static const char* path; static unsigned every; static int read_ = 0;
+    if (!read_) { read_ = 1; const char* e = getenv("PS3RECOMP_VK_FRAMEGEN_DUMP");
+        if (e) { static char buf[512]; snprintf(buf, sizeof buf, "%s", e); char* c = strchr(buf, ',');
+                 every = 30; if (c) { *c = 0; every = (unsigned)atoi(c + 1); if (!every) every = 30; } path = buf; } }
+    if (!path || (s_fg.frames % every) != 0 || !s_vk.readback.buf) return;
+    const u32 w = s_fg.w, h = s_fg.h, p = (r + 2u) % 3u;
+    const VkImage imgs[3] = { s_fg.hist[p].img, s_fg.interp.img, s_fg.hist[r].img };
+    unsigned char* rows = (unsigned char*)malloc((size_t)w * 3u * h * 3u);
+    if (!rows) return;
+    for (int k = 0; k < 3; k++) {
+        if (vk_begin()) { free(rows); return; }
+        VkBufferImageCopy region = { .imageSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 },
+                                     .imageExtent = { w, h, 1 } };
+        pvkCmdCopyImageToBuffer(s_vk.cmd, imgs[k], VK_IMAGE_LAYOUT_GENERAL, s_vk.readback.buf, 1, &region);
+        if (vk_submit_and_wait()) { free(rows); return; }
+        vk_invalidate(&s_vk.readback);
+        const unsigned char* px = (const unsigned char*)s_vk.readback.ptr;
+        for (u32 y = 0; y < h; y++)
+            for (u32 x = 0; x < w; x++) {
+                const unsigned char* q = px + ((size_t)y * w + x) * 4u;
+                unsigned char* d = rows + ((size_t)y * w * 3u + (size_t)k * w + x) * 3u;
+                d[0] = q[0]; d[1] = q[1]; d[2] = q[2];
+            }
+    }
+    char fn[600]; snprintf(fn, sizeof fn, path, s_fg.frames);
+    FILE* f = fopen(fn, "wb");
+    if (f) { fprintf(f, "P6\n%u %u\n255\n", w * 3u, h); fwrite(rows, 1, (size_t)w * 3u * h * 3u, f); fclose(f); }
+    free(rows);
+}
+
+/* From the FIFO loop: the real frame whose half interval has passed. */
+static void vk_fg_tick(void)
+{
+    if (!s_fg.pending || vk_now_ns() < s_fg.due_ns) return;
+    vk_present_image(s_fg.hist[s_fg.pend_r].img);
+    s_fg.pending = 0; s_fg.shown++;
+    vk_fg_stat();
+}
+
 static void vk_dump_ppm(const unsigned char* rgba)
 {
     char path[512];
@@ -2540,7 +2785,7 @@ static void vk_cb_present(void* ud, u32 buffer_id)
         s_vk.presented++;
         s_g.last_draws = s_g.draws;
         s_g.draws = 0;
-        vk_present_window();
+        if (!vk_fg_present()) vk_present_window();
         return;
     }
     if (vk_begin()) return;
@@ -4665,6 +4910,7 @@ int rsx_vulkan_backend_pump_messages(void)
         g_rsx_pump_hook = vk_pump_if_due;
     }
     vk_pump_events();
+    vk_fg_tick();
     return s_quit_seen ? -1 : 0;
 }
 
diff --git a/libs/video/shaders/rsx_vk_framegen.comp b/libs/video/shaders/rsx_vk_framegen.comp
new file mode 100644
index 00000000..62842d6d
--- /dev/null
+++ b/libs/video/shaders/rsx_vk_framegen.comp
@@ -0,0 +1,154 @@
+#version 450
+/* Frame generation (ENHANCEMENT, PS3RECOMP_VK_FRAMEGEN=1, rsx_vulkan_backend.c):
+ * a frame half way between the last two presented frames, from motion found
+ * by block matching -- no help from the title (no motion vectors, no depth).
+ *   mode 0: luma of `cur` at quarter size (4x4 averages)              -> lumCur
+ *   mode 1: one motion vector per 8x8 block, anchored half way: prev at
+ *           p - v/2 matches cur at p + v/2. A coarse search on the quarter
+ *           luma (even steps, +-32 px), a half-step refinement there, then
+ *           +-2 px at full size; the zero vector wins near-ties, so still
+ *           pixels (the HUD, the crosshair) stay put                 -> mvA
+ *   mode 2: 3x3 median of the vectors                                -> mvB
+ *   mode 3: the frame: each pixel from prev and cur along its vector,
+ *           or from both in place where that matches better          -> out
+ * Rebuild the header: glslangValidator -V --vn rsx_vk_framegen_spv
+ *   -o rsx_vk_framegen_spv.h rsx_vk_framegen.comp */
+layout(local_size_x = 8, local_size_y = 8) in;
+layout(binding = 0, rgba8)   uniform readonly  image2D prevImg;
+layout(binding = 1, rgba8)   uniform readonly  image2D curImg;
+layout(binding = 2, rgba8)   uniform writeonly image2D outImg;
+layout(binding = 3, r32f)    uniform readonly  image2D lumPrev;
+layout(binding = 4, r32f)    uniform           image2D lumCur;
+layout(binding = 5, rgba16f) uniform           image2D mvA;
+layout(binding = 6, rgba16f) uniform           image2D mvB;
+layout(push_constant) uniform PC { int mode; int w; int h; int pad; } pc;
+
+const vec3 LW = vec3(0.299, 0.587, 0.114);
+
+float lq(bool prev, ivec2 q)
+{
+    ivec2 s = ivec2(pc.w >> 2, pc.h >> 2);
+    q = clamp(q, ivec2(0), s - 1);
+    return prev ? imageLoad(lumPrev, q).r : imageLoad(lumCur, q).r;
+}
+float lqb(bool prev, vec2 q)             /* bilinear, q in quarter pixels (centres at +0.5) */
+{
+    vec2 f = q - 0.5; ivec2 i = ivec2(floor(f)); vec2 t = f - vec2(i);
+    return mix(mix(lq(prev, i), lq(prev, i + ivec2(1, 0)), t.x),
+               mix(lq(prev, i + ivec2(0, 1)), lq(prev, i + ivec2(1, 1)), t.x), t.y);
+}
+vec4 px(bool prev, ivec2 p)
+{
+    p = clamp(p, ivec2(0), ivec2(pc.w, pc.h) - 1);
+    return prev ? imageLoad(prevImg, p) : imageLoad(curImg, p);
+}
+vec4 pxb(bool prev, vec2 p)              /* bilinear, p in pixels (centres at +0.5) */
+{
+    vec2 f = p - 0.5; ivec2 i = ivec2(floor(f)); vec2 t = f - vec2(i);
+    return mix(mix(px(prev, i), px(prev, i + ivec2(1, 0)), t.x),
+               mix(px(prev, i + ivec2(0, 1)), px(prev, i + ivec2(1, 1)), t.x), t.y);
+}
+
+/* cost of the half-way vector v (quarter pixels) for the block whose 4x4
+ * quarter-pixel window starts at q0 */
+float costq(ivec2 q0, vec2 v)
+{
+    float c = 0.0;
+    for (int y = 0; y < 4; y++)
+        for (int x = 0; x < 4; x++) {
+            vec2 q = vec2(q0 + ivec2(x, y)) + 0.5;
+            c += abs(lqb(true, q - 0.5 * v) - lqb(false, q + 0.5 * v));
+        }
+    return c + 0.004 * (abs(v.x) + abs(v.y));
+}
+/* the same at full size, v in pixels, on every other pixel of the 8x8 block */
+float costf(ivec2 p0, vec2 v)
+{
+    float c = 0.0;
+    for (int y = 0; y < 8; y += 2)
+        for (int x = 0; x < 8; x += 2) {
+            vec2 p = vec2(p0 + ivec2(x, y)) + 0.5;
+            c += abs(dot(pxb(true, p - 0.5 * v).rgb, LW) - dot(pxb(false, p + 0.5 * v).rgb, LW));
+        }
+    return c + 0.001 * (abs(v.x) + abs(v.y));
+}
+
+float med3(float a, float b, float c) { return max(min(a, b), min(max(a, b), c)); }
+float med9(float v[9])
+{
+    /* median of 9 by the classic min/max network on three triples */
+    float a = med3(v[0], v[1], v[2]), b = med3(v[3], v[4], v[5]), c = med3(v[6], v[7], v[8]);
+    float lo = max(max(min(v[0], min(v[1], v[2])), min(v[3], min(v[4], v[5]))), min(v[6], min(v[7], v[8])));
+    float hi = min(min(max(v[0], max(v[1], v[2])), max(v[3], max(v[4], v[5]))), max(v[6], max(v[7], v[8])));
+    return med3(lo, med3(a, b, c), hi);
+}
+
+void main()
+{
+    ivec2 g = ivec2(gl_GlobalInvocationID.xy);
+    if (pc.mode == 0) {
+        if (g.x >= (pc.w >> 2) || g.y >= (pc.h >> 2)) return;
+        float s = 0.0;
+        for (int y = 0; y < 4; y++)
+            for (int x = 0; x < 4; x++) s += dot(px(false, g * 4 + ivec2(x, y)).rgb, LW);
+        imageStore(lumCur, g, vec4(s / 16.0));
+        return;
+    }
+    ivec2 nb = ivec2((pc.w + 7) >> 3, (pc.h + 7) >> 3);
+    if (pc.mode == 1) {
+        if (g.x >= nb.x || g.y >= nb.y) return;
+        ivec2 q0 = g * 2 - 1;                    /* 4x4 quarter pixels around the block */
+        vec2 best = vec2(0.0); float bc = costq(q0, best);
+        for (int vy = -8; vy <= 8; vy += 2)
+            for (int vx = -8; vx <= 8; vx += 2) {
+                vec2 v = vec2(vx, vy); float c = costq(q0, v);
+                if (c < bc) { bc = c; best = v; }
+            }
+        vec2 b0 = best;
+        for (int dy = -1; dy <= 1; dy++)
+            for (int dx = -1; dx <= 1; dx++) {
+                if (dx == 0 && dy == 0) continue;
+                vec2 v = b0 + vec2(dx, dy); float c = costq(q0, v);
+                if (c < bc) { bc = c; best = v; }
+            }
+        ivec2 p0 = g * 8;
+        vec2 V = best * 4.0, bf = V; float fc = costf(p0, V);
+        for (int dy = -2; dy <= 2; dy++)
+            for (int dx = -2; dx <= 2; dx++) {
+                if (dx == 0 && dy == 0) continue;
+                vec2 v = V + vec2(dx, dy); float c = costf(p0, v);
+                if (c < fc) { fc = c; bf = v; }
+            }
+        float z = costf(p0, vec2(0.0));
+        if (z <= fc * 1.05 + 0.02) { bf = vec2(0.0); fc = z; }
+        imageStore(mvA, g, vec4(bf, fc, 0.0));
+        return;
+    }
+    if (pc.mode == 2) {
+        if (g.x >= nb.x || g.y >= nb.y) return;
+        float xs[9], ys[9]; int k = 0;
+        for (int dy = -1; dy <= 1; dy++)
+            for (int dx = -1; dx <= 1; dx++) {
+                vec4 m = imageLoad(mvA, clamp(g + ivec2(dx, dy), ivec2(0), nb - 1));
+                xs[k] = m.x; ys[k] = m.y; k++;
+            }
+        imageStore(mvB, g, vec4(med9(xs), med9(ys), 0.0, 0.0));
+        return;
+    }
+    if (g.x >= pc.w || g.y >= pc.h) return;
+    /* the vector field, bilinear between block centres */
+    vec2 bp = (vec2(g) + 0.5) / 8.0 - 0.5;
+    ivec2 bi = ivec2(floor(bp)); vec2 bt = bp - vec2(bi);
+    vec2 v00 = imageLoad(mvB, clamp(bi, ivec2(0), nb - 1)).xy;
+    vec2 v10 = imageLoad(mvB, clamp(bi + ivec2(1, 0), ivec2(0), nb - 1)).xy;
+    vec2 v01 = imageLoad(mvB, clamp(bi + ivec2(0, 1), ivec2(0), nb - 1)).xy;
+    vec2 v11 = imageLoad(mvB, clamp(bi + ivec2(1, 1), ivec2(0), nb - 1)).xy;
+    vec2 v = mix(mix(v00, v10, bt.x), mix(v01, v11, bt.x), bt.y);
+    vec2 p = vec2(g) + 0.5;
+    vec4 a = pxb(true, p - 0.5 * v), b = pxb(false, p + 0.5 * v);
+    vec4 a0 = px(true, g), b0 = px(false, g);
+    float d = abs(dot(a.rgb - b.rgb, LW)), d0 = abs(dot(a0.rgb - b0.rgb, LW));
+    float wm = smoothstep(0.0, 0.03, d0 - d);      /* 1: the moved samples agree better */
+    vec4 o = mix(0.5 * (a0 + b0), 0.5 * (a + b), wm);
+    imageStore(outImg, g, vec4(o.rgb, 1.0));
+}
