  * time -- match the first 16 bytes of the streamed content instead. */
+/* The signature each overlay image was registered with, and the LS base a
+ * context last saw it land at (spu_overlay_note_get), for the identity check
+ * at a job's entry (spu_overlay_check_entry). */
+#define SPU_OVL_SIG_IMAGES 1024
